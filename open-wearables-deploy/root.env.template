# This goes in the repo root as `.env` (not backend/config/.env) -- Docker
# Compose reads it automatically for ${VAR} substitution in
# docker-compose.prod.secure.yml, and it's what Caddy reads for which
# domains to request TLS certificates for.
#
# Replace both with real domains pointed at your VM's public IP (a free
# DuckDNS subdomain works fine -- see OPEN_WEARABLES_SETUP.md).

API_DOMAIN=api-soma.duckdns.org
ADMIN_DOMAIN=admin-soma.duckdns.org
VITE_API_URL=https://api-soma.duckdns.org
