#--- APP ---#
ENVIRONMENT="production"
API_PORT=8000
# Replace with your actual admin-portal domain (matches ADMIN_DOMAIN below)
CORS_ORIGINS=["https://ADMIN_DOMAIN_PLACEHOLDER"]
FRONTEND_URL=https://ADMIN_DOMAIN_PLACEHOLDER

#--- DB ---#
# Must match POSTGRES_PASSWORD in docker-compose.prod.secure.yml -- already
# consistent if you use the generated compose file as-is.
DB_HOST=db
DB_PORT=5432
DB_NAME=open-wearables
DB_USER=open-wearables
DB_PASSWORD=REPLACE_ME_DB_PASSWORD

#--- REDIS ---#
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_SSL=false

#--- AUTH ---#
# Real values live in open-wearables-deploy/SECRETS.local.txt (gitignored,
# never commit real secrets here). Generate your own with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=REPLACE_ME_SECRET_KEY
# Fernet key -- encrypts provider OAuth tokens at rest. Without this set,
# the app silently falls back to a no-op "FakeFernet" and tokens are
# stored unencrypted. Generate with:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MASTER_KEY=REPLACE_ME_MASTER_KEY

#--- ADMIN SEED ---#
# Auto-created on first startup. Log in at https://ADMIN_DOMAIN_PLACEHOLDER
# with these, then change the password from the admin UI.
ADMIN_EMAIL=admin@soma4health.com
ADMIN_PASSWORD=REPLACE_ME_ADMIN_PASSWORD

#--- SYNC SETTINGS ---#
SYNC_INTERVAL_SECONDS=3600
HISTORICAL_SYNC_ON_CONNECT=true

#--- OUTGOING WEBHOOKS (Svix) ---#
# Required -- this is how new recovery/sleep/readiness data reaches Soma's
# Supabase Edge Function. svix-server itself always runs; this just
# controls whether the app actually emits events through it.
OUTGOING_WEBHOOKS_ENABLED=true
SVIX_SERVER_URL=http://svix-server:8071

#--- Providers ---#
# Public base URL of the API (used to build OAuth redirect URIs). Must
# match API_DOMAIN below.
API_BASE_URL=https://API_DOMAIN_PLACEHOLDER

#--- Whoop ---#
# Add this exact redirect URI to your EXISTING Whoop developer app
# (alongside the soma://oauth-callback/whoop one already there, if you
# want to keep both working during the transition):
#   https://API_DOMAIN_PLACEHOLDER/api/v1/oauth/whoop/callback
WHOOP_CLIENT_ID=your-whoop-client-id
WHOOP_CLIENT_SECRET=your-whoop-client-secret
WHOOP_DEFAULT_SCOPE=offline read:cycles read:sleep read:recovery read:workout read:body_measurement read:profile

#--- Oura ---#
# Add this exact redirect URI to your EXISTING Oura developer app:
#   https://API_DOMAIN_PLACEHOLDER/api/v1/oauth/oura/callback
OURA_CLIENT_ID=your-oura-client-id
OURA_CLIENT_SECRET=your-oura-client-secret
OURA_DEFAULT_SCOPE=personal daily activity heartrate workout session spo2 ring_configuration heart_health

# --- Additional providers (Garmin, Polar, Strava, Fitbit, Ultrahuman, Suunto) ---
# Uncomment and fill in only the ones you actually want to offer -- each
# needs its own developer app registered with that provider first.
