# App Store Connect API credentials for scripts/testflight.sh.
#
# Copy this file to scripts/asc-api.env (gitignored) and fill in real values:
#   cp scripts/asc-api.env.example scripts/asc-api.env
#
# Where to get these -- see scripts/README-testflight.md:
#   App Store Connect -> Users and Access -> Integrations -> App Store Connect API
#
# Never commit the real scripts/asc-api.env or the .p8 file (this repo is public).

# The Key ID shown next to the key in the API keys list (e.g. ABC123DEFG).
ASC_KEY_ID=

# The Issuer ID shown at the top of the API keys page (a UUID, same for all keys).
ASC_ISSUER_ID=

# Path to the downloaded private key .p8 file. A leading ~ is expanded.
# Recommended location (altool/xcodebuild also auto-discover it there):
#   ~/.appstoreconnect/private_keys/AuthKey_<ASC_KEY_ID>.p8
ASC_KEY_PATH=~/.appstoreconnect/private_keys/AuthKey_.p8
