    "howSomaWorks.dailyChecklist.description" : {
      "comment" : "How Soma Works tour: card description for the daily checklist feature",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Genau die Karte, von der aus du hierher getippt hast. Eine kurze Liste echter täglicher Gewohnheiten -- eine Mahlzeit protokollieren, dein Schrittziel erreichen, deine Stimmung eintragen -- die den Schwung ehrlich hält, einen echten Tag nach dem anderen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The exact card you tapped this from. A short list of real daily habits -- log a meal, hit your step goal, check in on your mood -- that keeps momentum honest, one real day at a time."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La misma tarjeta desde la que llegaste aquí. Una lista corta de hábitos diarios reales -- registrar una comida, alcanzar tu meta de pasos, anotar tu ánimo -- que mantiene el impulso honesto, un día real a la vez."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exactement la carte depuis laquelle vous êtes arrivé ici. Une courte liste d'habitudes quotidiennes réelles -- enregistrer un repas, atteindre votre objectif de pas, noter votre humeur -- qui garde l'élan honnête, un vrai jour à la fois."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Հենց այն քարտն է, որտեղից հասել եք այստեղ։ Իրական օրական սովորույթների կարճ ցուցակ է՝ սնունդ գրանցել, քայլերի նպատակին հասնել, տրամադրությունը նշել -- որը թափը պահում է ազնիվ, մեկ իրական օր առ օր։"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esattamente la scheda da cui hai fatto tap per arrivare qui. Una breve lista di abitudini quotidiane reali -- registrare un pasto, raggiungere l'obiettivo di passi, annotare l'umore -- che mantiene lo slancio onesto, un giorno reale alla volta."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ზუსტად ის ბარათი, საიდანაც აქ მოხვდით. რეალური ყოველდღიური ჩვევების მოკლე სია -- კვების დაფიქსირება, ნაბიჯების მიზნის მიღწევა, განწყობის აღნიშვნა -- რომელიც გულწრფელად ინარჩუნებს ტემპს, ერთი რეალური დღე ერთდროულად."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Та самая карточка, с которой вы сюда попали. Короткий список реальных ежедневных привычек — отметить приём пищи, выполнить цель по шагам, отметить настроение — которые честно поддерживают темп, один реальный день за раз."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тачно она картица са које си дошао овде. Кратка листа стварних дневних навика -- забележи оброк, оствари циљ корака, забележи расположење -- која поштено одржава замах, један стваран дан у једном тренутку."
          }
        }
      }
    },
    "howSomaWorks.dailyChecklist.title" : {
