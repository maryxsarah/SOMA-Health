          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Empieza desde esta tarjeta en Inicio — o cuando quieras desde Perfil → Entrenamiento → Mi objetivo. El interruptor beta está en Cuenta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Commencez depuis cette carte sur l'écran d'accueil — ou à tout moment via Profil → Entraînement → Mon objectif. L'interrupteur bêta se trouve dans Compte."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Սկսիր Գլխավոր էջի այս քարտից — կամ ցանկացած պահի՝ Պրոֆիլ → Մարզումներ → Իմ նպատակը: Բետա անջատիչը Հաշիվ բաժնում է:"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inizia da questa card nella Home — oppure in qualsiasi momento da Profilo → Allenamento → Il mio obiettivo. L'interruttore beta si trova in Account."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "დაიწყე მთავარი გვერდის ამ ბარათიდან — ან ნებისმიერ დროს: პროფილი → ვარჯიშები → ჩემი მიზანი. ბეტა გადამრთველი ანგარიშშია."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Начни с этой карточки на Главной — или в любой момент через Профиль → Тренировки → Моя цель. Переключатель бета-версии находится в Аккаунте."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Почни од ове картице на Почетној — или у било ком тренутку преко Профил → Тренирање → Мој циљ. Прекидач за бета верзију налази се у Налогу."
          }
        }
      }
    },
