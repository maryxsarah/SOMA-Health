    "sportGoalOnboarding.slide2.sub" : {
      "comment" : "Sport-goal onboarding gallery slide 2 subtitle",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Benannte, messbare Vorlagen wie „Höher springen\" — oder dein eigenes, individuelles Ziel von einem Coach. Immer eines nach dem anderen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Named, measurable presets like \"Jump higher\" — or your own custom goal from a coach. One at a time."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajustes preestablecidos con nombre y medibles como «Saltar más alto» — o tu propia meta personalizada de un entrenador. Una a la vez."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Des préréglages nommés et mesurables comme « Sauter plus haut » — ou ton propre objectif personnalisé d'un coach. Un à la fois."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Անվանված, չափելի կաղապարներ, օրինակ՝ «Ցատկել ավելի բարձր» — կամ քո սեփական նպատակը մարզչից։ Մեկը մյուսի հետևից։"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Preimpostazioni denominate e misurabili come \"Salta più in alto\" — oppure il tuo obiettivo personalizzato da un coach. Uno alla volta."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "დასახელებული, გაზომვადი პრესეტები, როგორიცაა „უფრო მაღლა ახტომა\" — ან შენი საკუთარი მიზანი მწვრთნელისგან. ერთდროულად ერთი."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Именованные измеримые пресеты вроде «Прыгать выше» — или своя собственная цель от тренера. Только одна цель за раз."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Именовани, мерљиви прес-сетови попут „Скочи више\" — или твој сопствени циљ од тренера. Један по један."
          }
        }
      }
    },
