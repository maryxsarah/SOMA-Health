    "A real range, never a promise. A 10–20 min goal block joins your daily plan, matched to readiness." : {
      "comment" : "Onboarding slide 3 subtitle",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine echte Spanne, kein Versprechen. Ein 10–20-minütiger Zielblock wird in deinen Tagesplan eingefügt, abgestimmt auf deine Bereitschaft."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A real range, never a promise. A 10–20 min goal block joins your daily plan, matched to readiness."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un rango real, nunca una promesa. Un bloque de objetivo de 10 a 20 min se suma a tu plan diario, ajustado a tu preparación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une fourchette réelle, jamais une promesse. Un bloc d'objectif de 10 à 20 min s'ajoute à votre plan quotidien, adapté à votre récupération."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Իրական միջակայք, ոչ թե խոստում: 10–20 րոպեանոց նպատակի բլոկը միանում է քո օրական ծրագրին՝ պատրաստվածությանը համապատասխան:"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un intervallo reale, mai una promessa. Un blocco obiettivo di 10-20 min si aggiunge al tuo piano giornaliero, in base alla tua prontezza."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ნამდვილი დიაპაზონი, არა დაპირება. 10–20-წუთიანი მიზნის ბლოკი ერთვის შენს დღიურ გეგმას, მზადყოფნის შესაბამისად."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
