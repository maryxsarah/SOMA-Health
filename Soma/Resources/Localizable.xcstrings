        }
      }
    },
    "Add a goal photo and a current photo -- Soma uses them to work out a calorie and macro target that actually fits where you are today and where you're headed.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade una foto objetivo y una foto actual: Soma las usa para calcular un objetivo de calorías y macros que se ajusta a dónde estás hoy y a dónde te diriges."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez une photo objectif et une photo actuelle : Soma les utilise pour déterminer un objectif de calories et de macros adapté à votre situation actuelle et à votre objectif."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi una foto obiettivo e una foto attuale: Soma le usa per calcolare un obiettivo di calorie e macro adatto a dove sei oggi e a dove stai andando."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge ein Zielfoto und ein aktuelles Foto hinzu – Soma nutzt sie, um ein Kalorien- und Makroziel zu berechnen, das wirklich zu deinem heutigen Stand und deinem Ziel passt."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавь фото цели и фото себя сейчас — Soma использует их, чтобы рассчитать цель по калориям и БЖУ, которая действительно подходит твоей текущей форме и твоим планам."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "დაამატე მიზნის ფოტო და მიმდინარე ფოტო — Soma იყენებს მათ კალორიებისა და მაკროელემენტების მიზნის დასათვლელად, რომელიც რეალურად შეესაბამება შენს დღევანდელ მდგომარეობასა და მიმართულებას."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ավելացրու նպատակային և ընթացիկ լուսանկար — Soma-ն օգտագործում է դրանք կալորիաների և մակրոսնուցարարների նպատակը հաշվարկելու համար, որը իրականում համապատասխանում է քո այսօրվա վիճակին և ուղղությանը։"
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Додај фотографију циља и тренутну фотографију — Soma их користи да одреди циљ калорија и макронутријената који заиста одговара томе где си данас и куда идеш."
          }
        }
      }
    },
    "Set up your goal photos": {
      "extractionState": "manual",
      "localizations": {
