    "Adjusts the AI workout plan's structure -- how many blocks, whether it uses supersets, and rest periods.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajusta la estructura del plan de entrenamiento con IA -- cuántos bloques, si usa superseries y los periodos de descanso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajuste la structure du plan d'entraînement généré par l'IA -- nombre de blocs, utilisation de super-séries et temps de repos."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Modifica la struttura del piano di allenamento IA -- numero di blocchi, uso di superserie e tempi di recupero."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Passt den Aufbau des KI-Trainingsplans an -- Anzahl der Blöcke, Supersätze und Pausenzeiten."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Настраивает структуру ИИ-плана тренировок — количество блоков, использование суперсетов и периоды отдыха."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "არეგულირებს AI ვარჯიშის გეგმის სტრუქტურას — რამდენი ბლოკია, იყენებს თუ არა სუპერსეტებს და დასვენების პერიოდებს."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Կարգավորում է AI մարզման պլանի կառուցվածքը՝ բլոկների քանակը, սուպերսեթերի կիրառումը և հանգստի ժամանակահատվածները։"
          }
        }
      }
    },
