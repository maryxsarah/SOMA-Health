          }
        }
      },
      "comment": "Rotating motivational message shown while a goal-progress estimate loads"
    },
    "loadingBar.goalProgress.5": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu yo del futuro ya está orgulloso de ti."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre futur vous est déjà fier de vous."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo io futuro è già orgoglioso di te."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein zukünftiges Ich ist schon stolz auf dich."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your future self is already proud of you."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Твоё будущее «я» уже гордится тобой."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "შენი მომავალი „მე“ უკვე ამაყობს შენით."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Քո ապագա ես-ը արդեն հպարտ է քեզանով:"
          }
        }
      },
      "comment": "Rotating motivational message shown while a goal-progress estimate loads"
    },
    "loadingBar.mealFact.0": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La miel nunca caduca: los arqueólogos han encontrado miel de 3000 años que todavía se puede comer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le miel ne se périme jamais : des archéologues ont retrouvé du miel vieux de 3 000 ans encore comestible."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il miele non scade mai: gli archeologi hanno trovato miele di 3.000 anni ancora commestibile."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Honig verdirbt nie -- Archäologen haben 3.000 Jahre alten Honig gefunden, der noch essbar ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Honey never spoils -- archaeologists have found 3,000-year-old honey that's still edible."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Мёд никогда не портится -- археологи находили мёд возрастом 3000 лет, который всё ещё пригоден в пищу."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "თაფლი არასდროს ფუჭდება -- არქეოლოგებმა იპოვეს 3000 წლის თაფლი, რომელიც დღემდე საჭმელად ვარგისია."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Մեղրը երբեք չի փչանում -- հնագետները գտել են 3000-ամյա մեղր, որը դեռ ուտելի է."
          }
        }
      },
      "comment": "Rotating food-trivia fact shown while a logged meal is estimated"
    },
    "loadingBar.mealFact.1": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los plátanos son bayas. Las fresas, botánicamente, no lo son."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les bananes sont des baies. Les fraises, botaniquement, n'en sont pas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le banane sono bacche. Le fragole, botanicamente, non lo sono."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bananen sind Beeren. Erdbeeren sind botanisch gesehen keine."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bananas are berries. Strawberries, botanically, are not."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Бананы — это ягоды. А клубника, с ботанической точки зрения, — нет."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ბანანი კენკრაა. მარწყვი კი, ბოტანიკურად, არა."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Բանանը հատապտուղ է: Ելակը, բուսաբանական տեսանկյունից, ոչ:"
          }
        }
      },
      "comment": "Rotating food-trivia fact shown while a logged meal is estimated"
    },
    "loadingBar.mealFact.2": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las zanahorias eran originalmente moradas antes de que los holandeses cultivaran las naranjas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les carottes étaient à l'origine violettes, avant que les Néerlandais ne créent les oranges."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le carote erano originariamente viola, prima che gli olandesi selezionassero quelle arancioni."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Karotten waren ursprünglich lila, bevor die Niederländer die orangefarbenen züchteten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Carrots were originally purple before the Dutch bred the orange ones."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Изначально морковь была фиолетовой, пока голландцы не вывели оранжевую."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "თავდაპირველად სტაფილო იასამნისფერი იყო, სანამ ჰოლანდიელებმა ნარინჯისფერი არ გამოიყვანეს."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Գազարն ի սկզբանե մանուշակագույն էր, մինչև հոլանդացիները նարնջագույն տեսակ ստացան."
          }
        }
      },
      "comment": "Rotating food-trivia fact shown while a logged meal is estimated"
    },
    "loadingBar.mealFact.3": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los cacahuetes no son frutos secos: son legumbres."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les cacahuètes ne sont pas des fruits à coque : ce sont des légumineuses."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le arachidi non sono frutta secca: sono legumi."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erdnüsse sind keine Nüsse -- sie sind Hülsenfrüchte."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Peanuts aren't nuts -- they're legumes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Арахис — не орех, а бобовое."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "მიწის თხილი თხილი არ არის -- ის პარკოსანია."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Գետնանուշը ընկույզ չէ -- այն ընդեղեն է."
          }
        }
      },
      "comment": "Rotating food-trivia fact shown while a logged meal is estimated"
    },
    "loadingBar.mealFact.4": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los aguacates son técnicamente una baya con una sola semilla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Techniquement, l'avocat est une baie à un seul noyau."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tecnicamente, l'avocado è una bacca con un solo seme."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Avocados sind technisch gesehen eine einsamige Beere."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Avocados are technically a single-seeded berry."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Авокадо технически — это ягода с одной косточкой."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ავოკადო ტექნიკურად ერთბირთვიანი კენკრაა."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ավոկադոն տեխնիկապես մեկ կորիզով հատապտուղ է."
          }
        }
      },
      "comment": "Rotating food-trivia fact shown while a logged meal is estimated"
    },
    "loadingBar.mealFact.5": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las manzanas flotan porque son aproximadamente un 25% aire."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les pommes flottent car elles sont composées d'environ 25 % d'air."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le mele galleggiano perché sono composte per circa il 25% da aria."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Äpfel schwimmen, weil sie zu etwa 25 % aus Luft bestehen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apples float because they're about 25% air."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Яблоки не тонут, потому что примерно на 25% состоят из воздуха."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ვაშლი წყალზე ცურავს, რადგან დაახლოებით 25% ჰაერისგან შედგება."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Խնձորները չեն խորտակվում, քանի որ մոտավորապես 25%-ը օդ է:"
          }
        }
      },
      "comment": "Rotating food-trivia fact shown while a logged meal is estimated"
    },
    "loadingBar.mealFact.6": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El chocolate fue usado como moneda por los aztecas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le chocolat servait autrefois de monnaie chez les Aztèques."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il cioccolato veniva usato come moneta dagli Aztechi."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schokolade wurde von den Azteken einst als Zahlungsmittel genutzt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Chocolate was once used as currency by the Aztecs."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Когда-то ацтеки использовали шоколад в качестве валюты."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ერთ დროს აცტეკები შოკოლადს ვალუტად იყენებდნენ."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ժամանակին ացտեկները շոկոլադն օգտագործում էին որպես արժույթ:"
          }
        }
      },
      "comment": "Rotating food-trivia fact shown while a logged meal is estimated"
    },
    "loadingBar.mealFact.7": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El color de la cáscara del huevo depende de la raza de la gallina, no de su alimentación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La couleur de la coquille d'un œuf dépend de la race de la poule, pas de son alimentation."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il colore del guscio dell'uovo dipende dalla razza della gallina, non dalla sua alimentazione."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Schalenfarbe eines Eis hängt von der Hühnerrasse ab, nicht von ihrer Ernährung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An egg's shell color depends on the hen's breed, not its nutrition."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Цвет скорлупы яйца зависит от породы курицы, а не от её питания."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "კვერცხის ნაჭუჭის ფერი დამოკიდებულია ქათმის ჯიშზე, და არა მის კვებაზე."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ձվի կճեպի գույնը կախված է հավի ցեղատեսակից, ոչ թե սնուցումից:"
          }
        }
      },
      "comment": "Rotating food-trivia fact shown while a logged meal is estimated"
    },
    "loadingBar.mealFact.8": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Masticar apio quema casi tantas calorías como las que contiene, casi un empate."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mâcher du céleri brûle presque autant de calories qu'il en contient : quasiment nul en bilan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Masticare il sedano brucia quasi tante calorie quante ne contiene: quasi un pareggio."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sellerie zu kauen verbrennt etwa so viele Kalorien, wie er enthält -- fast ein Nullsummenspiel."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Chewing celery burns about as many calories as it contains -- close to a wash."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На пережёвывание сельдерея тратится почти столько же калорий, сколько в нём содержится -- почти ноль в остатке."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ნიახურის ღეჭვა თითქმის იმდენივე კალორიას წვავს, რამდენსაც თავად შეიცავს -- თითქმის გათანაბრებულია."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Նեխուրը ծամելը այրում է գրեթե այնքան կալորիա, որքան այն պարունակում է -- գրեթե զրոյի է հավասարվում."
          }
        }
      },
      "comment": "Rotating food-trivia fact shown while a logged meal is estimated"
    },
    "loadingBar.mealFact.9": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Masticar tu comida más fuerte puede hacer que sepa mejor de verdad, según estudios reales."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Selon de véritables études, croquer plus fort dans vos aliments peut réellement les rendre plus savoureux."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Secondo studi reali, sgranocchiare il cibo più rumorosamente può farlo davvero sembrare più buono."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lauteres Kauen kann laut echten Studien tatsächlich dafür sorgen, dass Essen besser schmeckt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Crunching your food louder can genuinely make it taste better, per actual studies."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Более громкое хрустение едой действительно может сделать её вкуснее — так показывают исследования."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "საკვების ხმამაღლა ხრაშუნით ჭამა ნამდვილად აუმჯობესებს გემოს — ასე აჩვენებს კვლევები."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ուտելիքը ավելի բարձր ձայնով ծամելը իսկապես կարող է ավելի համեղ դարձնել այն, ինչպես ցույց են տալիս իրական հետազոտությունները."
          }
        }
      },
      "comment": "Rotating food-trivia fact shown while a logged meal is estimated"
    },
