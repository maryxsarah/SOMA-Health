    "anchorSessionQuestion.daysLabel": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Which day(s) is it usually on?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Qué día(s) suele ser?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quel(s) jour(s) est-ce habituellement ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In quali giorni si svolge di solito?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "An welchen Tag(en) ist das meistens?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В какой день (или дни) это обычно проходит?"
          }
        },
        "ka": {
          "stringUnit": {
