        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Գրիր, ասա բարձրաձայն կամ օգտագործիր «Ի՞նչ կարող եմ պատրաստել»"
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Упиши, издиктирај или користи „Шта могу да скувам?\""
          }
        }
      },
      "comment": "Onboarding checklist item subtitle"
    },
