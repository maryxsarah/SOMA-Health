    "Sessions still defer to your readiness for placement — low days shift, the workout itself is never rewritten." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Einheiten richten sich weiterhin nach deiner Bereitschaft — an schwachen Tagen verschieben sie sich, das Training selbst wird aber nie umgeschrieben."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las sesiones siguen dependiendo de tu preparación para ubicarse — los días bajos se desplazan, pero el entrenamiento en sí nunca se reescribe."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les séances continuent de dépendre de votre récupération pour leur placement — les jours faibles sont décalés, mais la séance elle-même n'est jamais réécrite."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Պարապմունքների տեղաբաշխումը դեռ կախված է քո պատրաստվածությունից՝ ցածր օրերը տեղափոխվում են, բայց ինքնին մարզումը երբեք չի փոփոխվում:"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le sessioni continuano a dipendere dalla tua prontezza per il posizionamento — nei giorni no vengono spostate, ma l'allenamento in sé non viene mai riscritto."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "სესიები კვლავ შენს მზადყოფნას ეყრდნობა განლაგებისთვის — დაბალი დღეები იცვლის ადგილს, თავად ვარჯიში კი არასდროს იცვლება."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сессии по-прежнему подстраиваются под твою готовность — дни с низкой готовностью сдвигаются, а сама тренировка никогда не переписывается."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сесије се и даље прилагођавају твојој спремности при распоређивању — дани са ниском спремношћу се померају, али сам тренинг никада не бива преправљен."
          }
        }
      }
    },
