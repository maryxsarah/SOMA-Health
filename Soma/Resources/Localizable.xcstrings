    "Couldn't confidently read an assignment there — check the fields below, or try again." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wir konnten die Aufgabe dort nicht sicher lesen — überprüfe die Felder unten oder versuche es erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No pudimos leer la tarea con seguridad ahí — revisa los campos de abajo o inténtalo de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
