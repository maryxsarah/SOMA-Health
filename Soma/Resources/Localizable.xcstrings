    "howSomaWorks.dailyChecklist.whereToFind" : {
      "comment" : "How Soma Works tour: where-to-find line for the daily checklist feature",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auf der Startseite, direkt unter deinem Wochenfortschritt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "On Home, right below your weekly progress."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En Inicio, justo debajo de tu progreso semanal."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sur l'accueil, juste en dessous de votre progression hebdomadaire."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Գլխավոր էջում, ձեր շաբաթական առաջընթացից անմիջապես ներքև։"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In Home, subito sotto i tuoi progressi settimanali."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "მთავარ გვერდზე, თქვენი კვირის პროგრესის ქვემოთ."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "На главном экране, прямо под недельным прогрессом."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "На Почетној, одмах испод твог недељног напретка."
          }
        }
      }
    },
    "howSomaWorks.dailyReadiness.description" : {
      "comment" : "How Soma Works tour: card description for the daily readiness feature",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeden Morgen liest Soma deine verbundene Wearable-Uhr aus -- Schlaf, HRV, Ruhepuls -- und macht daraus ein ehrliches Belastungslevel für heute: Ruhe, leicht, moderat oder volle Kraft."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Every morning, Soma reads your connected wearable -- sleep, HRV, resting heart rate -- and turns it into one honest effort level for today: rest, light, moderate, or push hard."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada mañana, Soma lee tu dispositivo conectado -- sueño, VFC, frecuencia cardíaca en reposo -- y lo convierte en un nivel de esfuerzo honesto para hoy: descanso, ligero, moderado o intenso."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque matin, Soma lit les données de votre objet connecté -- sommeil, VFC, fréquence cardiaque au repos -- et en fait un niveau d'effort honnête pour la journée : repos, léger, modéré ou intense."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ամեն առավոտ Soma-ն կարդում է ձեր միացված սարքի տվյալները՝ քուն, HRV, հանգստի զարկերակ -- և վերածում է դրանք այսօրվա ազնիվ ծանրաբեռնվածության մակարդակի՝ հանգիստ, թեթև, չափավոր կամ առավելագույն ջանք։"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogni mattina, Soma legge i dati del tuo dispositivo indossabile -- sonno, HRV, frequenza cardiaca a riposo -- e li trasforma in un livello di sforzo onesto per oggi: riposo, leggero, moderato o intenso."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ყოველ დილით Soma კითხულობს თქვენი დაკავშირებული მოწყობილობის მონაცემებს -- ძილს, HRV-ს, მოსვენებულ პულსს -- და აქცევს მას დღევანდელ გულწრფელ დატვირთვის დონედ: დასვენება, მსუბუქი, ზომიერი ან მაქსიმალური."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Каждое утро Soma считывает данные с вашего устройства — сон, ВСР, пульс покоя — и превращает их в честный уровень нагрузки на сегодня: отдых, лёгкая, умеренная или высокая интенсивность."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Свако јутро Soma чита податке са твог повезаног уређаја -- сан, ХРВ, пулс у мировању -- и претвара их у поштен ниво напора за данас: одмор, лагано, умерено или максимално."
          }
        }
      }
    },
    "howSomaWorks.dailyReadiness.title" : {
      "comment" : "How Soma Works tour: card title for the daily readiness feature",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
