    "profile.quietHours.explainer" : {
      "comment" : "Explainer text at top of the quiet-hours editor sheet",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Soma plant keine neuen Benachrichtigungen innerhalb dieses Zeitfensters -- alles, was hier gelandet wäre, wartet bis zum Ende."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Soma won't schedule new notifications inside this window -- anything that would've landed here waits until it ends."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Soma no programará nuevas notificaciones dentro de esta ventana -- todo lo que habría llegado aquí espera hasta que termine."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Soma ne planifiera pas de nouvelles notifications dans cette fenêtre -- tout ce qui y serait arrivé attend jusqu'à la fin."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Soma-ն նոր ծանուցումներ չի պլանավորի այս պատուհանում -- այն ամենը, ինչ պետք է հայտնվեր այստեղ, սպասում է մինչև ավարտը:"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Soma non pianificherà nuove notifiche in questa finestra -- tutto ciò che sarebbe arrivato qui aspetta fino alla fine."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Soma ამ პერიოდში ახალ შეტყობინებებს არ დაგეგმავს -- ყველაფერი, რაც აქ უნდა მოსულიყო, ელოდება დასრულებას."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Soma не будет планировать новые уведомления в этом окне -- всё, что должно было прийти сюда, ждёт его окончания."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Soma неће заказивати нова обавештења у овом периоду -- све што би стигло овде чека да се период заврши."
          }
        }
      }
    },
