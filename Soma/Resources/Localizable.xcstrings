    "trainingEmphasis.bulk" : {
      "comment" : "Encouraging sentence describing the current plan's training emphasis, shown on the Progress screen; informal tu/du register to match rest of catalog",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Im Moment konzentriert sich dein Plan auf den Muskelaufbau."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Right now, your plan is focused on building size."
