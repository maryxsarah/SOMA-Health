    "The one real, non-fabricated breakdown available -- computed from whichever source reported it, not every night.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El único desglose real, no simulado, disponible: calculado a partir de la fuente que lo registró, no todas las noches."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La seule répartition réelle et non simulée disponible : calculée à partir de la source qui l'a enregistrée, pas toutes les nuits."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'unica suddivisione reale, non simulata, disponibile: calcolata in base alla fonte che l'ha registrata, non tutte le notti."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die einzige echte, nicht simulierte Aufschlüsselung, die verfügbar ist – berechnet aus der Quelle, die sie gemeldet hat, nicht jede Nacht."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Единственная реальная, не выдуманная разбивка, которая есть — рассчитана по данным того источника, который её предоставил, а не за каждую ночь."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ერთადერთი რეალური, არაგამოგონილი დაშლა, რაც ხელმისაწვდომია — გამოთვლილია იმ წყაროდან, რომელმაც ის მოგვაწოდა, და არა ყოველი ღამისთვის."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Միակ իրական, ոչ հորինված բաշխվածությունն է, որ առկա է․ հաշվարկված է այն աղբյուրից, որը հաղորդել է այն, ոչ թե ամեն գիշերվա համար։"
          }
        }
      }
    },
