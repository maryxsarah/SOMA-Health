    "notification.streakProtection.body" : {
      "comment" : "",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du hast eine %lld-Tage-Serie. Trage das heutige Training ein, um sie fortzusetzen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You're on a %lld-day streak. Log today's workout to keep it going."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Llevas una racha de %lld días. Registra el entrenamiento de hoy para mantenerla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu es sur une série de %lld jours. Enregistre ta séance du jour pour la maintenir."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Դու ունես %lld օրյա շարք։ Գրանցիր այսօրվա մարզումը՝ այն շարունակելու համար։"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sei a una serie di %lld giorni. Registra l'allenamento di oggi per continuarla."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "შენ გაქვს %lld დღიანი სერია. დააფიქსირე დღევანდელი ვარჯიში მის გასაგრძელებლად."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "У тебя серия %lld дней подряд. Запиши сегодняшнюю тренировку, чтобы не прерывать её."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "На низу си од %lld дана. Забележи данашњи тренинг да га наставиш."
          }
        }
      }
    },
