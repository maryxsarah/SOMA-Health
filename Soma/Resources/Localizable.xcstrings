    "profile.anchorSession.explainer" : {
      "comment" : "Explainer text at top of the weekly anchor session editor sheet",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein wiederkehrender Kurs oder eine Aktivität (z. B. ein Hot-Yoga-Kurs am Dienstag), um den herum der Rest deiner Woche aufgebaut wird."
