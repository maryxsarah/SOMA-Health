            "state": "translated",
            "value": "Une protection oculaire certifiée est recommandée pour toute pratique du padel."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Si consiglia una protezione oculare certificata per giocare a padel."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für Padel wird zertifizierter Augenschutz empfohlen."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для игры в падел рекомендуется сертифицированная защита глаз."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "პადელის ნებისმიერი თამაშისთვის რეკომენდებულია სერტიფიცირებული თვალის დაცვა."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Պադելով խաղալիս խորհուրդ է տրվում օգտագործել սերտիֆիկացված աչքի պաշտպանություն:"
          }
        }
      }
    },
    "YOUR OWN": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "LO TUYO"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À VOUS"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "IL TUO"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "DEINS"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "СВОЁ"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "საკუთარი"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "ՔՈ ՍԵՓԱԿԱՆԸ"
          }
        }
      }
    },
    "Got a task from your coach? Add it here — do the work in Soma and show them your progress: sessions and measurements export as one card.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Tu entrenador te dio una tarea? Añádela aquí — haz el trabajo en Soma y muéstrale tu progreso: las sesiones y las mediciones se exportan en una sola tarjeta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre entraîneur vous a donné une tâche ? Ajoutez-la ici — faites le travail dans Soma et montrez-lui vos progrès : les séances et les mesures s'exportent en une seule carte."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai un compito dal tuo allenatore? Aggiungilo qui — allenati in Soma e mostragli i tuoi progressi: sessioni e misurazioni vengono esportate in un'unica scheda."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hast du eine Aufgabe von deinem Trainer bekommen? Füge sie hier hinzu — erledige das Training in Soma und zeig ihm deinen Fortschritt: Einheiten und Messwerte werden als eine Karte exportiert."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Получил задание от тренера? Добавь его сюда — выполняй его в Soma и показывай тренеру свой прогресс: занятия и замеры экспортируются в виде одной карточки."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "მწვრთნელისგან დავალება მიიღე? დაამატე აქ — შეასრულე Soma-ში და აჩვენე მას შენი პროგრესი: სესიები და გაზომვები ერთ ბარათად გამოდის."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Մարզիչիցդ առաջադրանք ես ստացել: Ավելացրու այն այստեղ — կատարիր այն Soma-ում և ցույց տուր նրան քո առաջընթացը. պարապմունքներն ու չափումները արտահանվում են մեկ քարտի տեսքով:"
          }
        }
      }
    },
