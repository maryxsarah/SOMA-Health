    "profile.about.groupFootnote" : {
      "comment" : "Footnote under the About settings group",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Region ermöglicht Vorschläge für Fitnessstudios & Trainer in der Nähe; das Geburtsdatum schaltet Fortschrittsfotos für dein Zielbild frei."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Region powers nearby gym & coach suggestions; date of birth unlocks Goal Body progress photos."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La región habilita sugerencias de gimnasios y entrenadores cercanos; la fecha de nacimiento desbloquea las fotos de progreso de Meta corporal."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La région permet de suggérer des salles de sport et coachs à proximité ; la date de naissance débloque les photos de progression de l'objectif corporel."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Տարածաշրջանը հնարավորություն է տալիս առաջարկել մոտակա մարզասրահներ և մարզիչներ. ծննդյան ամսաթիվը բացում է Նպատակային մարմնի առաջընթացի լուսանկարները:"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La regione abilita i suggerimenti di palestre e coach nelle vicinanze; la data di nascita sblocca le foto di progresso di Obiettivo corporeo."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "რეგიონი უზრუნველყოფს ახლომდებარე სავარჯიშო დარბაზებისა და მწვრთნელების შემოთავაზებებს; დაბადების თარიღი ხსნის მიზნობრივი სხეულის პროგრესის ფოტოებს."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Регион позволяет предлагать залы и тренеров поблизости; дата рождения открывает фото прогресса «Цель по телу»."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Регион омогућава предлоге теретана и тренера у близини; датум рођења откључава фотографије напретка за Циљ тела."
          }
        }
      }
