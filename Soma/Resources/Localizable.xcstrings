    "profile.anchorSession.dayPrompt": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Which day(s) is it usually on?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Qué día(s) suele ser?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quel(s) jour(s) est-ce habituellement ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In quali giorni si svolge di solito?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "An welchen Tag(en) ist das meistens?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В какой день (или дни) это обычно проходит?"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ჩვეულებრივ რომელ დღეს ან დღეებში იმართება?"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Այն սովորաբար ո՞ր օրը կամ օրերն է լինում։"
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Којим даном (или данима) се то обично одржава?"
          }
        }
      },
      "comment": "Prompt above the weekday picker for the anchor session"
    },
    "profile.dateOfBirth.explainer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirms you're 18+ to unlock Goal Body progress photos. Never shown to other users."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirma que tienes 18 años o más para desbloquear las fotos de progreso de Meta corporal. Nunca se muestra a otros usuarios."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirme que tu as 18 ans ou plus pour débloquer les photos de progression Objectif Corps. Jamais visible pour les autres utilisateurs."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Conferma che hai 18 anni o più per sbloccare le foto di avanzamento Obiettivo Corpo. Non è mai visibile ad altri utenti."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bestätigt, dass du 18+ bist, um Zielkörper-Fortschrittsfotos freizuschalten. Wird anderen Nutzer:innen nie angezeigt."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подтверждает, что тебе есть 18 лет, чтобы открыть фото прогресса «Цель по телу». Никогда не показывается другим пользователям."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ადასტურებს, რომ 18+ ხარ, რომ განიბლოკოს სხეულის მიზნის პროგრესის ფოტოები. არასდროს გამოჩნდება სხვა მომხმარებლებისთვის."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Հաստատում է, որ 18+ ես՝ Մարմնի նպատակի առաջընթացի լուսանկարներն ապակողպելու համար։ Երբեք չի ցուցադրվում այլ օգտատերերին։"
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Потврђује да имаш 18+ година за откључавање фотографија напретка за Циљано тело. Никада се не приказује другим корисницима."
          }
        }
      },
      "comment": "Explainer text at top of the date-of-birth editor sheet"
    },
    "profile.save.genericError": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't save profile. Try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo guardar el perfil. Inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d'enregistrer le profil. Réessaie."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile salvare il profilo. Riprova."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Profil konnte nicht gespeichert werden. Versuche es erneut."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось сохранить профиль. Попробуй снова."
          }
