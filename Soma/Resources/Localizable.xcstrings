        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ბანანი კენკრაა. მარწყვი კი, ბოტანიკურად, არა."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Бананы — это ягоды. А клубника, с ботанической точки зрения, — нет."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
