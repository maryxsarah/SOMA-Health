    "profile.dateOfBirth.explainer" : {
      "comment" : "Explainer text at top of the date-of-birth editor sheet",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bestätigt, dass du 18+ bist, um Zielkörper-Fortschrittsfotos freizuschalten. Wird anderen Nutzer:innen nie angezeigt."
          }
        },
        "en" : {
          "stringUnit" : {
