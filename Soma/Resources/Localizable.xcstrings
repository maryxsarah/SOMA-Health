    "overviewAccordion.hrv.text" : {
      "comment" : "Accordion explainer text for HRV",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Schwankung der Zeit zwischen deinen Herzschlägen. Ein im Vergleich zu deinem eigenen Ausgangswert höherer HRV-Wert deutet in der Regel darauf hin, dass dein Nervensystem gut erholt ist; ein niedrigerer kann auf Erschöpfung, Stress oder unvollständige Erholung hinweisen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The variation in time between heartbeats. Generally, a higher HRV relative to your own baseline suggests your nervous system is well-recovered; a lower one can signal fatigue, stress, or incomplete recovery."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La variación en el tiempo entre latidos. Por lo general, un HRV más alto en relación con tu valor de referencia indica que tu sistema nervioso está bien recuperado; uno más bajo puede indicar fatiga, estrés o una recuperación incompleta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La variation du temps entre vos battements cardiaques. En général, un HRV plus élevé par rapport à votre propre référence indique que votre système nerveux est bien récupéré ; un HRV plus bas peut signaler de la fatigue, du stress ou une récupération incomplète."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Սրտի զարկերի միջև ընկած ժամանակի փոփոխականությունը։ Սովորաբար, քո սեփական միջինի համեմատ ավելի բարձր HRV-ն ցույց է տալիս, որ նյարդային համակարգդ լավ վերականգնված է; ավելի ցածրը կարող է վկայել հոգնածության, սթրեսի կամ թերի վերականգնման մասին։"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La variazione del tempo tra i battiti cardiaci. In genere, un HRV più alto rispetto al tuo valore di riferimento indica che il tuo sistema nervoso è ben recuperato; uno più basso può segnalare affaticamento, stress o un recupero incompleto."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "დროის ცვალებადობა გულისცემებს შორის. ჩვეულებრივ, უფრო მაღალი HRV შენს საბაზისო დონესთან შედარებით ნიშნავს, რომ შენი ნერვული სისტემა კარგადაა აღდგენილი; დაბალი მაჩვენებელი შეიძლება მიუთითებდეს დაღლილობაზე, სტრესზე ან არასრულ აღდგენაზე."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Разброс во времени между ударами сердца. Обычно чем выше HRV относительно твоего обычного уровня, тем лучше восстановлена твоя нервная система; более низкий показатель может говорить об усталости, стрессе или неполном восстановлении."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Промена времена између откуцаја срца. Генерално, виши HRV у односу на твој уобичајени ниво указује да ти је нервни систем добро опорављен; нижи може указивати на умор, стрес или непотпун опоравак."
          }
        }
      }
    },
    "overviewAccordion.hrv.title" : {
