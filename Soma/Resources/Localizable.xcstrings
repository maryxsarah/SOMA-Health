    "nutrition.mealIdea.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tell Soma what's in your fridge -- get one full recipe, sized to what's left today."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dile a Soma qué hay en tu nevera -- obtén una receta completa, ajustada a lo que te queda hoy."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dis à Soma ce qu'il y a dans ton frigo -- obtiens une recette complète, ajustée à ce qu'il te reste aujourd'hui."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Di' a Soma cosa c'è nel tuo frigo -- ottieni una ricetta completa, dimensionata su ciò che ti resta oggi."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sag Soma, was in deinem Kühlschrank ist -- erhalte ein vollständiges Rezept, passend zu deinem heutigen Rest."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Скажи Soma, что у тебя в холодильнике -- получи полноценный рецепт под остаток на сегодня."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "უთხარი Soma-ს, რა გაქვს მაცივარში -- მიიღე სრული რეცეპტი, მორგებული დღეს დარჩენილზე."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ասա Soma-ին, թե ինչ ունես սառնարանում -- ստացիր ամբողջական բաղադրատոմս՝ հարմարեցված այսօրվա մնացորդին։"
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Реци Soma шта имаш у фрижидеру — добићеш цео рецепт, прилагођен ономе што ти је остало данас."
          }
        }
      },
      "comment": "Subtitle of the entry point card into AI meal recommendations"
    },
