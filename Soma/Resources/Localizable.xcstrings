    "howSomaWorks.workouts.whereToFind" : {
      "comment" : "How Soma Works tour: where-to-find line for the workouts feature",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"Workout starten\" auf deiner Verfassungskarte, oder \"Heute woanders?\", um ein Fitnessstudio zu scannen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"Start workout\" on your readiness card, or \"Somewhere else today?\" to scan a gym."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"Empezar entrenamiento\" en tu tarjeta de preparación, o \"¿Hoy en otro lugar?\" para escanear un gimnasio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« Démarrer l'entraînement » sur votre carte de forme, ou « Ailleurs aujourd'hui ? » pour scanner une salle."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Սկսել մարզումը»՝ ձեր պատրաստակամության քարտի վրա, կամ «Այսօր այլ տե՞ղ»՝ մարզասրահը սկանավորելու համար։"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"Avvia allenamento\" sulla tua scheda di prontezza, oppure \"Altrove oggi?\" per scansionare una palestra."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„ვარჯიშის დაწყება“ თქვენს მზადყოფნის ბარათზე, ან „დღეს სხვაგან?“ სავარჯიშო დარბაზის სკანირებისთვის."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Начать тренировку» на карточке готовности или «Сегодня в другом месте?», чтобы отсканировать зал."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Покрени тренинг” на твојој картици спремности, или „Негде другде данас?” да скенираш теретану."
          }
        }
      }
    },
