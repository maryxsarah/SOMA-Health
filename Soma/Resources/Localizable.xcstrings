        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Քո նպատակային քաշը դեռ չի համապատասխանում նպատակային լուսանկարին — թարմացրու այն Կարգավորումներում՝ ստանալու համար ճշգրիտ գնահատական։"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il tuo peso obiettivo non corrisponde ancora alla tua foto obiettivo. Aggiornalo nelle Impostazioni per una stima reale."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "შენი სამიზნე წონა ჯერ არ ემთხვევა მიზნის ფოტოს — განაახლე ის პარამეტრებში ზუსტი შეფასებისთვის."
          }
        },
        "ru" : {
          "stringUnit" : {
