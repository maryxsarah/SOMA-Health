    "workoutFeelRating.easyConsequence": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Soma subirá un poco la intensidad de mañana si tus datos de recuperación lo respaldan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Soma augmentera légèrement l'intensité de demain si tes données de récupération le permettent."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Soma aumenterà leggermente l'intensità di domani se i tuoi dati di recupero lo consentono."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Soma erhöht die Intensität von morgen leicht, wenn deine Erholungsdaten das zulassen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Soma will nudge tomorrow's intensity up a notch if your recovery data supports it."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Soma немного повысит завтрашнюю интенсивность, если это позволят данные восстановления."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "Soma ოდნავ გაზრდის ხვალინდელ ინტენსივობას, თუ აღდგენის მონაცემები ამის საშუალებას მისცემს."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Soma-ն մի փոքր կբարձրացնի վաղվա բեռնվածությունը, եթե վերականգնման տվյալները դա հաստատեն։"
          }
        }
      },
      "comment": "Longer sentence explaining how rating a workout 'Easy' affects tomorrow's plan"
    },
    "workoutFeelRating.hardButGoodConsequence": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Soma mantendrá el plan de los próximos días -- este esfuerzo fue el adecuado para hoy."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Soma conservera le plan des prochains jours -- c'était le bon niveau d'effort pour aujourd'hui."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Soma manterrà il piano dei prossimi giorni -- questo sforzo era quello giusto per oggi."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Soma behält den Plan für die nächsten Tage bei -- das war heute die richtige Anstrengung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Soma will keep the next few days as planned -- this looked like the right effort for today."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Soma сохранит следующие несколько дней по плану — сегодняшняя нагрузка выглядела подходящей."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "Soma შემდეგ რამდენიმე დღეს გეგმის მიხედვით შეინარჩუნებს — დღევანდელი დატვირთვა სწორი ჩანდა."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Soma-ն հաջորդ մի քանի օրերը կպահի պլանի համաձայն — այսօրվա ջանքը ճիշտ էր թվում։"
          }
        }
      },
      "comment": "Longer sentence explaining how rating a workout 'Hard but good' affects upcoming days' plan"
    },
    "workoutFeelRating.tooMuchConsequence": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Soma suavizará mañana hacia Moderado o Ligero, incluso si los datos de recuperación por sí solos sugerirían más."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Soma allégera demain vers Modéré ou Léger, même si les seules données de récupération suggéreraient davantage."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Soma alleggerirà domani verso Moderato o Leggero, anche se i soli dati di recupero suggerirebbero di più."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Soma stuft morgen auf Moderat oder Leicht herab, selbst wenn die Erholungsdaten allein auf mehr hindeuten würden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Soma will ease tomorrow toward Moderate or Light, even if recovery data alone would suggest more."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Soma снизит завтрашнюю нагрузку до умеренной или лёгкой, даже если одни только данные восстановления предполагали бы больше."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "Soma ხვალინდელ დატვირთვას საშუალომდე ან მსუბუქამდე შეამცირებს, თუნდაც მხოლოდ აღდგენის მონაცემები მეტს გვთავაზობდეს."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Soma-ն վաղվա բեռնվածությունը կնվազեցնի մինչև չափավոր կամ թեթև մակարդակ, նույնիսկ եթե միայն վերականգնման տվյալները ավելին առաջարկեին։"
          }
        }
      },
      "comment": "Longer sentence explaining how rating a workout 'Too much' affects tomorrow's plan"
    },
