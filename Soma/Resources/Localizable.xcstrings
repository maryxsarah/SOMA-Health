        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Soma-ն լրիվ վստահ չէր, թե ինչ է տեսնում — ավելացրու քեզ մոտ եղած սարքավորումները։"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Soma non era sicuro di cosa avesse visto: aggiungi l'attrezzatura che hai a disposizione."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Soma-მ ბოლომდე ვერ ამოიცნო, რას ხედავდა — დაამატე შენთვის ხელმისაწვდომი ინვენტარი."
