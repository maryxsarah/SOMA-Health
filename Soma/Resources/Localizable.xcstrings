    "deleteAccount.erased.footnote" : {
      "comment" : "Footnote under the deleted-data list explaining permanence and the backup window",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Löschung ist endgültig und kann nicht rückgängig gemacht werden. Sie erfolgt sofort; die Entfernung aus verschlüsselten Backups ist innerhalb von 30 Tagen abgeschlossen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deletion is permanent and can't be undone. It completes immediately; removal from encrypted backups finishes within 30 days."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La eliminación es permanente y no se puede deshacer. Se completa de inmediato; el borrado de las copias de seguridad cifradas termina en un plazo de 30 días."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La suppression est définitive et irréversible. Elle est immédiate ; l'effacement des sauvegardes chiffrées se termine sous 30 jours."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ջնջումը վերջնական է և հետարկելի չէ: Կատարվում է անմիջապես. գաղտնագրված պահուստներից հեռացումն ավարտվում է 30 օրվա ընթացքում:"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'eliminazione è permanente e irreversibile. Avviene subito; la rimozione dai backup cifrati si completa entro 30 giorni."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "წაშლა საბოლოოა და ვერ გაუქმდება. სრულდება მაშინვე; დაშიფრული სარეზერვო ასლებიდან წაშლა სრულდება 30 დღეში."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Удаление необратимо. Оно выполняется сразу; удаление из зашифрованных резервных копий завершается в течение 30 дней."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Брисање је трајно и не може се опозвати. Извршава се одмах; уклањање из шифрованих резервних копија завршава се у року од 30 дана."
          }
        }
      }
    },
