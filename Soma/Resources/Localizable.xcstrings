          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Objectif de pas du jour : %@ — vous avez fait en moyenne environ %lld par jour au cours de la dernière semaine."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Obiettivo di passi di oggi: %@; hai fatto in media circa %lld al giorno nell'ultima settimana."
