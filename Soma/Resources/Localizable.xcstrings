    "An earlier stage than last time — stages wobble, the work still counts.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una etapa anterior a la última vez — las etapas fluctúan, el trabajo sigue contando."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une étape antérieure à la dernière fois — les étapes fluctuent, le travail compte quand même."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una tappa precedente rispetto all'ultima volta — le tappe oscillano, il lavoro conta comunque."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine frühere Stufe als beim letzten Mal — Stufen schwanken, die Arbeit zählt trotzdem."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Более ранний этап, чем в прошлый раз — этапы колеблются, но работа всё равно засчитывается."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ადრეული ეტაპი წინანდელთან შედარებით — ეტაპები მერყეობს, სამუშაო მაინც ითვლება."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ավելի վաղ փուլ, քան նախորդ անգամ — փուլերը տատանվում են, աշխատանքը դեռ հաշվվում է:"
          }
        }
      }
    },
