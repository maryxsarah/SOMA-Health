    "profile.knownLifts.explainer" : {
      "comment" : "Explainer text at top of the known-lifts editor sheet",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn du dein angenehmes Arbeitsgewicht für eine dieser Übungen kennst, verwendet Soma es direkt für den KI-Plan, anstatt es aus deinem Körpergewicht und Erfahrungslevel zu schätzen. Lass es leer, um weiterhin die Schätzung zu verwenden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If you know your comfortable working weight for any of these, Soma uses it directly for the AI plan instead of estimating from your bodyweight and experience level. Leave any blank to keep using the estimate."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si conoces tu peso de trabajo cómodo para cualquiera de estos, Soma lo usa directamente en el plan de IA en lugar de estimarlo a partir de tu peso corporal y nivel de experiencia. Deja en blanco cualquiera para seguir usando la estimación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si tu connais ta charge de travail confortable pour l'un de ces mouvements, Soma l'utilise directement dans le programme IA au lieu de l'estimer à partir de ton poids corporel et de ton niveau d'expérience. Laisse vide pour continuer à utiliser l'estimation."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Եթե գիտես քո հարմարավետ աշխատանքային քաշը սրանցից որևէ մեկի համար, Soma-ն այն ուղղակիորեն օգտագործում է AI ծրագրում՝ փոխարենը գնահատելու քո մարմնի քաշից և փորձի մակարդակից ելնելով։ Թող դատարկ մնա, որպեսզի շարունակվի գնահատականի օգտագործումը։"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se conosci il tuo carico di lavoro confortevole per uno di questi, Soma lo usa direttamente nel piano IA invece di stimarlo dal tuo peso corporeo e livello di esperienza. Lascia vuoto per continuare a usare la stima."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "თუ იცი შენი კომფორტული სამუშაო წონა რომელიმესთვის ამათგან, Soma პირდაპირ იყენებს მას AI გეგმისთვის, ნაცვლად იმისა, რომ შეაფასოს შენი სხეულის წონისა და გამოცდილების დონის მიხედვით. დატოვე ცარიელი, რომ გაგრძელდეს შეფასების გამოყენება."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если ты знаешь свой комфортный рабочий вес для любого из этих упражнений, Soma использует его напрямую в плане от ИИ вместо того, чтобы оценивать его по твоему весу тела и уровню опыта. Оставь поле пустым, чтобы продолжать использовать оценку."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ако знаш своју угодну радну тежину за било коју од ових вежби, Soma је користи директно у AI плану, уместо да процењује на основу твоје телесне тежине и нивоа искуства. Остави поље празно да наставиш да користиш процену."
          }
        }
      }
    },
