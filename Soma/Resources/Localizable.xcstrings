    "supabase.error.serviceUnavailable": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servicio de IA de Soma no está disponible temporalmente. Ya nos han avisado; inténtalo de nuevo más tarde."
          }
        },
        "fr": {
          "stringUnit": {
