    },
    "howSomaWorks.nutrition.description" : {
      "comment" : "How Soma Works tour: card description for the nutrition feature",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sieh deine täglichen Kalorien- und Makroziele, protokolliere Mahlzeiten beim Essen, oder frag \"Was kann ich kochen?\" für ein echtes Rezept, das nur aus dem gemacht wird, was wirklich in deiner Küche ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "See your daily calorie and macro targets, log meals as you eat, or ask \"What can I make?\" for a real recipe built only from what's actually in your kitchen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consulta tus objetivos diarios de calorías y macros, registra las comidas al comer, o pregunta \"¿Qué puedo cocinar?\" para una receta real hecha solo con lo que realmente tienes en tu cocina."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consultez vos objectifs quotidiens de calories et de macros, enregistrez vos repas au fur et à mesure, ou demandez « Que puis-je cuisiner ? » pour une vraie recette basée uniquement sur ce qu'il y a réellement dans votre cuisine."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Տեսեք ձեր օրական կալորիաների և մակրոների նպատակները, գրանցեք սնունդը ուտելիս, կամ հարցրեք «Ի՞նչ կարող եմ պատրաստել», որպեսզի ստանաք իրական բաղադրատոմս՝ կազմված միայն ձեր խոհանոցում իրականում եղածից։"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guarda i tuoi obiettivi giornalieri di calorie e macro, registra i pasti mentre mangi, oppure chiedi \"Cosa posso cucinare?\" per una ricetta reale basata solo su ciò che hai davvero in cucina."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ნახეთ თქვენი ყოველდღიური კალორიებისა და მაკროელემენტების მიზნები, დააფიქსირეთ კვება ჭამის დროს, ან იკითხეთ „რისი მომზადება შემიძლია?“ რეცეპტისთვის, რომელიც აგებულია მხოლოდ იმაზე, რაც რეალურად გაქვთ სამზარეულოში."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Смотрите дневные цели по калориям и БЖУ, отмечайте приёмы пищи по мере еды или спросите «Что можно приготовить?» — рецепт составят только из того, что реально есть у вас на кухне."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Погледај своје дневне циљеве калорија и макронутријената, бележи оброке док једеш, или питај „Шта могу да направим?” за прави рецепт направљен само од онога што стварно имаш у кухињи."
          }
        }
      }
    },
