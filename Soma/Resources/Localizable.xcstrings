    "signIn.apple.error.noAppleID": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't sign in with Apple. Check that you're signed in to an Apple ID in Settings, then try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo iniciar sesión con Apple. Comprueba que has iniciado sesión con un ID de Apple en Ajustes y vuelve a intentarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de se connecter avec Apple. Vérifie que tu es connecté·e à un identifiant Apple dans Réglages, puis réessaie."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile accedere con Apple. Controlla di aver eseguito l'accesso con un ID Apple in Impostazioni, poi riprova."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Anmeldung mit Apple nicht möglich. Stelle sicher, dass du in den Einstellungen mit einer Apple-ID angemeldet bist, und versuche es erneut."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось войти через Apple. Проверь, что ты вошёл(ла) в Apple ID в настройках, и попробуй снова."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple-ით შესვლა ვერ მოხერხდა. დარწმუნდი, რომ პარამეტრებში შესული ხარ Apple ID-ით, და სცადე ხელახლა."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Չհաջողվեց մուտք գործել Apple-ով։ Ստուգիր, որ մուտք ես գործել Apple ID-ով Կարգավորումներում, ապա նորից փորձիր։"
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Пријава преко Apple налога није успела. Провери да ли си пријављен/а на Apple ID у Подешавањима, па покушај поново."
          }
        }
      },
      "comment": "Sign in with Apple error shown when no Apple ID appears to be signed in on the device"
    },
    "signIn.apple.error.failed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple couldn't complete the sign-in. Please try again in a moment."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple no pudo completar el inicio de sesión. Inténtalo de nuevo en un momento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple n'a pas pu terminer la connexion. Réessaie dans un instant."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple non è riuscito a completare l'accesso. Riprova tra un momento."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple konnte die Anmeldung nicht abschließen. Bitte versuche es gleich noch einmal."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple не смог завершить вход. Попробуй снова через минуту."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple-მა ვერ დაასრულა შესვლა. სცადე ისევ ცოტა ხანში."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple-ը չկարողացավ ավարտել մուտքը։ Փորձիր նորից մի փոքր ուշ։"
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple није успео да заврши пријаву. Покушај поново за тренутак."
          }
        }
      },
      "comment": "Sign in with Apple error shown when Apple's own sign-in flow failed or returned an invalid response"
    },
