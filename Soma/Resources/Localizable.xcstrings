    "Based on your setup and health, here's today's workout to reach your goal:": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Según tu equipo y tu salud, este es el entrenamiento de hoy para alcanzar tu objetivo:"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En fonction de votre équipement et de votre santé, voici l'entraînement du jour pour atteindre votre objectif :"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In base alla tua attrezzatura e alla tua salute, ecco l'allenamento di oggi per raggiungere il tuo obiettivo:"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Basierend auf deiner Ausstattung und deiner Gesundheit ist hier dein heutiges Workout, um dein Ziel zu erreichen:"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На основе твоего оборудования и здоровья — вот тренировка на сегодня, чтобы прийти к цели:"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "შენი აღჭურვილობისა და ჯანმრთელობის მიხედვით, აი დღევანდელი ვარჯიში შენი მიზნის მისაღწევად:"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Հիմնվելով քո պայմանների և առողջության վրա՝ ահա այսօրվա մարզումը՝ նպատակիդ հասնելու համար."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "На основу твоје опреме и здравља, ево данашњег тренинга за остварење твог циља:"
          }
        }
      },
      "comment": "Intro line above the generated plan on the result card"
    },
