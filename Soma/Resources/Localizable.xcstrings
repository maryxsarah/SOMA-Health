    "trainingEmphasis.recomp": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ahora mismo, tu plan se centra en ganar fuerza mientras pierdes grasa."
          }
        },
        "fr": {
