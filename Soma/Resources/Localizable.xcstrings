    "Optional" : {
      "comment" : "Form section header",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Optional"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opcional"
          }
        },
        "fr" : {
          "stringUnit" : {
