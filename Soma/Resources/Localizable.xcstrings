    "A max test on a depleted day under-reads you. It'll open on your next moderate or better day.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una prueba máxima en un día agotado te subestima. Se abrirá en tu próximo día moderado o mejor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un test maximal un jour de fatigue vous sous-estime. Il s'ouvrira lors de votre prochain jour modéré ou meilleur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un test massimale in una giornata di scarico ti sottostima. Si aprirà nella tua prossima giornata moderata o migliore."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
