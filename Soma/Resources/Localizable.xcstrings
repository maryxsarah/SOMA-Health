    "profile.training.groupFootnote" : {
      "comment" : "Footnote under the Training settings group",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Erfahrung bestimmt die Blockanzahl, Supersätze und Pausen. Eine echte Hebezahl schlägt eine Schätzung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Experience sets block count, supersets and rest. A real lift number beats an estimate."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La experiencia determina el número de bloques, las series combinadas y el descanso. Un número real de levantamiento supera a una estimación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'expérience détermine le nombre de blocs, les supersets et le repos. Un vrai chiffre de charge vaut mieux qu'une estimation."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Փորձառությունը սահմանում է բլոկների քանակը, սուպերսեթերը և հանգիստը: Իրական քաշի ցուցանիշը գերազանցում է կանխատեսմանը:"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'esperienza determina il numero di blocchi, i superset e il riposo. Un numero reale di sollevamento batte una stima."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "გამოცდილება განსაზღვრავს ბლოკების რაოდენობას, სუპერსეტებსა და დასვენებას. რეალური აწევის მაჩვენებელი აჯობებს შეფასებას."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Опыт определяет число блоков, суперсеты и отдых. Реальный рабочий вес точнее любой оценки."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Искуство одређује број блокова, суперсетове и одмор. Права тежина дизања боља је од процене."
          }
        }
      }
    },
