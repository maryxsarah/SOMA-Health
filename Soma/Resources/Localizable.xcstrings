          }
        }
      },
      "comment": "No placeholders"
    },
    "recommendationReason.explanation.insufficientData": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no hay suficientes datos de salud para generar una lectura personalizada; Soma establece por defecto una sesión moderada y prudente mientras se crea tu valor de referencia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas encore assez de données de santé pour établir une lecture personnalisée : Soma opte par défaut pour une séance modérée et prudente pendant que votre référence se construit."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non ci sono ancora abbastanza dati sulla salute per generare una lettura personalizzata: Soma imposta di default una sessione moderata e prudente mentre si crea la tua baseline."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch nicht genug Gesundheitsdaten für eine personalisierte Auswertung – Soma setzt standardmäßig auf eine vorsichtige, moderate Einheit, während dein Ausgangswert aufgebaut wird."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not enough health data yet to build a personalized read -- Soma is defaulting to a cautious moderate session while your baseline builds."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пока недостаточно данных о здоровье для персонализированной оценки -- Soma по умолчанию предлагает осторожную умеренную тренировку, пока формируется твой базовый уровень."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ჯერ არ არის საკმარისი ჯანმრთელობის მონაცემები პერსონალიზებული შეფასებისთვის -- Soma სიფრთხილისთვის გთავაზობს საშუალო ინტენსივობის სესიას, სანამ შენი საბაზისო მაჩვენებელი ყალიბდება."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Առողջության տվյալները դեռ բավարար չեն անհատականացված գնահատական կազմելու համար -- Soma-ն զգուշությամբ առաջարկում է չափավոր պարապմունք, մինչև ձևավորվի քո բազային ցուցանիշը."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Још увек нема довољно здравствених података за персонализовану процену — Soma подразумевано бира опрезну, умерену сесију док се гради твој основни ниво."
          }
        }
      },
      "comment": "No placeholders"
    },
