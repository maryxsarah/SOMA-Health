    "loadingBar.mealFact.8" : {
      "comment" : "Rotating food-trivia fact shown while a logged meal is estimated",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
