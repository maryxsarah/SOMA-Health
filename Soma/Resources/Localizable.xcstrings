    "goalPace.slow.description": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ir despacio significa un plan diario más suave y sostenible."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Y aller doucement signifie un plan quotidien plus doux et plus durable."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Andare piano significa un piano quotidiano più dolce e sostenibile."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein langsames Tempo bedeutet einen sanfteren, nachhaltigeren Tagesplan."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Going slow means a gentler, more sustainable daily plan."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Медленный темп — это более щадящий и устойчивый ежедневный план."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ნელი ტემპი ნიშნავს უფრო რბილ და მდგრად ყოველდღიურ გეგმას."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Դանդաղ տեմպը նշանակում է ավելի մեղմ և կայուն օրական պլան։"
          }
        }
      }
    },
    "goalPace.recommended.description": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un ritmo equilibrado que se adapta a un progreso constante y duradero."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un rythme équilibré adapté à une progression régulière et durable."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un ritmo equilibrato adatto a un progresso costante e duraturo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein ausgewogenes Tempo für stetigen, dauerhaften Fortschritt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A balanced pace that fits steady, lasting progress."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сбалансированный темп для стабильного и долгосрочного прогресса."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "დაბალანსებული ტემპი, რომელიც ერგება სტაბილურ, ხანგრძლივ პროგრესს."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Հավասարակշռված տեմպ, որը համապատասխանում է կայուն, երկարատև առաջընթացին։"
          }
        }
      }
    },
    "goalPace.fast.description": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un ritmo más rápido implica un plan diario más exigente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un rythme plus rapide implique un plan quotidien plus exigeant."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un ritmo più veloce comporta un piano quotidiano più impegnativo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein schnelleres Tempo bedeutet einen anspruchsvolleren Tagesplan."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A faster pace means a more demanding daily plan."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Быстрый темп — это более интенсивный ежедневный план."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "სწრაფი ტემპი ნიშნავს უფრო მოთხოვნად ყოველდღიურ გეგმას."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ավելի արագ տեմպը նշանակում է ավելի պահանջկոտ օրական պլան։"
          }
        }
      }
    },
