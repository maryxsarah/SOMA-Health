    "overviewAccordion.recovery.title": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Recuperación / Preparación"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Récupération / Préparation"
          }
        },
        "it": {
