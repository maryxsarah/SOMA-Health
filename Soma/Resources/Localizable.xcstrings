    "Get your daily plan in seconds, tailored to your health. Follow your plan, and see your progress add up." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erhalte in Sekunden deinen Tagesplan, abgestimmt auf deine Gesundheit. Folge deinem Plan und beobachte, wie sich deine Fortschritte summieren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Get your daily plan in seconds, tailored to your health. Follow your plan, and see your progress add up."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obtén tu plan diario en segundos, adaptado a tu salud. Sigue tu plan y observa cómo se acumula tu progreso."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obtenez votre plan quotidien en quelques secondes, adapté à votre santé. Suivez votre plan et regardez vos progrès s'accumuler."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ստացիր քո օրական պլանը վայրկյանների ընթացքում՝ հարմարեցված քո առողջությանը։ Հետևիր քո պլանին և տես, թե ինչպես է աճում քո առաջընթացը։"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ottieni il tuo piano giornaliero in pochi secondi, su misura per la tua salute. Segui il tuo piano e guarda i tuoi progressi accumularsi."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "მიიღე შენი ყოველდღიური გეგმა წამებში, მორგებული შენს ჯანმრთელობაზე. მიჰყევი გეგმას და ნახე, როგორ იზრდება შენი პროგრესი."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Получи свой ежедневный план за секунды — с учётом твоего здоровья. Следуй плану и смотри, как растёт твой прогресс."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Добиј свој дневни план за неколико секунди, прилагођен твом здрављу. Прати свој план и гледај како твој напредак расте."
          }
        }
      }
    },
