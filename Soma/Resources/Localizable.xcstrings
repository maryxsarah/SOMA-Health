        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "შენი პროფილიდან — Soma ჯერ არ აკვირდება წონის ცვლილებას დროთა განმავლობაში."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Քո պրոֆիլից — Soma-ն դեռ չի հետևում քաշի փոփոխություններին ժամանակի ընթացքում։"
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Из твог профила — Soma још не прати промене тежине током времена."
          }
        }
      },
      "comment": "Body section footnote under the weight reading. 'Soma' is the product name and must stay untranslated in every locale."
    },
