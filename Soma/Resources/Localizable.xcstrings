    "dailyChecklist.standard.progressPicture.dueSubtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Compare against your goal photo -- a weekly gut-check that keeps you coming back."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Compárala con tu foto objetivo -- una revisión semanal que te hace volver."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Compare-la à ta photo objectif -- un point hebdomadaire qui donne envie de revenir."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Confrontala con la tua foto obiettivo -- un check settimanale che ti fa tornare."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vergleiche es mit deinem Zielfoto -- ein wöchentlicher Realitätscheck, der dich zurückkommen lässt."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сравни с целевым фото -- еженедельная проверка, которая заставляет возвращаться."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "შეადარე შენს სამიზნე ფოტოს -- ყოველკვირეული შემოწმება, რომელიც გაბრუნებს ისევ."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Համեմատիր քո նպատակային լուսանկարի հետ -- շաբաթական ստուգում, որը ստիպում է վերադառնալ։"
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Упореди са својом циљном фотографијом — недељна провера која те стално враћа."
          }
        }
      },
      "comment": "Standard-mode checklist item subtitle shown when this week's progress picture is due"
    },
