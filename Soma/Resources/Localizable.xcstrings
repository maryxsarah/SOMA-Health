    "mealRecommendation.equipmentHint.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We don't know your kitchen yet"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no sabemos qué tienes en tu cocina"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nous ne connaissons pas encore ta cuisine"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non conosciamo ancora la tua cucina"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir kennen deine Küche noch nicht"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Мы пока не знаем, что есть на твоей кухне"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ჯერ არ ვიცით, რა გაქვს სამზარეულოში"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Մենք դեռ չգիտենք, թե ինչ ունես խոհանոցում"
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Још не знамо шта имаш у кухињи"
          }
        }
