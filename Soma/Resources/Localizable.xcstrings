          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Կրկնակի թեստի արդյունքը չափման սխալի սահմաններում է: Պարապմունքի տվյալները դեռ ցույց են տալիս, որ աշխատանքը շարունակվում է:"
