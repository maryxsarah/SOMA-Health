        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Collegare Whoop od Oura fornisce un punteggio di recupero più preciso rispetto alla sola Apple Salute."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Verbindung mit Whoop oder Oura liefert einen genaueren Erholungswert als Apple Health allein."
          }
        },
        "en": {
