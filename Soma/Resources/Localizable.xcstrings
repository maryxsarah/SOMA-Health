    "Switch to Week, Month, or Year for a trend -- this app records one %@ reading per day, not an intraday series." : {
      "comment" : "%@ is the lowercased metric name, e.g. 'hrv' or 'sleep'",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wechsle zu Woche, Monat oder Jahr, um einen Trend zu sehen – diese App erfasst nur einen %@-Wert pro Tag, keine Werte im Tagesverlauf."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Switch to Week, Month, or Year for a trend -- this app records one %@ reading per day, not an intraday series."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cambia a Semana, Mes o Año para ver una tendencia: esta app registra una lectura de %@ al día, no una serie horaria."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passez à Semaine, Mois ou Année pour voir une tendance : cette application enregistre une mesure de %@ par jour, pas une série intrajournalière."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Անցի՛ր «Շաբաթ», «Ամիս» կամ «Տարի» ռեժիմին՝ միտումը տեսնելու համար․ հավելվածը գրանցում է %@-ի մեկ ցուցանիշ օրում, ոչ թե օրվա ընթացքի տվյալներ։"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passa a Settimana, Mese o Anno per vedere una tendenza: questa app registra una rilevazione di %@ al giorno, non una serie infragiornaliera."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "გადართე „კვირაზე“, „თვეზე“ ან „წელზე“ ტენდენციის სანახავად — აპლიკაცია დღეში ერთ %@ ჩანაწერს ინახავს და არა დღის განმავლობაში მონაცემებს."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Переключись на «Неделю», «Месяц» или «Год», чтобы увидеть тренд — приложение записывает один показатель %@ в день, а не почасовые данные."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пребаци на Недељу, Месец или Годину да видиш тренд — апликација бележи само једно очитавање за %@ дневно, не и податке током дана."
          }
        }
      }
    },
