    "logWorkout.section.effortFooter": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Effort helps Soma calibrate tomorrow's plan around today's real training load."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El esfuerzo ayuda a Soma a calibrar el plan de mañana según tu carga de entrenamiento real de hoy."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'effort aide Soma à calibrer le programme de demain selon ta charge d'entraînement réelle d'aujourd'hui."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo sforzo aiuta Soma a calibrare il piano di domani in base al tuo reale carico di allenamento di oggi."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Anstrengung hilft Soma, den morgigen Plan an deine heutige tatsächliche Trainingsbelastung anzupassen."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Уровень усилия помогает Soma настроить завтрашний план с учётом твоей реальной нагрузки сегодня."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "დატვირთვის ხარისხი ეხმარება Soma-ს, ხვალინდელი გეგმა დღევანდელ რეალურ სავარჯიშო დატვირთვაზე მორგოს."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ջանքի աստիճանը օգնում է Soma-ին վաղվա ծրագիրը հարմարեցնել այսօրվա իրական մարզման ծանրաբեռնվածությանը։"
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Напор помаже да Soma прилагоди сутрашњи план стварном тренажном оптерећењу од данас."
          }
        }
      },
      "comment": "Log-activity form: footer explaining why effort is captured"
    },
