        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Soma-ի AI ծառայությունը ժամանակավորապես անհասանելի է: Մենք արդեն ծանուցում ենք ստացել -- փորձիր ավելի ուշ:"
