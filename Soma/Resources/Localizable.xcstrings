    "profile.language.restartAlert.message" : {
      "comment" : "Alert message telling the user to manually close and reopen the app to finish a language switch; placeholder is the newly-selected language's own display name",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Großteil der App hat sich bereits geändert. Schließe Soma (wische es im App-Umschalter weg) und öffne es erneut, um alles auf %@ zu sehen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Most of the app already switched. Close Soma (swipe it away from the app switcher) and reopen it to see everything in %@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La mayor parte de la app ya cambió. Cierra Soma (deslízala hacia arriba en el selector de apps) y vuelve a abrirla para verlo todo en %@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La majeure partie de l'appli a déjà changé. Ferme Soma (fais-la glisser hors du sélecteur d'applications) et rouvre-la pour tout voir en %@."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Հավելվածի մեծ մասն արդեն փոխվել է։ Փակիր Soma-ն (սահեցրու հավելվածների փոխարկիչում) և նորից բացիր՝ ամեն ինչը %@ լեզվով տեսնելու համար։"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La maggior parte dell'app è già cambiata. Chiudi Soma (fai scorrere verso l'alto nel selettore app) e riaprila per vedere tutto in %@."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "აპლიკაციის დიდი ნაწილი უკვე შეიცვალა. დახურე Soma (გადაფურცლე აპების გადამრთველში) და ხელახლა გახსენი, რომ ყველაფერი %@ ენაზე ნახო."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Большая часть приложения уже переключилась. Закрой Soma (смахни его в списке приложений) и открой снова, чтобы увидеть всё на %@."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Већи део апликације је већ промењен. Затвори Soma (превуци је у листи апликација) и поново је отвори да видиш све на %@."
          }
        }
      }
    },
