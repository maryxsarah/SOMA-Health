    "howSomaWorks.dailyReadiness.whereToFind" : {
      "comment" : "How Soma Works tour: where-to-find line for the daily readiness feature",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Immer die erste Karte auf der Startseite. Tippe auf \"Warum das?\", um die echten Zahlen dahinter zu sehen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Always the first card on Home. Tap \"Why this?\" to see the real numbers behind it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siempre es la primera tarjeta en Inicio. Toca \"¿Por qué?\" para ver los números reales detrás."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toujours la première carte sur l'accueil. Appuyez sur « Pourquoi ça ? » pour voir les vrais chiffres derrière."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Միշտ Գլխավոր էջի առաջին քարտն է։ Հպեք «Ինչու՞» կոճակին՝ իրական թվերը տեսնելու համար։"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "È sempre la prima scheda in Home. Tocca \"Perché?\" per vedere i numeri reali dietro."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ყოველთვის მთავარი გვერდის პირველი ბარათია. შეეხეთ „რატომ?“-ს რეალური მონაცემების სანახავად."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Всегда первая карточка на главном экране. Нажмите «Почему это?», чтобы увидеть реальные цифры."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Увек прва картица на Почетној. Додирни „Зашто ово?” да видиш стварне бројеве иза тога."
          }
        }
      }
    },
    "howSomaWorks.dashboard.description" : {
      "comment" : "How Soma Works tour: card description for the dashboard feature",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jede Kennzahl, die Soma ausliest -- Schlaf, HRV, Ruhepuls, Stimmung, Gewicht -- über die Zeit dargestellt, damit du einen echten Trend siehst statt nur die Momentaufnahme von heute."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Every metric Soma reads -- sleep, HRV, resting heart rate, mood, weight -- plotted over time, so you can see a real trend instead of just today's snapshot."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada métrica que Soma lee -- sueño, VFC, frecuencia cardíaca en reposo, ánimo, peso -- representada a lo largo del tiempo, para que veas una tendencia real en vez de solo la foto de hoy."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque indicateur lu par Soma -- sommeil, VFC, fréquence cardiaque au repos, humeur, poids -- tracé dans le temps, pour voir une vraie tendance plutôt qu'un simple instantané du jour."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Soma-ի կողմից կարդացվող յուրաքանչյուր ցուցանիշ՝ քուն, HRV, հանգստի զարկերակ, տրամադրություն, քաշ -- գծագրված ժամանակի ընթացքում, որպեսզի տեսնեք իրական միտում այսօրվա պատկերի փոխարեն։"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogni metrica letta da Soma -- sonno, HRV, frequenza cardiaca a riposo, umore, peso -- tracciata nel tempo, così vedi una tendenza reale invece della sola istantanea di oggi."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ყველა მაჩვენებელი, რომელსაც Soma კითხულობს -- ძილი, HRV, მოსვენებული პულსი, განწყობა, წონა -- გამოსახული დროში, რომ ნახოთ რეალური ტენდენცია მხოლოდ დღევანდელი სურათის ნაცვლად."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Каждый показатель, который считывает Soma — сон, ВСР, пульс покоя, настроение, вес — отображается во времени, чтобы вы видели реальную тенденцию, а не только сегодняшний снимок."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Свака метрика коју Soma чита -- сан, ХРВ, пулс у мировању, расположење, тежина -- приказана кроз време, да видиш стваран тренд уместо само данашњег тренутног стања."
          }
        }
      }
    },
