    "How fast do you want to reach your goal?": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Con qué rapidez quieres alcanzar tu objetivo?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À quelle vitesse voulez-vous atteindre votre objectif ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Con quale rapidità vuoi raggiungere il tuo obiettivo?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie schnell möchtest du dein Ziel erreichen?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Как быстро ты хочешь достичь цели?"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "რამდენად სწრაფად გინდა მიაღწიო მიზანს?"
          }
        },
        "hy": {
