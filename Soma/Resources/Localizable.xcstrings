    "goal_progress.estimate.no_reliable_estimate": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu peso objetivo aún no coincide con tu foto objetivo. Actualízalo en Ajustes para obtener una estimación real."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre poids cible ne correspond pas encore à votre photo objectif. Mettez-le à jour dans Réglages pour obtenir une estimation réelle."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo peso obiettivo non corrisponde ancora alla tua foto obiettivo. Aggiornalo nelle Impostazioni per una stima reale."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Zielgewicht stimmt noch nicht mit deinem Zielfoto überein. Aktualisiere es in den Einstellungen für eine echte Schätzung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your target weight doesn't match your goal photo yet -- update it in Settings for a real estimate."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Твой целевой вес пока не соответствует фото цели — обнови его в настройках, чтобы получить точный расчёт."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "შენი სამიზნე წონა ჯერ არ ემთხვევა მიზნის ფოტოს — განაახლე ის პარამეტრებში ზუსტი შეფასებისთვის."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Քո նպատակային քաշը դեռ չի համապատասխանում նպատակային լուսանկարին — թարմացրու այն Կարգավորումներում՝ ստանալու համար ճշգրիտ գնահատական։"
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Твоја циљна тежина се још увек не поклапа са фотографијом циља — ажурирај је у Подешавањима за прецизну процену."
          }
        }
      },
      "comment": "estimateLine(_:) guard branch; fixed Text(estimateLine(progress)) not auto-localizing."
    },
    "goal_progress.estimate.past_timeline": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Superaste tu plazo estimado de ~%@, pero el progreso constante sigue contando."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous avez dépassé votre délai estimé d'environ %@, mais une progression régulière compte toujours."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai superato la tua tempistica stimata di ~%@, ma i progressi costanti contano comunque."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast deinen geschätzten Zeitrahmen von ~%@ überschritten – stetiger Fortschritt zählt trotzdem."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Past your estimated ~%@ timeline -- steady progress still counts."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Оценочный срок ~%@ уже позади — но стабильный прогресс всё равно в счёт."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "შენი სავარაუდო ~%@ ვადა უკვე გავიდა — თანმიმდევრული პროგრესი მაინც ითვლება."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Քո գնահատված ~%@ ժամկետն արդեն անցել է — կայուն առաջընթացը դեռ արժեքավոր է։"
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Процењени рок од ~%@ је прошао — стабилан напредак и даље се рачуна."
          }
        }
      },
      "comment": "estimateLine(_:) fraction>=1.0 branch. Placeholder is the resolved monthsText string (e.g. '3 months')."
    },
    "goal_progress.estimate.remaining_timeline": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aproximadamente %@ para alcanzar tu objetivo al ritmo que elegiste."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Environ %@ pour atteindre votre objectif au rythme choisi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Circa %@ per raggiungere il tuo obiettivo al ritmo che hai scelto."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Etwa %@ bis zu deinem Ziel bei deinem gewählten Tempo."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Roughly %@ to your goal at your chosen pace."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Примерно %@ до цели при выбранном темпе."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "დაახლოებით %@ დარჩა შენს მიზნამდე არჩეული ტემპით."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ընտրված տեմպով մոտավորապես %@ է մնում քո նպատակին հասնելու համար։"
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Отприлике %@ до твог циља при изабраном темпу."
          }
        }
      },
      "comment": "estimateLine(_:) fraction<1.0 branch. Placeholder is the resolved monthsText string."
    },
    "goal_progress.error.process_photo": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo procesar esa foto. Prueba con otra."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de traiter cette photo. Essayez-en une autre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile elaborare quella foto. Provane un'altra."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Foto konnte nicht verarbeitet werden. Versuch es mit einem anderen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't process that photo. Try another one."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось обработать это фото. Попробуй другое."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ამ ფოტოს დამუშავება ვერ მოხერხდა. სცადე სხვა."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Չհաջողվեց մշակել այս լուսանկարը։ Փորձիր մեկ ուրիշը։"
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Није могуће обрадити ту фотографију. Пробај другу."
          }
        }
      },
      "comment": "errorMessage state, upload(kind:item:) compression failure. Fixed Text(errorMessage) not auto-localizing."
    },
    "goal_progress.error.upload_photo": {
