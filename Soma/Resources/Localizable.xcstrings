            "value": "Դու լավ միտումի մեջ ես -- պահպանիր կայուն քունը և ակտիվությունը, որպեսզի մնաս այս մակարդակում."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "На добром си путу — одржавај доследан сан и активност да ту и останеш."
          }
        }
      },
      "comment": "Tomorrow tip shown for a high HealthKit-only recovery day; no placeholders"
    },
    "recommendationReason.tomorrowTip.insufficientData": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usar tu Apple Watch por la noche, o conectar Whoop u Oura, te dará una lectura personalizada a partir de mañana."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Porter votre Apple Watch la nuit, ou connecter Whoop ou Oura, vous donnera une lecture personnalisée dès demain."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Indossare l'Apple Watch di notte, o collegare Whoop od Oura, ti darà una lettura personalizzata a partire da domani."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn du deine Apple Watch nachts trägst oder Whoop bzw. Oura verbindest, erhältst du ab morgen eine personalisierte Auswertung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wearing your Apple Watch overnight, or connecting Whoop or Oura, will give you a personalized read starting tomorrow."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если ты будешь носить Apple Watch ночью или подключишь Whoop или Oura, начиная с завтрашнего дня ты будешь получать персонализированную оценку."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Watch-ის ღამით ტარება ან Whoop-ის ან Oura-ს დაკავშირება ხვალიდან პერსონალიზებულ შეფასებას მოგცემს."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Watch-ը գիշերը կրելը կամ Whoop-ը կամ Oura-ն միացնելը վաղվանից քեզ կտա անհատականացված գնահատական."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ношење Apple Watch-а преко ноћи, или повезивање Whoop-а или Oura-е, даће ти персонализовану процену почев од сутра."
          }
        }
      },
      "comment": "Tomorrow tip shown when there wasn't enough health data today; no placeholders"
    },
    "recommendationReason.tomorrowTip.unknown": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conectar Whoop u Oura te da una puntuación de recuperación más precisa que solo Apple Health."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connecter Whoop ou Oura donne un score de récupération plus précis qu'Apple Santé seul."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Collegare Whoop od Oura fornisce un punteggio di recupero più preciso rispetto alla sola Apple Salute."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Verbindung mit Whoop oder Oura liefert einen genaueren Erholungswert als Apple Health allein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connecting Whoop or Oura gives a more precise recovery score than Apple Health alone."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подключение Whoop или Oura даёт более точную оценку восстановления, чем только Apple Health."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "Whoop-ის ან Oura-ს დაკავშირება უფრო ზუსტ აღდგენის მაჩვენებელს იძლევა, ვიდრე მხოლოდ Apple Health."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Whoop-ի կամ Oura-ի միացումը ավելի ճշգրիտ վերականգնման գնահատական է տալիս, քան միայն Apple Health-ը."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Повезивање Whoop-а или Oura-е даје прецизнију оцену опоравка него сам Apple Health."
          }
        }
      },
      "comment": "Tomorrow tip fallback for unrecognized server reason codes; no placeholders"
    },
    "dataConfidence.caveat.low": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La lectura de hoy se basa en datos limitados: Apple Health no registró mucha información. Usar tu reloj por la noche, o conectar Whoop u Oura, hace esto más preciso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La lecture d'aujourd'hui repose sur des données limitées : Apple Santé n'a pas enregistré grand-chose. Porter votre montre la nuit, ou connecter Whoop ou Oura, rend cela plus précis."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La lettura di oggi si basa su dati limitati: Apple Salute non ha registrato molto su cui basarsi. Indossare l'orologio di notte, o collegare Whoop od Oura, rende tutto più preciso."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die heutige Auswertung basiert auf begrenzten Daten – Apple Health hat nicht viel aufgezeichnet. Wenn du deine Uhr nachts trägst oder Whoop bzw. Oura verbindest, wird dies genauer."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Today's read is based on limited data — Apple Health didn't record much to go on. Wearing your watch overnight, or connecting Whoop or Oura, makes this more precise."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сегодняшняя оценка основана на ограниченных данных — Apple Health записал немного информации. Ношение часов ночью или подключение Whoop или Oura сделает её точнее."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "დღევანდელი შეფასება შეზღუდულ მონაცემებზეა დაფუძნებული — Apple Health-მა ცოტა რამ ჩაწერა. საათის ღამით ტარება ან Whoop-ის ან Oura-ს დაკავშირება უფრო ზუსტს გახდის მას."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Այսօրվա գնահատականը հիմնված է սահմանափակ տվյալների վրա — Apple Health-ը քիչ բան է գրանցել. Ժամացույցը գիշերը կրելը կամ Whoop-ի կամ Oura-ի միացումը այն ավելի ճշգրիտ կդարձնի."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Данашња процена се заснива на ограниченим подацима — Apple Health није забележио много на шта може да се ослони. Ношење сата преко ноћи, или повезивање Whoop-а или Oura-е, чини ово прецизнијим."
          }
        }
      },
      "comment": "Caveat shown under the explanation when confidence in today's read is low; no placeholders"
    },
