    "onboarding.blockersNotes.subtitle" : {
      "comment" : "Subtitle on the blockers notes question step",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Optional -- ein oder zwei Sätze helfen uns, deine Situation zu verstehen. Du kannst diesen Schritt auch überspringen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Optional -- a sentence or two helps us understand your situation. Totally fine to skip."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opcional: una o dos frases nos ayudan a entender tu situación. También puedes omitir este paso."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Facultatif -- une ou deux phrases nous aident à comprendre votre situation. Vous pouvez tout à fait passer cette étape."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ընտրովի է․ մեկ-երկու նախադասությունը կօգնի մեզ հասկանալ ձեր իրավիճակը։ Կարող եք նաև բաց թողնել այս քայլը։"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Facoltativo -- una o due frasi ci aiutano a capire la tua situazione. Puoi anche saltare questo passaggio."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "სურვილისამებრ -- ერთი ან ორი წინადადება დაგვეხმარება თქვენი სიტუაციის გაგებაში. ამ ნაბიჯის გამოტოვებაც შეგიძლიათ."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Необязательно — пара предложений поможет нам понять вашу ситуацию. Этот шаг можно и пропустить."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Опционо -- реченица или две помажу нам да разумемо твоју ситуацију. Слободно прескочи овај корак."
          }
        }
      }
    },
