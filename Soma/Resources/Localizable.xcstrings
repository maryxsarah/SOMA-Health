    "loadingBar.mealFact.0" : {
      "comment" : "Rotating food-trivia fact shown while a logged meal is estimated",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Honig verdirbt nie -- Archäologen haben 3.000 Jahre alten Honig gefunden, der noch essbar ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Honey never spoils -- archaeologists have found 3,000-year-old honey that's still edible."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La miel nunca caduca: los arqueólogos han encontrado miel de 3000 años que todavía se puede comer."
