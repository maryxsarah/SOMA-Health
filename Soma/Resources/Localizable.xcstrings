        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "~%lldգ սպիտակուց, %lldգ ածխաջրեր՝ էներգիայի և հագեցվածության համար։"
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "~%lldг протеина, %lldг угљених хидрата за енергију и ситост."
          }
        }
      },
      "comment": "Standard-mode checklist item subtitle: today's remaining protein/carb targets"
    },
    "dailyChecklist.standard.breakfast.noTargetSubtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Log what you eat to keep today's bars filling in."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Registra lo que comes para que las barras de hoy se vayan completando."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistre ce que tu manges pour continuer à remplir les barres du jour."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Registra ciò che mangi per continuare a riempire le barre di oggi."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Protokolliere, was du isst, damit sich die heutigen Balken weiter füllen."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Записывай, что ты ешь, чтобы сегодняшние шкалы заполнялись."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ჩაწერე, რას ჭამ, რომ დღევანდელი ზოლები ივსებოდეს."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Գրանցիր, թե ինչ ես ուտում, որպեսզի այսօրվա գոտիները շարունակեն լցվել։"
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Бележи шта једеш како би се данашње траке пуниле."
          }
        }
      },
