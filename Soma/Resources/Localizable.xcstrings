    "Show us your goal": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muéstranos tu objetivo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Montrez-nous votre objectif"
          }
        },
        "it": {
