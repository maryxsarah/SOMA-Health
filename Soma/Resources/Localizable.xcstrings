          }
        }
      }
    },
    "Only suggests workouts you can actually do": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo sugiere entrenamientos que realmente puedes hacer"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne suggère que des entraînements que vous pouvez réellement faire"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Suggerisce solo allenamenti che puoi davvero svolgere"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schlägt nur Workouts vor, die du tatsächlich ausführen kannst"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Предлагает только те тренировки, которые ты действительно можешь выполнить"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "გთავაზობს მხოლოდ იმ ვარჯიშებს, რომელთა შესრულებაც შენ შეგიძლია"
