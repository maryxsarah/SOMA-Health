    "logMeal.input.listening": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Listening -- tap the mic when you're done, or just stop talking."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escuchando -- toca el micrófono cuando termines, o simplemente deja de hablar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Écoute en cours -- appuie sur le micro quand tu as fini, ou arrête simplement de parler."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In ascolto -- tocca il microfono quando hai finito, o smetti semplicemente di parlare."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hört zu -- tippe aufs Mikrofon, wenn du fertig bist, oder hör einfach auf zu sprechen."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Слушаю -- нажми на микрофон, когда закончишь, или просто перестань говорить."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "მისმენს -- შეეხე მიკროფონს, როცა დაასრულებ, ან უბრალოდ შეწყვიტე ლაპარაკი."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Լսում է -- հպիր խոսափողին, երբ ավարտես, կամ պարզապես դադարիր խոսել։"
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Слушам — додирни микрофон када завршиш, или једноставно престани да причаш."
          }
        }
      },
      "comment": "Hint shown while dictating a meal description with the mic"
    },
    "logMeal.footer.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Type it, dictate it, or describe your meal in words -- Soma fills in the fields below either way. Review and adjust anything before saving."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escríbelo, dictalo o describe tu comida con palabras -- Soma completa los campos de abajo de cualquier forma. Revisa y ajusta lo que necesites antes de guardar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Écris-le, dicte-le ou décris ton repas avec des mots -- Soma remplit les champs ci-dessous dans tous les cas. Vérifie et ajuste avant d'enregistrer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scrivilo, dettalo o descrivi il tuo pasto a parole -- Soma compila comunque i campi qui sotto. Rivedi e modifica tutto prima di salvare."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe es, diktiere es oder beschreibe deine Mahlzeit in Worten -- Soma füllt die Felder unten so oder so aus. Überprüfe und passe alles vor dem Speichern an."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Напиши, продиктуй или опиши свой приём пищи словами -- Soma в любом случае заполнит поля ниже. Проверь и при необходимости измени перед сохранением."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "დაწერე, გააჟღერე ან აღწერე შენი კვება სიტყვებით -- Soma ისედაც შეავსებს ქვემოთ მოცემულ ველებს. შეამოწმე და საჭიროებისამებრ შეასწორე შენახვამდე."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Գրիր, ասա բարձրաձայն կամ նկարագրիր քո ուտելիքը բառերով -- Soma-ն ամեն դեպքում կլրացնի ստորև դաշտերը։ Ստուգիր և անհրաժեշտության դեպքում ուղղիր՝ նախքան պահպանելը։"
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Упиши, издиктирај или опиши свој оброк речима — Soma ће у сваком случају попунити поља испод. Провери и по потреби прилагоди пре чувања."
          }
        }
      },
      "comment": "Footer note explaining the meal entry section on the log meal screen"
    },
    "mealRecommendation.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What can I make?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Qué puedo cocinar?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Qu'est-ce que je peux cuisiner ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cosa posso cucinare?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was kann ich kochen?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Что я могу приготовить?"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "რისი მომზადება შემიძლია?"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ի՞նչ կարող եմ պատրաստել։"
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Шта могу да скувам?"
          }
        }
      },
      "comment": "Navigation title for the AI meal recommendation screen"
    },
    "mealRecommendation.input.heading": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tell Soma what you have."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dile a Soma qué tienes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dis à Soma ce que tu as."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Di' a Soma cosa hai."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sag Soma, was du hast."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Скажи Soma, что у тебя есть."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "უთხარი Soma-ს, რა გაქვს."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ասա Soma-ին, թե ինչ ունես։"
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Реци Soma шта имаш."
          }
        }
      },
      "comment": "Heading on the meal recommendation input screen"
    },
    "mealRecommendation.input.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Type it, dictate it, or just list what's in the fridge and pantry -- Soma builds one full recipe from it, sized to what's left of today's target."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escríbelo, dictalo o simplemente enumera lo que hay en la nevera y la despensa -- Soma crea una receta completa a partir de eso, ajustada a lo que queda de tu objetivo de hoy."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Écris-le, dicte-le ou énumère simplement ce qu'il y a dans le frigo et le placard -- Soma crée une recette complète à partir de ça, ajustée à ce qu'il te reste de l'objectif du jour."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scrivilo, dettalo o elenca semplicemente cosa c'è in frigo e in dispensa -- Soma crea una ricetta completa in base a questo, dimensionata su ciò che resta del tuo obiettivo di oggi."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe es, diktiere es oder liste einfach auf, was im Kühlschrank und in der Speisekammer ist -- Soma erstellt daraus ein vollständiges Rezept, passend zu dem, was von deinem heutigen Ziel übrig ist."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Напиши, продиктуй или просто перечисли, что есть в холодильнике и кладовой -- Soma составит из этого полноценный рецепт, подобранный под остаток твоей сегодняшней цели."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "დაწერე, გააჟღერე ან უბრალოდ ჩამოთვალე, რა გაქვს მაცივარსა და საკუჭნაოში -- Soma ამის საფუძველზე შექმნის სრულ რეცეპტს, მორგებულს დღევანდელი მიზნის დარჩენილ ნაწილზე."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Գրիր, ասա բարձրաձայն կամ պարզապես թվարկիր, թե ինչ կա սառնարանում և պահեստում -- Soma-ն դրանից կկազմի ամբողջական բաղադրատոմս՝ հարմարեցված այսօրվա նպատակի մնացորդին։"
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Упиши, издиктирај или само наброј шта имаш у фрижидеру и остави — Soma ће од тога направити цео рецепт, прилагођен ономе што ти је остало од данашњег циља."
          }
        }
      },
      "comment": "Subtitle explaining how to describe ingredients on the meal recommendation input screen"
    },
    "mealRecommendation.input.placeholder": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "e.g. \"chicken breast, spinach, rice, half an onion\""
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "p. ej. \"pechuga de pollo, espinacas, arroz, media cebolla\""
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "p. ex. « blanc de poulet, épinards, riz, un demi-oignon »"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "es. \"petto di pollo, spinaci, riso, mezza cipolla\""
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "z. B. „Hähnchenbrust, Spinat, Reis, eine halbe Zwiebel“"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "например, «куриная грудка, шпинат, рис, половина луковицы»"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "მაგ. „ქათმის ფილე, ისპანახი, ბრინჯი, ნახევარი ხახვი“"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "օր.՝ «հավի կրծքամիս, սպանախ, բրինձ, կես սոխ»"
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "нпр. „пилеће груди, спанаћ, пиринач, пола главице лука\""
          }
        }
      },
      "comment": "Placeholder text for the ingredients input field"
    },
