    },
    "sleepSection.noData.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wear your device overnight to see sleep here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa tu dispositivo durante la noche para ver tu sueño aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Porte ton appareil pendant la nuit pour voir ton sommeil ici."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Indossa il dispositivo di notte per vedere qui il tuo sonno."
          }
        },
        "de": {
