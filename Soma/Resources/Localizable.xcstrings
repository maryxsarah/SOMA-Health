    "Stages take time to unlock. Session data still shows the work happening." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stufen brauchen Zeit, bis sie sich freischalten. Deine Trainingsdaten zeigen trotzdem, dass du dranbleibst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las etapas tardan en desbloquearse. Los datos de tus sesiones siguen mostrando el trabajo que haces."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les étapes prennent du temps à débloquer. Les données de vos séances montrent tout de même le travail accompli."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Փուլերի բացվելը ժամանակ է պահանջում: Պարապմունքի տվյալները դեռ ցույց են տալիս, որ աշխատանքը շարունակվում է:"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le tappe richiedono tempo per sbloccarsi. I dati delle sessioni mostrano comunque il lavoro svolto."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ეტაპების გახსნას დრო სჭირდება. სესიის მონაცემები მაინც აჩვენებს, რომ სამუშაო მიმდინარეობს."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Этапы открываются не сразу. Данные сессий всё равно показывают, что работа идёт."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нивоима је потребно време да се откључају. Подаци о сесијама ипак показују да се ради."
          }
        }
      }
    },
