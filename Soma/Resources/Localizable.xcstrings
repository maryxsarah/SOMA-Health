    "Soma needs camera access to see your gym equipment. You can turn it back on in Settings." : {
      "comment" : "Explainer body text for the plain camera-denied case",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Soma benötigt Kamerazugriff, um deine Fitnessgeräte zu erkennen. Du kannst ihn in den Einstellungen wieder aktivieren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Soma necesita acceso a la cámara para ver el equipo de tu gimnasio. Puedes volver a activarlo en Ajustes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Soma a besoin d'accéder à l'appareil photo pour voir le matériel de votre salle de sport. Vous pouvez le réactiver dans Réglages."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Soma-ին տեսախցիկի հասանելիություն է անհրաժեշտ՝ քո մարզասրահի սարքավորումները տեսնելու համար։ Կարող ես նորից միացնել այն Կարգավորումներում։"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Soma ha bisogno di accedere alla fotocamera per vedere l'attrezzatura della tua palestra. Puoi riattivarlo in Impostazioni."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Soma-ს სჭირდება წვდომა კამერაზე, რომ დაინახოს შენი დარბაზის ინვენტარი. შეგიძლია ისევ ჩართო ეს პარამეტრებში."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Soma нужен доступ к камере, чтобы увидеть оборудование твоего зала. Ты можешь снова включить его в настройках."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Soma треба приступ камери да би видела опрему у твојој теретани. Можеш га поново укључити у Подешавањима."
          }
        }
      }
    },
