    "exerciseDetail.rpeExplainer" : {
      "comment" : "Explainer for RPE shown when an exercise's intensity mentions RPE",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RPE = Rate of Perceived Exertion (wahrgenommene Anstrengung) — wie schwer sich ein Satz anfühlt (1 = sehr leicht, 10 = maximale Anstrengung)."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RPE = Rate of Perceived Exertion, how hard a set feels (1 = very easy, 10 = maximum effort)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RPE = Índice de Esfuerzo Percibido, lo duro que se siente una serie (1 = muy fácil, 10 = esfuerzo máximo)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RPE = indice d'effort perçu, à quel point une série est ressentie comme difficile (1 = très facile, 10 = effort maximal)."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RPE = ընկալվող ջանքի աստիճան, թե որքան դժվար է զգացվում մարզումը (1 = շատ հեշտ, 10 = առավելագույն ջանք)։"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RPE = Indice di Sforzo Percepito, quanto è impegnativa una serie (1 = molto facile, 10 = sforzo massimo)."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RPE = აღქმული დატვირთვის დონე — რამდენად რთულია სავარჯიშო სეტი (1 = ძალიან იოლი, 10 = მაქსიმალური ძალისხმევა)."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RPE = субъективная оценка нагрузки — насколько тяжёлым ощущается подход (1 = очень легко, 10 = максимальное усилие)."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RPE = Оцена перципираног напора, колико тежак делује сет (1 = веома лако, 10 = максималан напор)."
          }
        }
      }
    },
