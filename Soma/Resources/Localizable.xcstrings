    "Soma doesn't move workouts between days yet -- pick another day from the week strip on Home to do it there instead." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Soma kann Workouts noch nicht zwischen Tagen verschieben. Wähle dazu einen anderen Tag in der Wochenleiste auf der Startseite aus."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Soma todavía no puede mover entrenamientos entre días. Elige otro día en la franja semanal de Inicio para hacerlo desde ahí."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Soma ne peut pas encore déplacer les séances d'un jour à l'autre. Choisissez un autre jour dans le bandeau de la semaine sur Accueil pour le faire depuis là."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Soma-ն դեռ չի կարող մարզումները փոխանցել օրերի միջև — ընտրիր մեկ այլ օր Home-ի շաբաթվա շերտից՝ այնտեղ դա անելու համար։"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Soma non può ancora spostare gli allenamenti tra i giorni. Scegli un altro giorno dalla barra della settimana in Home per farlo da lì."
