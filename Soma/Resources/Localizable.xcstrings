    "profile.language.explainer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Most of Soma updates immediately; the rest applies next time you open the app."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La mayor parte de Soma se actualiza al instante; el resto se aplica la próxima vez que abras la app."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La majeure partie de Soma se met à jour immédiatement ; le reste s'applique la prochaine fois que vous ouvrez l'application."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La maggior parte di Soma si aggiorna subito; il resto si applica la prossima volta che apri l'app."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Großteil von Soma aktualisiert sich sofort; der Rest wird beim nächsten Öffnen der App angewendet."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Большая часть Soma обновляется сразу; остальное применится при следующем открытии приложения."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "Soma-ს ნაწილი მაშინვე განახლდება; დანარჩენი ამოქმედდება აპლიკაციის შემდეგი გახსნისას."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Soma-ի մեծ մասը թարմացվում է անմիջապես, մնացածը կկիրառվի հավելվածի հաջորդ բացման ժամանակ:"
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Највећи део Soma се ажурира одмах; остало се примењује следећи пут када отвориш апликацију."
          }
        }
      },
      "comment": "Explainer text at top of the language picker sheet"
    },
    "profile.language.restartAlert.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restart Soma to finish switching"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reinicia Soma para completar el cambio"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Redémarre Soma pour terminer le changement"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riavvia Soma per completare il cambio"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Starte Soma neu, um den Wechsel abzuschließen"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перезапусти Soma, чтобы завершить смену языка"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "გადატვირთე Soma, რომ დაასრულო შეცვლა"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Վերագործարկիր Soma-ն՝ փոփոխությունն ավարտելու համար"
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Рестартуј Soma да завршиш промену"
          }
        }
      },
      "comment": "Alert title shown after picking a new app language"
    },
    "profile.language.restartAlert.confirm": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Got it"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Entendido"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Compris"
