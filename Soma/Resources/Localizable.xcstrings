    "profile.kitchenEquipment.explainer" : {
      "comment" : "Explainer text at top of the kitchen-equipment editor sheet",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "So schlagen wir dir nur Rezepte vor, die du wirklich kochen kannst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "So we only ever suggest recipes you can actually cook."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Así solo te sugerimos recetas que realmente puedes cocinar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ainsi, on ne te propose que des recettes que tu peux vraiment cuisiner."
