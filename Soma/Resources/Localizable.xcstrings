    "Adjusts the AI workout plan's structure -- how many blocks, whether it uses supersets, and rest periods.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajusta la estructura del plan de entrenamiento con IA -- cuántos bloques, si usa superseries y los periodos de descanso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajuste la structure du plan d'entraînement généré par l'IA -- nombre de blocs, utilisation de super-séries et temps de repos."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Modifica la struttura del piano di allenamento IA -- numero di blocchi, uso di superserie e tempi di recupero."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Passt den Aufbau des KI-Trainingsplans an -- Anzahl der Blöcke, Supersätze und Pausenzeiten."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Настраивает структуру ИИ-плана тренировок — количество блоков, использование суперсетов и периоды отдыха."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "არეგულირებს AI ვარჯიშის გეგმის სტრუქტურას — რამდენი ბლოკია, იყენებს თუ არა სუპერსეტებს და დასვენების პერიოდებს."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Կարգավորում է AI մարզման պլանի կառուցվածքը՝ բլոկների քանակը, սուպերսեթերի կիրառումը և հանգստի ժամանակահատվածները։"
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Прилагођава структуру AI плана тренинга — број блокова, да ли користи суперсерије и периоде одмора."
          }
        }
      }
    },
    "What's your goal?": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Cuál es tu objetivo?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quel est votre objectif ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Qual è il tuo obiettivo?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was ist dein Ziel?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Какая у тебя цель?"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "რა არის შენი მიზანი?"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ի՞նչ է քո նպատակը։"
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Који је твој циљ?"
          }
        }
      }
    },
    "What else do you have access to?": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿A qué más tienes acceso?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À quoi d'autre avez-vous accès ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "A cos'altro hai accesso?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Worauf hast du sonst noch Zugriff?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "К чему ещё у тебя есть доступ?"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "კიდევ რაზე გაქვს წვდომა?"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Էլ ի՞նչին ես հասանելիություն ունես։"
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Чему још имаш приступ?"
          }
        }
      }
    },
    "A personal tracking goal -- doesn't change what Soma recommends, just what it shows you here.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un objetivo de seguimiento personal -- no cambia lo que Soma recomienda, solo lo que te muestra aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un objectif de suivi personnel -- cela ne change pas ce que Soma recommande, seulement ce qui s'affiche ici."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un obiettivo di monitoraggio personale -- non cambia ciò che Soma consiglia, solo ciò che ti mostra qui."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein persönliches Tracking-Ziel -- ändert nicht, was Soma empfiehlt, nur was dir hier angezeigt wird."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Личная цель для отслеживания — не влияет на рекомендации Soma, только на то, что ты видишь здесь."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "პირადი თვალთვალის მიზანი — არ ცვლის Soma-ს რეკომენდაციებს, მხოლოდ იმას, რასაც აქ გიჩვენებს."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Անձնական հետևման նպատակ․ չի փոխում Soma-ի առաջարկությունները, միայն այն, ինչ ցույց է տալիս այստեղ։"
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Лични циљ за праћење — не мења шта Soma препоручује, само оно што ти приказује овде."
          }
        }
      }
    },
