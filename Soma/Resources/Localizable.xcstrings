            "value": "Du hast heute einen Ruhetag angefragt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You asked for a rest day today."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "По твоей просьбе сегодня — день отдыха."
