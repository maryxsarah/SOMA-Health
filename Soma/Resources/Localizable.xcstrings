          "stringUnit": {
            "state": "translated",
            "value": "Found a bug or have an idea? It goes straight to the team."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нашёл(-а) баг или есть идея? Она сразу попадёт к команде."
