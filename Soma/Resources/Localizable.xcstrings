    "goalStart.targetBlock.qualitativeCaption" : {
      "comment" : "",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fortschritt hier bedeutet absolvierte Sessions plus dein eigener Check-in — keine erfundenen Zahlen."
