    "Soma wasn't sure what it saw -- add the equipment you have available.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Soma no estaba seguro de lo que vio: añade el equipo que tengas disponible."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Soma n'était pas sûr de ce qu'il a vu : ajoutez le matériel dont vous disposez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Soma non era sicuro di cosa avesse visto: aggiungi l'attrezzatura che hai a disposizione."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Soma war sich nicht sicher, was es gesehen hat – füge die Geräte hinzu, die du hast."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Soma не смогла точно определить, что видит, — добавь доступное тебе оборудование."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "Soma-მ ბოლომდე ვერ ამოიცნო, რას ხედავდა — დაამატე შენთვის ხელმისაწვდომი ინვენტარი."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Soma-ն լրիվ վստահ չէր, թե ինչ է տեսնում — ավելացրու քեզ մոտ եղած սարքավորումները։"
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Soma није била сигурна шта је видела — додај опрему коју имаш на располагању."
          }
        }
      },
      "comment": "Caption shown above the equipment chips when vision confidence was low. Source uses a literal double-hyphen; preserve as the catalog key exactly."
    },
    "Here's what Soma detected. Add or remove anything before continuing.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto es lo que Soma detectó. Añade o elimina lo que necesites antes de continuar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Voici ce que Soma a détecté. Ajoutez ou supprimez des éléments avant de continuer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ecco cosa ha rilevato Soma. Aggiungi o rimuovi elementi prima di continuare."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das hat Soma erkannt. Füge vor dem Fortfahren etwas hinzu oder entferne es."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вот что удалось определить Soma. Добавь или убери что-нибудь перед тем, как продолжить."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "აი, რა აღმოაჩინა Soma-მ. დაამატე ან წაშალე რამე გაგრძელებამდე."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ահա, ինչ հայտնաբերեց Soma-ն։ Ավելացրու կամ հեռացրու ինչ-որ բան, նախքան շարունակելը։"
          }
        },
        "sr": {
