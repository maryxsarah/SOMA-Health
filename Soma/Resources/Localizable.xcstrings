    "mealRecommendation.error.generateFailed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't come up with something from that -- try describing it differently, or try again in a moment."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo pensar en algo con eso -- intenta describirlo de otra forma, o vuelve a intentarlo en un momento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de trouver une idée avec ça -- essaie de le décrire différemment, ou réessaie dans un instant."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non sono riuscito a pensare a qualcosa con questo -- prova a descriverlo diversamente, o riprova tra un momento."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Daraus konnte nichts entstehen -- versuche es anders zu beschreiben oder es gleich noch einmal."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не получилось ничего придумать из этого -- попробуй описать иначе или повтори попытку через момент."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ამისგან ვერაფერი მოვიფიქრეთ -- სცადე სხვაგვარად აღწერო, ან სცადე ისევ ცოტა ხანში."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Չհաջողվեց ինչ-որ բան մտածել դրանից -- փորձիր այլ կերպ նկարագրել, կամ մի փոքր ուշ նորից փորձիր։"
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Није успело да се смисли ништа од тога — покушај да то опишеш другачије, или покушај поново за тренутак."
          }
        }
      },
      "comment": "Error shown when AI meal recommendation generation fails"
    },
    "nutrition.emptyState.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Soma computes this from your weight, height, and goal weight -- normally already on file from onboarding. Add goal photos for an even more tailored target, or make sure those numbers are filled in."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Soma calcula esto a partir de tu peso, altura y peso objetivo -- normalmente ya están registrados desde el onboarding. Añade fotos objetivo para un objetivo aún más personalizado, o asegúrate de que esos números estén completos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Soma calcule cela à partir de ton poids, ta taille et ton poids cible -- normalement déjà enregistrés lors de l'onboarding. Ajoute des photos objectif pour une cible encore plus personnalisée, ou assure-toi que ces chiffres sont renseignés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Soma lo calcola in base al tuo peso, altezza e peso obiettivo -- di solito già registrati durante l'onboarding. Aggiungi foto obiettivo per un target ancora più personalizzato, o assicurati che quei numeri siano compilati."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Soma berechnet dies aus deinem Gewicht, deiner Größe und deinem Zielgewicht -- normalerweise bereits aus dem Onboarding hinterlegt. Füge Zielfotos für ein noch individuelleres Ziel hinzu, oder stelle sicher, dass diese Zahlen ausgefüllt sind."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Soma рассчитывает это на основе твоего веса, роста и целевого веса -- обычно они уже указаны при первичной настройке. Добавь целевые фото для ещё более точной цели или убедись, что эти цифры заполнены."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "Soma ამას ითვლის შენი წონის, სიმაღლისა და სამიზნე წონის მიხედვით -- ჩვეულებრივ უკვე მითითებულია საწყისი გამართვისას. დაამატე სამიზნე ფოტოები კიდევ უფრო მორგებული მიზნისთვის, ან დარწმუნდი, რომ ეს რიცხვები შევსებულია."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Soma-ն սա հաշվարկում է քո քաշի, հասակի և նպատակային քաշի հիման վրա -- սովորաբար դրանք արդեն նշված են սկզբնական կարգավորումից։ Ավելացրու նպատակային լուսանկարներ էլ ավելի հարմարեցված նպատակի համար, կամ համոզվիր, որ այդ թվերը լրացված են։"
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Soma то израчунава на основу твоје тежине, висине и циљне тежине — обично су већ унете током почетног подешавања. Додај циљне фотографије за још прецизнији циљ, или се увери да су ти бројеви попуњени."
          }
        }
      },
      "comment": "Explains how nutrition targets are computed, shown when no target exists yet"
    },
