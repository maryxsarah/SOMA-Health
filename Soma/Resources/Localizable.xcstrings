        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Չհաջողվեց գնահատել դա․ փորձիր այլ կերպ նկարագրել կամ ինքդ մուտքագրիր թվերը ներքևում։"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non è stato possibile stimarlo. Prova a descriverlo in modo diverso, oppure inserisci tu i numeri qui sotto."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ვერ შევაფასეთ — სცადე სხვანაირად აღწერო, ან თავად შეიყვანე მაჩვენებლები ქვემოთ."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось это оценить — попробуй описать иначе или введи цифры ниже вручную."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нисмо успели то да проценимо — покушај да опишеш другачије, или ручно унеси бројеве испод."
          }
        }
      }
    },
    "logMeal.footer.description" : {
      "comment" : "Footer note explaining the meal entry section on the log meal screen",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippe es, diktiere es oder beschreibe deine Mahlzeit in Worten -- Soma füllt die Felder unten so oder so aus. Überprüfe und passe alles vor dem Speichern an."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Type it, dictate it, or describe your meal in words -- Soma fills in the fields below either way. Review and adjust anything before saving."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escríbelo, dictalo o describe tu comida con palabras -- Soma completa los campos de abajo de cualquier forma. Revisa y ajusta lo que necesites antes de guardar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Écris-le, dicte-le ou décris ton repas avec des mots -- Soma remplit les champs ci-dessous dans tous les cas. Vérifie et ajuste avant d'enregistrer."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Գրիր, ասա բարձրաձայն կամ նկարագրիր քո ուտելիքը բառերով -- Soma-ն ամեն դեպքում կլրացնի ստորև դաշտերը։ Ստուգիր և անհրաժեշտության դեպքում ուղղիր՝ նախքան պահպանելը։"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scrivilo, dettalo o descrivi il tuo pasto a parole -- Soma compila comunque i campi qui sotto. Rivedi e modifica tutto prima di salvare."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "დაწერე, გააჟღერე ან აღწერე შენი კვება სიტყვებით -- Soma ისედაც შეავსებს ქვემოთ მოცემულ ველებს. შეამოწმე და საჭიროებისამებრ შეასწორე შენახვამდე."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Напиши, продиктуй или опиши свой приём пищи словами -- Soma в любом случае заполнит поля ниже. Проверь и при необходимости измени перед сохранением."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Упиши, издиктирај или опиши свој оброк речима — Soma ће у сваком случају попунити поља испод. Провери и по потреби прилагоди пре чувања."
          }
        }
      }
    },
    "logMeal.input.listening" : {
      "comment" : "Hint shown while dictating a meal description with the mic",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hört zu -- tippe aufs Mikrofon, wenn du fertig bist, oder hör einfach auf zu sprechen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Listening -- tap the mic when you're done, or just stop talking."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escuchando -- toca el micrófono cuando termines, o simplemente deja de hablar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Écoute en cours -- appuie sur le micro quand tu as fini, ou arrête simplement de parler."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Լսում է -- հպիր խոսափողին, երբ ավարտես, կամ պարզապես դադարիր խոսել։"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In ascolto -- tocca il microfono quando hai finito, o smetti semplicemente di parlare."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "მისმენს -- შეეხე მიკროფონს, როცა დაასრულებ, ან უბრალოდ შეწყვიტე ლაპარაკი."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Слушаю -- нажми на микрофон, когда закончишь, или просто перестань говорить."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Слушам — додирни микрофон када завршиш, или једноставно престани да причаш."
          }
        }
      }
    },
    "logMeal.macrosOutOfRange" : {
      "comment" : "Validation error shown when entered meal macros are out of allowed range",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kalorien sollten zwischen 0 und 5000 liegen und Makros zwischen 0 und 500 g – überprüfe deine Angaben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Calories should be 0-5000 and macros 0-500g -- check your numbers."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las calorías deben estar entre 0 y 5000, y los macros entre 0 y 500 g: revisa tus datos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les calories doivent être comprises entre 0 et 5000, et les macros entre 0 et 500 g : vérifiez vos chiffres."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Կալորիաները պետք է լինեն 0-5000, իսկ մակրոները՝ 0-500գ միջակայքում․ ստուգիր թվերը։"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le calorie devono essere comprese tra 0 e 5000 e i macro tra 0 e 500 g: controlla i tuoi numeri."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "კალორია უნდა იყოს 0-5000-ს შორის, ხოლო მაკროელემენტები — 0-500გ-ს შორის. გადაამოწმე მონაცემები."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Калории должны быть в пределах 0-5000, а БЖУ — 0-500 г. Проверь введённые данные."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Калорије треба да буду у распону 0-5000, а макронутријенти 0-500 г — провери унете бројеве."
          }
        }
      }
    },
