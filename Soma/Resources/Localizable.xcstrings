            "value": "Твой показатель ВСР был близок к обычному уровню, и сна было достаточно -- хороший признак восстановления."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "შენი HRV მაჩვენებელი ახლოს იყო შენს ჩვეულ დონესთან და საკმარისად გეძინა -- აღდგენის კარგი ნიშანია."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Քո HRV ցուցանիշը մոտ էր քո սովորական մակարդակին, և դու բավարար քնել ես -- վերականգնման լավ նշան է."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Твој HRV је био близу твог недавног основног нивоа, а сан је био довољан — добар знак опоравка."
          }
        }
      },
      "comment": "No placeholders"
    },
    "recommendationReason.explanation.healthkitMedium": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu VFC estuvo algo por debajo de tu valor de referencia reciente, o dormiste un poco menos; un día moderado es lo más adecuado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre VFC était un peu en dessous de votre référence récente, ou vous avez un peu manqué de sommeil : une journée modérée est la mieux adaptée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tua HRV era leggermente inferiore alla tua baseline recente, oppure hai dormito un po' poco: oggi è indicata una giornata moderata."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine HRV lag etwas unter deinem aktuellen Ausgangswert, oder der Schlaf war etwas kurz – ein moderater Tag passt am besten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your HRV was somewhat below your recent baseline, or sleep was a little short -- a moderate day fits best."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Твой показатель ВСР был немного ниже обычного уровня, или сна было недостаточно -- сегодня лучше всего подойдёт умеренная нагрузка."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "შენი HRV მაჩვენებელი ოდნავ დაბალი იყო შენს ჩვეულ დონეზე, ან ძილი ცოტა ხნით ნაკლები იყო -- დღეს საუკეთესოდ საშუალო დატვირთვა მოგერგება."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Քո HRV ցուցանիշը փոքր-ինչ ցածր էր քո սովորական մակարդակից, կամ քունը մի փոքր կարճ էր -- այսօրվա համար լավագույնս հարմար է չափավոր օրը."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Твој HRV је био нешто испод твог недавног основног нивоа, или је сан био мало кратак — данас најбоље одговара умерен дан."
          }
        }
      },
      "comment": "No placeholders"
    },
    "recommendationReason.explanation.healthkitLow": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu VFC estuvo muy por debajo de tu valor de referencia reciente, o dormiste poco; tu cuerpo necesita bajar el ritmo hoy."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre VFC était bien en dessous de votre référence récente, ou le sommeil a été court : votre corps a besoin de lever le pied aujourd'hui."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tua HRV era ben al di sotto della tua baseline recente, oppure hai dormito poco: oggi il tuo corpo ha bisogno di rallentare."
