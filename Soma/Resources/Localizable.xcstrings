      "comment": "Row consequence text describing the How Soma Works tour refresher"
    },
    "profile.kitchenEquipment.explainer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "So we only ever suggest recipes you can actually cook."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Así solo te sugerimos recetas que realmente puedes cocinar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainsi, on ne te propose que des recettes que tu peux vraiment cuisiner."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Così ti suggeriamo solo ricette che puoi davvero cucinare."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "So schlagen wir dir nur Rezepte vor, die du wirklich kochen kannst."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Так мы предлагаем только те рецепты, которые ты реально можешь приготовить."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ასე ყოველთვის მხოლოდ იმ რეცეპტებს გთავაზობთ, რომლის მომზადებაც შენ შეგიძლია."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Այսպես մենք միշտ առաջարկում ենք միայն այն բաղադրատոմսերը, որոնք դու իրականում կարող ես պատրաստել։"
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Тако ти предлажемо само рецепте које заиста можеш да скуваш."
          }
        }
      },
      "comment": "Explainer text at top of the kitchen-equipment editor sheet"
    },
