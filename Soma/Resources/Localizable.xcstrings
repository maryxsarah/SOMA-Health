    "recommendationDetail.pregnancyDisclaimer": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto es solo una orientación general, no un consejo médico: sigue las recomendaciones de tu médico o partera, especialmente si tienes alguna complicación del embarazo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ceci n'est qu'une orientation générale, pas un avis médical — veuillez suivre les recommandations de votre médecin ou de votre sage-femme, surtout en cas de complications liées à la grossesse."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa è solo un'indicazione generale, non un consiglio medico: segui le raccomandazioni del tuo medico o della tua ostetrica, specialmente se hai complicazioni legate alla gravidanza."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dies ist nur eine allgemeine Orientierung, keine medizinische Beratung – bitte befolge die Empfehlungen deiner Ärztin/deines Arztes oder deiner Hebamme, besonders wenn Schwangerschaftskomplikationen vorliegen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is general guidance only, not medical advice -- please follow your doctor's or midwife's recommendations, especially if you have any pregnancy complications."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это только общие рекомендации, а не медицинский совет — пожалуйста, следуй указаниям своего врача или акушерки, особенно если у тебя есть какие-либо осложнения беременности."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ეს მხოლოდ ზოგადი რჩევაა და არა სამედიცინო რჩევა — გთხოვ, მიჰყევი შენი ექიმის ან ბებიაქალის რეკომენდაციებს, განსაკუთრებით თუ გაქვს რაიმე გართულება ორსულობის დროს."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Սա միայն ընդհանուր ուղեցույց է և ոչ թե բժշկական խորհուրդ․ խնդրում ենք հետևել քո բժշկի կամ մանկաբարձուհու առաջարկություններին, հատկապես եթե հղիության որևէ բարդություն ունես։"
          }
        }
      },
      "comment": "Fixed safety disclaimer shown when the user's profile indicates pregnancy; mirrors pregnancyGuidance.ts's PREGNANCY_DISCLAIMER verbatim. Safety-relevant -- translate precisely."
    },
    "recommendationDetail.goalBlockEyebrow": {
      "extractionState": "manual",
      "localizations": {
