    "Start from this Home card — or anytime via Profile → Training → My goal. The beta switch lives in Account." : {
      "comment" : "Onboarding slide 1 subtitle, references app navigation: Home tab, Profile → Training → My goal, Account",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starte über diese Karte auf der Startseite — oder jederzeit über Profil → Training → Mein Ziel. Der Beta-Schalter befindet sich unter Konto."
          }
        },
        "en" : {
          "stringUnit" : {
