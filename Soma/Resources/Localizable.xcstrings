    "Never wonder what to do today.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nunca te preguntes qué hacer hoy."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne vous demandez plus jamais quoi faire aujourd'hui."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non chiederti mai più cosa fare oggi."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Frag dich nie wieder, was du heute tun sollst."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Больше не нужно гадать, что делать сегодня."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "აღარასდროს გაინტერესებს, რა გააკეთო დღეს."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Այլևս պետք չէ մտածել, թե ինչ անել այսօր։"
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Никад више не мораш да нагађаш шта да радиш данас."
          }
        }
      }
    },
