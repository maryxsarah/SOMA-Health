    "trainingEmphasis.cut": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ahora mismo, tu plan se centra en perder grasa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En ce moment, ton programme est axé sur la perte de graisse."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In questo momento, il tuo piano è concentrato sulla perdita di grasso."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Im Moment konzentriert sich dein Plan darauf, Fett zu reduzieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Right now, your plan is focused on leaning out."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сейчас твой план сфокусирован на снижении жира."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ახლა შენი გეგმა ორიენტირებულია სხეულის ცხიმის შემცირებაზე."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Հիմա քո պլանը կենտրոնացած է մարմնի ճարպի նվազեցման վրա։"
          }
        }
      },
      "comment": "Encouraging sentence describing the current plan's training emphasis, shown on the Progress screen; informal tu/du register to match rest of catalog"
    },
    "trainingEmphasis.bulk": {
      "extractionState": "manual",
      "localizations": {
