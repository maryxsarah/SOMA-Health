    "dailyChecklist.onboarding.firstMeal.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Type it, dictate it, or use \"What can I make?\""
          }
        },
