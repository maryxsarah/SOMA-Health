    "Describe your meal and Soma will fill in the fields below -- review and adjust anything before saving." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beschreibe deine Mahlzeit, und Soma füllt die Felder unten aus – überprüfe und passe alles an, bevor du speicherst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Describe your meal and Soma will fill in the fields below -- review and adjust anything before saving."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Describe tu comida y Soma completará los campos de abajo: revisa y ajusta lo que necesites antes de guardar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Décrivez votre repas et Soma remplira les champs ci-dessous : vérifiez et ajustez si besoin avant d'enregistrer."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Նկարագրիր քո սնունդը, և Soma-ն կլրացնի ստորև դաշտերը․ ստուգիր և անհրաժեշտության դեպքում ուղղիր՝ նախքան պահպանելը։"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Descrivi il tuo pasto e Soma compilerà i campi qui sotto: rivedi e modifica tutto ciò che vuoi prima di salvare."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "აღწერე შენი კვება და Soma შეავსებს ველებს ქვემოთ — შეამოწმე და საჭიროებისამებრ შეასწორე შენახვამდე."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Опиши свой приём пищи, и Soma заполнит поля ниже — проверь и при необходимости скорректируй перед сохранением."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Опиши свој оброк, а Soma ће попунити поља испод — прегледај и по потреби прилагоди пре чувања."
          }
        }
      }
    },
