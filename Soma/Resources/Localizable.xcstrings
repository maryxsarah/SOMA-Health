    "customGoalForm.commitmentLine.template": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ durante %@ semanas — vuelve a revisarlo con tu coach alrededor del %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ pendant %@ semaines — refaites le point avec votre coach vers le %@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ per %@ settimane — rivedilo con il tuo coach intorno al %@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ für %@ Wochen — sprich es mit deinem Coach um den %@ erneut durch."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ for %@ weeks — re-check with your coach around %@."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ в течение %@ недель — сверься с тренером примерно %@."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@ კვირის განმავლობაში — გადაამოწმე მწვრთნელთან დაახლოებით %@."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@ շաբաթ շարունակ — վերստուգիր մարզչիդ հետ մոտավորապես %@:"
          }
        }
      },
      "comment": "Commitment summary line. Placeholders in order: frequency phrase (String), duration in weeks (String, already pluralized), formatted re-check date (String)"
    },
    "customGoalForm.error.parseFailed": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No pudimos leerlo — inténtalo de nuevo o completa los campos tú mismo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de lire cela — réessayez ou remplissez les champs vous-même."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non siamo riusciti a leggerlo — riprova o compila i campi tu stesso."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das konnten wir nicht lesen — versuche es erneut oder fülle die Felder selbst aus."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't read that — try again, or fill in the fields yourself."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось это распознать — попробуй снова или заполни поля вручную."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ამის წაკითხვა ვერ მოხერხდა — სცადე ხელახლა ან თვითონ შეავსე ველები."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Չհաջողվեց դա կարդալ — նորից փորձիր կամ ինքդ լրացրու դաշտերը:"
          }
        }
      },
      "comment": "Error shown when AI parsing of a photographed or typed coach assignment fails"
    },
    "goalCreation.error.baselineFailed": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu objetivo empezó, pero no se pudo guardar la base — vuelve a tocar el botón para reintentarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre objectif a démarré, mais la référence n'a pas pu être enregistrée — appuyez à nouveau sur le bouton pour réessayer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo obiettivo è iniziato, ma non è stato possibile salvare la base — tocca di nuovo il pulsante per riprovare."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Ziel wurde gestartet, aber die Basis konnte nicht gespeichert werden — tippe erneut auf den Button, um es noch einmal zu versuchen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your goal started, but the baseline couldn't be saved — tap the button again to retry."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Твоя цель началась, но исходный показатель не удалось сохранить — нажми кнопку ещё раз, чтобы повторить."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "შენი მიზანი დაიწყო, მაგრამ საწყისი მაჩვენებლის შენახვა ვერ მოხერხდა — დააჭირე ღილაკს ისევ, რომ სცადო თავიდან."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Քո նպատակը սկսվեց, բայց ելակետային ցուցանիշը հնարավոր չեղավ պահպանել — կրկին սեղմիր կոճակը՝ նորից փորձելու համար:"
          }
        }
      },
      "comment": "Error shown when goal creation succeeded but saving the baseline measurement failed. Shared by CustomGoalFormView and GoalStartView."
    },
