    "At a %@ pace, most people following their plan consistently reach a goal like this in about %@. Consistency in the early weeks matters most." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bei einem Tempo von %@ erreichen die meisten Menschen, die ihrem Plan konsequent folgen, ein Ziel wie dieses in etwa %@. Beständigkeit in den ersten Wochen zählt am meisten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A un ritmo %@, la mayoría de las personas que siguen su plan de forma constante alcanzan una meta como esta en unos %@. La constancia en las primeras semanas es lo que más importa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "À un rythme %@, la plupart des personnes qui suivent leur plan avec constance atteignent un objectif comme celui-ci en environ %@. La régularité des premières semaines est ce qui compte le plus."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ տեմպով՝ իրենց պլանին հետևողականորեն հետևող մարդկանց մեծ մասը այսպիսի նպատակի հասնում է մոտավորապես %@-ում։ Հետևողականությունը առաջին շաբաթներին ամենակարևորն է։"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con un ritmo %@, la maggior parte delle persone che segue il proprio piano con costanza raggiunge un obiettivo come questo in circa %@. La costanza nelle prime settimane è ciò che conta di più."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ტემპით, ადამიანების უმეტესობა, ვინც სტაბილურად მისდევს გეგმას, ასეთ მიზანს აღწევს დაახლოებით %@-ში. თანმიმდევრულობა პირველ კვირებში ყველაზე მნიშვნელოვანია."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "При темпе %@ большинство людей, стабильно следующих плану, достигают такой цели примерно за %@. Постоянство в первые недели важнее всего."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Уз %@ темпо, већина људи која доследно прати свој план оствари овакав циљ за отприлике %@. Доследност у првим недељама је најважнија."
          }
        }
      }
    },
