    "goalHub.paused.safety.message" : {
      "comment" : "Banner message explaining why a goal was safely paused",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Training für dieses Ziel wird dir aktuell nicht empfohlen, deshalb ist es sicher pausiert. Deine Daten bleiben erhalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This goal's training isn't recommended for you right now, so it's safely paused. Your data stays put."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El entrenamiento de este objetivo no se te recomienda ahora mismo, así que está pausado por seguridad. Tus datos se conservan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'entraînement de cet objectif ne vous est pas recommandé pour le moment, il est donc mis en pause par sécurité. Vos données restent intactes."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Այս նպատակի մարզումն ընթացիկ պահին ձեզ չի խորհուրդ տրվում, ուստի այն անվտանգորեն դադարեցված է։ Ձեր տվյալները մնում են անձեռնմխելի։"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'allenamento di questo obiettivo non è consigliato per te in questo momento, quindi è in pausa per sicurezza. I tuoi dati restano intatti."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ამ მიზნის ვარჯიში ამჟამად თქვენთვის რეკომენდებული არ არის, ამიტომ ის უსაფრთხოდ დაპაუზებულია. თქვენი მონაცემები უცვლელი რჩება."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тренировки для этой цели сейчас вам не рекомендуются, поэтому она приостановлена ради безопасности. Ваши данные сохранены."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тренинг за овај циљ тренутно ти се не препоручује, па је безбедно паузиран. Твоји подаци остају сачувани."
          }
        }
      }
    },
