    "loadingBar.mealFact.8" : {
      "comment" : "Rotating food-trivia fact shown while a logged meal is estimated",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sellerie zu kauen verbrennt etwa so viele Kalorien, wie er enthält -- fast ein Nullsummenspiel."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chewing celery burns about as many calories as it contains -- close to a wash."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Masticar apio quema casi tantas calorías como las que contiene, casi un empate."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mâcher du céleri brûle presque autant de calories qu'il en contient : quasiment nul en bilan."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Նեխուրը ծամելը այրում է գրեթե այնքան կալորիա, որքան այն պարունակում է -- գրեթե զրոյի է հավասարվում."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Masticare il sedano brucia quasi tante calorie quante ne contiene: quasi un pareggio."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ნიახურის ღეჭვა თითქმის იმდენივე კალორიას წვავს, რამდენსაც თავად შეიცავს -- თითქმის გათანაბრებულია."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "На пережёвывание сельдерея тратится почти столько же калорий, сколько в нём содержится -- почти ноль в остатке."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Жвакање целера сагорева готово исто толико калорија колико он садржи — скоро изравнато."
          }
        }
      }
    },
    "loadingBar.mealFact.9" : {
      "comment" : "Rotating food-trivia fact shown while a logged meal is estimated",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lauteres Kauen kann laut echten Studien tatsächlich dafür sorgen, dass Essen besser schmeckt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crunching your food louder can genuinely make it taste better, per actual studies."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Masticar tu comida más fuerte puede hacer que sepa mejor de verdad, según estudios reales."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selon de véritables études, croquer plus fort dans vos aliments peut réellement les rendre plus savoureux."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ուտելիքը ավելի բարձր ձայնով ծամելը իսկապես կարող է ավելի համեղ դարձնել այն, ինչպես ցույց են տալիս իրական հետազոտությունները."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Secondo studi reali, sgranocchiare il cibo più rumorosamente può farlo davvero sembrare più buono."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "საკვების ხმამაღლა ხრაშუნით ჭამა ნამდვილად აუმჯობესებს გემოს — ასე აჩვენებს კვლევები."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Более громкое хрустение едой действительно может сделать её вкуснее — так показывают исследования."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Гласније хрскање хране заиста може учинити да укус буде бољи, показују студије."
          }
        }
      }
    },
