    "activityAccordion.strain.text" : {
      "comment" : "Accordion explainer text for strain",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wie viel kardiovaskuläre und muskuläre Belastung dein Körper aufgenommen hat. Whoop bewertet dies von 0 bis 21; andere Quellen geben die Anzahl intensiverer Einheiten an. Anhaltend hohe Belastung ohne entsprechende Erholung ist genau das, was die heutigen Trainingsobergrenzen erkennen sollen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "How much cardiovascular and muscular load your body has taken on. Whoop scores this 0-21; other sources report the count of harder sessions. Consistently high strain without matching recovery is what today's training caps are designed to catch."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuánta carga cardiovascular y muscular ha asumido tu cuerpo. Whoop lo puntúa de 0 a 21; otras fuentes indican el número de sesiones más intensas. Un esfuerzo constantemente alto sin una recuperación equivalente es justo lo que los límites de entrenamiento de hoy están diseñados para detectar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La charge cardiovasculaire et musculaire que votre corps a supportée. Whoop la note de 0 à 21 ; d'autres sources indiquent le nombre de séances intenses. Un effort constamment élevé sans récupération équivalente est précisément ce que les plafonds d'entraînement du jour sont conçus pour détecter."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Որքան սրտանոթային և մկանային բեռնվածություն է կրել քո մարմինը։ Whoop-ը դա գնահատում է 0-21 սանդղակով; այլ աղբյուրներ ցույց են տալիս ինտենսիվ պարապմունքների քանակը։ Հենց մշտապես բարձր ծանրաբեռնվածությունը՝ առանց համապատասխան վերականգնման, է նախատեսված հայտնաբերել այսօրվա մարզման սահմանաչափերով։"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quanto carico cardiovascolare e muscolare ha sostenuto il tuo corpo. Whoop lo valuta da 0 a 21; altre fonti indicano il numero di sessioni più intense. Uno sforzo costantemente alto senza un recupero adeguato è proprio ciò che i limiti di allenamento di oggi sono pensati per individuare."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "რამდენი კარდიო და კუნთოვანი დატვირთვა მიიღო შენმა სხეულმა. Whoop ამას აფასებს 0-დან 21-მდე შკალით; სხვა წყაროები აჩვენებენ ინტენსიური სესიების რაოდენობას. სწორედ მუდმივად მაღალი დატვირთვის აღმოსაჩენად, შესაბამისი აღდგენის გარეშე, არის განკუთვნილი დღევანდელი ვარჯიშის ლიმიტები."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Насколько сильную кардио- и мышечную нагрузку получило твоё тело. Whoop оценивает это по шкале от 0 до 21; другие источники показывают количество интенсивных занятий. Именно постоянно высокую нагрузку без соответствующего восстановления призваны отслеживать сегодняшние лимиты тренировок."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Колико кардиоваскуларног и мишићног оптерећења је твоје тело поднело. Whoop ово оцењује на скали од 0 до 21; други извори приказују број напорнијих тренинга. Управо доследно високо напрезање без одговарајућег опоравка је оно што данашња ограничења тренинга треба да препознају."
          }
        }
      }
    },
