    "howSomaWorks.goalProgress.description" : {
      "comment" : "How Soma Works tour: card description for the goal progress feature",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Füge ein Foto des Körpers hinzu, auf den du hinarbeitest, und eines von deinem heutigen Stand. Soma baut deinen Plan darauf auf, diese echte Lücke zu schließen, und zeigt dir unterwegs echten Fortschritt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Add a photo of the body you're working toward and one of where you are today. Soma builds your plan around closing that real gap, and shows you real progress along the way."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade una foto del cuerpo al que aspiras y otra de cómo estás hoy. Soma construye tu plan en torno a cerrar esa brecha real y te muestra progreso real en el camino."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoutez une photo du corps que vous visez et une de votre état actuel. Soma construit votre plan autour de la réduction de cet écart réel, et vous montre une vraie progression en chemin."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ավելացրեք այն մարմնի լուսանկարը, որին ձգտում եք, և ձեր այսօրվա վիճակի լուսանկարը։ Soma-ն կառուցում է ձեր պլանը այդ իրական տարբերությունը փակելու շուրջ և ցույց է տալիս իրական առաջընթաց ճանապարհին։"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiungi una foto del corpo a cui aspiri e una di come sei oggi. Soma costruisce il tuo piano attorno a colmare quel divario reale e ti mostra progressi reali lungo il percorso."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "დაამატეთ სხეულის ფოტო, რომლისკენაც მიისწრაფვით, და დღევანდელი მდგომარეობის ფოტო. Soma აგებს თქვენს გეგმას ამ რეალური სხვაობის შესავსებად და გზაში გიჩვენებთ რეალურ პროგრესს."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Добавьте фото тела, к которому вы стремитесь, и фото своего текущего состояния. Soma строит план вокруг сокращения этого реального разрыва и показывает реальный прогресс на этом пути."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Додај фотографију тела ка коме тежиш и фотографију тога где си данас. Soma гради твој план око затварања те стварне разлике и показује ти стваран напредак успут."
          }
        }
      }
    },
