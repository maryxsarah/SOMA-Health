    "supabase.error.serviceUnavailable" : {
      "comment" : "Error shown when the server's AI generation backend itself is down or rate-limited",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der KI-Dienst von Soma ist vorübergehend nicht verfügbar. Wir wurden benachrichtigt – bitte versuche es später erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Soma's AI service is temporarily unavailable. We've been notified -- please try again later."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El servicio de IA de Soma no está disponible temporalmente. Ya nos han avisado; inténtalo de nuevo más tarde."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le service d'IA de Soma est temporairement indisponible. Nous avons été notifiés -- veuillez réessayer plus tard."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Soma-ի AI ծառայությունը ժամանակավորապես անհասանելի է: Մենք արդեն ծանուցում ենք ստացել -- փորձիր ավելի ուշ:"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il servizio IA di Soma non è temporaneamente disponibile. Siamo stati avvisati: riprova più tardi."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Soma-ს AI სერვისი დროებით მიუწვდომელია. ჩვენ უკვე მივიღეთ შეტყობინება -- სცადე მოგვიანებით."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сервис AI Soma временно недоступен. Мы уже получили уведомление -- попробуй позже."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Soma-ин AI сервис је тренутно недоступан. Обавештени смо — покушај поново касније."
          }
        }
      }
    },
