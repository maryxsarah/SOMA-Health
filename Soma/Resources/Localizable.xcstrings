      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquí el progreso son las sesiones hechas más tu propio seguimiento — sin números inventados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ici, la progression correspond aux séances effectuées et à votre propre bilan — aucun chiffre inventé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Qui il progresso è dato dalle sessioni fatte più il tuo check-in personale — nessun numero inventato."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fortschritt bedeutet hier absolvierte Einheiten plus dein eigenes Check-in — keine erfundenen Zahlen."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Прогресс здесь — это выполненные занятия плюс твоя собственная отметка, без выдуманных цифр."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "პროგრესი აქ არის შესრულებული სესიები პლუს შენი საკუთარი აღრიცხვა — გამოგონილი რიცხვების გარეშე."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Առաջընթացն այստեղ ավարտված պարապմունքներն են՝ գումարած քո սեփական նշումը — առանց հորինված թվերի:"
          }
        }
      }
    },
