    "recommendationReason.explanation.whoopHigh": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu recuperación de Whoop fue del %@%%, bien dentro del rango alto (67%%+); tu cuerpo está bien recuperado hoy."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre récupération Whoop était de %@%%, bien dans la zone élevée (67%%+) : votre corps est bien récupéré aujourd'hui."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo recupero Whoop era del %@%%, ben all'interno della fascia alta (67%%+): oggi il tuo corpo è ben recuperato."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Whoop-Erholung lag bei %@%%, deutlich im hohen Bereich (67%%+) – dein Körper ist heute gut erholt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your Whoop recovery was %@%%, well into the high range (67%%+) -- your body is well-recovered today."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Твоё восстановление по Whoop составило %@%%, уверенно в высоком диапазоне (67%%+) -- твоё тело сегодня хорошо восстановлено."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "შენი Whoop-ის აღდგენის მაჩვენებელი იყო %@%%, მაღალ დიაპაზონში (67%%+) -- დღეს შენი სხეული კარგად არის აღდგენილი."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Քո Whoop-ի վերականգնման ցուցանիշը եղել է %@%%, բարձր միջակայքում (67%%+) -- այսօր քո մարմինը լավ վերականգնված է."
          }
        }
      },
      "comment": "%@ = recovery percent number; %% is a literal percent sign"
    },
    "recommendationReason.explanation.whoopMedium": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu recuperación de Whoop fue del %@%%, en el rango medio (34-66%%); tu cuerpo tiene margen para trabajar, pero no está totalmente recargado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre récupération Whoop était de %@%%, dans la zone moyenne (34-66%%) : votre corps a une certaine marge, mais n'est pas totalement rechargé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo recupero Whoop era del %@%%, nella fascia media (34-66%%): il tuo corpo ha un certo margine per lavorare, ma non è del tutto ricaricato."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Whoop-Erholung lag bei %@%%, im mittleren Bereich (34-66%%) – dein Körper hat etwas Spielraum, ist aber nicht voll aufgeladen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your Whoop recovery was %@%%, in the medium range (34-66%%) -- your body has some room to work, but isn't fully topped up."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Твоё восстановление по Whoop составило %@%%, в среднем диапазоне (34-66%%) -- у твоего тела есть запас сил, но оно ещё не полностью восстановилось."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "შენი Whoop-ის აღდგენის მაჩვენებელი იყო %@%%, საშუალო დიაპაზონში (34-66%%) -- შენს სხეულს აქვს გარკვეული რესურსი, მაგრამ სრულად აღდგენილი არ არის."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Քո Whoop-ի վերականգնման ցուցանիշը եղել է %@%%, միջին միջակայքում (34-66%%) -- քո մարմինը դեռ որոշակի պաշար ունի, բայց ամբողջությամբ վերականգնված չէ."
          }
        }
      },
      "comment": "%@ = recovery percent number; %% is a literal percent sign"
    },
    "recommendationReason.explanation.whoopLow": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu recuperación de Whoop fue del %@%%, en el rango bajo (menos del 34%%); tu cuerpo está indicando que necesita descanso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre récupération Whoop était de %@%%, dans la zone basse (moins de 34%%) : votre corps signale qu'il a besoin de repos."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo recupero Whoop era del %@%%, nella fascia bassa (sotto il 34%%): il tuo corpo sta segnalando che ha bisogno di riposo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Whoop-Erholung lag bei %@%%, im niedrigen Bereich (unter 34%%) – dein Körper signalisiert, dass er Ruhe braucht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your Whoop recovery was %@%%, in the low range (under 34%%) -- your body is signaling it needs rest."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Твоё восстановление по Whoop составило %@%%, в низком диапазоне (менее 34%%) -- твоё тело сигнализирует, что ему нужен отдых."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "შენი Whoop-ის აღდგენის მაჩვენებელი იყო %@%%, დაბალ დიაპაზონში (34%%-ზე ნაკლები) -- შენი სხეული გატყობინებს, რომ დასვენება სჭირდება."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
