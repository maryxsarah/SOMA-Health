    "recommendationDetail.cap.sleep": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nota: la intensidad de hoy se limitó por falta de sueño, aunque la recuperación parecía buena."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Remarque : l'intensité d'aujourd'hui a été limitée en raison d'un sommeil insuffisant, même si votre récupération semblait bonne."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nota: l'intensità di oggi è stata limitata per il sonno insufficiente, anche se il recupero sembrava buono."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hinweis: Die heutige Intensität wurde wegen zu wenig Schlaf begrenzt, obwohl deine Erholung stark aussah."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Note: today's intensity was capped because of short sleep, even though recovery looked strong."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Примечание: сегодняшняя интенсивность была снижена из-за недостатка сна, хотя восстановление выглядело хорошим."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "შენიშვნა: დღევანდელი ინტენსივობა შემცირდა არასაკმარისი ძილის გამო, თუმცა აღდგენა კარგად გამოიყურებოდა."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Նշում. այսօրվա բեռնվածությունը սահմանափակվել է կարճատև քնի պատճառով, թեև վերականգնման ցուցանիշները լավ էին թվում։"
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Напомена: данашњи интензитет је ограничен због кратког сна, иако је опоравак деловао добро."
          }
        }
      },
      "comment": "Cap explanation shown in the Why-this disclosure when today's intensity was reduced due to short sleep"
    },
    "recommendationDetail.cap.hrv": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nota: la intensidad de hoy se limitó porque tu HRV está notablemente por debajo de tu valor de referencia habitual, aunque la recuperación parecía buena."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Remarque : l'intensité d'aujourd'hui a été limitée car votre HRV est nettement inférieure à votre référence habituelle, même si votre récupération semblait bonne."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nota: l'intensità di oggi è stata limitata perché il tuo HRV è notevolmente inferiore al tuo valore di riferimento abituale, anche se il recupero sembrava buono."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hinweis: Die heutige Intensität wurde begrenzt, weil dein HRV-Wert deutlich unter deinem üblichen Ausgangswert liegt, obwohl deine Erholung stark aussah."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Note: today's intensity was capped because your HRV is noticeably below your usual baseline, even though recovery looked strong."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Примечание: сегодняшняя интенсивность была снижена, потому что твой HRV заметно ниже обычного уровня, хотя восстановление выглядело хорошим."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "შენიშვნა: დღევანდელი ინტენსივობა შემცირდა, რადგან შენი HRV შესამჩნევად დაბალია ჩვეულებრივ დონეზე, თუმცა აღდგენა კარგად გამოიყურებოდა."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Նշում. այսօրվա բեռնվածությունը սահմանափակվել է, քանի որ քո HRV-ն նկատելիորեն ցածր է սովորականից, թեև վերականգնման ցուցանիշները լավ էին թվում։"
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
