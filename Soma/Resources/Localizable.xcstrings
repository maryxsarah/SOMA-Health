        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Վերադարձիր, երբ ևս մի քանի օրվա %@ գրառում կունենաս։"
          }
        }
      },
      "comment": "%@ is the lowercased metric name, e.g. 'hrv' or 'sleep'"
    },
    "What did you eat? e.g. \"2 eggs, toast, and coffee with milk\"": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Qué has comido? p. ej. \"2 huevos, tostada y café con leche\""
          }
        },
        "fr": {
