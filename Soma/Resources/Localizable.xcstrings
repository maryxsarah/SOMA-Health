          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ძილი"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Քուն"
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
