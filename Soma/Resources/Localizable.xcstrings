    "goalHub.baselineConfirmNote" : {
      "comment" : "Week-1 explainer card: user will be asked to confirm their baseline again in ~5 days",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bestätige deine Baseline in ~5 Tagen -- der zweite Versuch fällt meist besser aus. Der bessere der beiden wird dein Ausgangspunkt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Confirm your baseline in ~5 days — second attempts usually score higher. The better of the two becomes your starting point."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Confirma tu línea base en ~5 días: el segundo intento suele salir mejor. El mejor de los dos se convierte en tu punto de partida."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Confirmez votre référence dans ~5 jours -- le deuxième essai est généralement meilleur. Le meilleur des deux devient votre point de départ."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Հաստատեք ձեր բազային արժեքը ~5 օրից -- երկրորդ փորձն սովորաբար ավելի լավն է լինում։ Երկուսից լավագույնը կդառնա ձեր մեկնարկային կետը։"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conferma la tua baseline tra ~5 giorni -- il secondo tentativo di solito va meglio. Il migliore dei due diventa il tuo punto di partenza."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "დაადასტურეთ თქვენი საწყისი მაჩვენებელი ~5 დღეში -- მეორე მცდელობა ჩვეულებრივ უკეთესია. ორივედან უკეთესი გახდება თქვენი საწყისი წერტილი."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Подтвердите базовый результат примерно через 5 дней — вторая попытка обычно лучше. Лучший из двух станет вашей стартовой точкой."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Потврди своју почетну вредност за ~5 дана -- други покушај је обично бољи. Бољи од та два постаје твоја почетна тачка."
          }
        }
      }
    },
