    "recommendationDetail.stepTarget.withAverage": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Objetivo de pasos de hoy: %@; has promediado ~%lld al día durante la última semana."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Objectif de pas du jour : %@ — vous avez fait en moyenne environ %lld par jour au cours de la dernière semaine."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Obiettivo di passi di oggi: %@; hai fatto in media circa %lld al giorno nell'ultima settimana."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Heutiges Schrittziel: %@ – du hattest in der letzten Woche im Schnitt ca. %lld pro Tag."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Today's step target: %@ — you've averaged ~%lld/day over the last week."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Цель по шагам на сегодня: %@ — в среднем за последнюю неделю ты проходишь ~%lld в день."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "დღევანდელი ნაბიჯების მიზანი: %@ — ბოლო კვირის განმავლობაში საშუალოდ ~%lld ნაბიჯს დადიხარ დღეში."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Այսօրվա քայլերի նպատակը՝ %@ — վերջին շաբաթվա ընթացքում միջինում կատարել ես ~%lld քայլ/օր։"
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Данашњи циљ по корацима: %@ — твој просек за последњу недељу: ~%lld/дан."
          }
        }
      },
      "comment": "Step-target sentence in the Why-this disclosure, shown when a recent average step count is available. First placeholder is the target range (e.g. '7,000–9,000 steps'), second is the rounded daily average."
    },
