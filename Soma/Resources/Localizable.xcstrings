    "Take or choose a photo of your gym or workout space, and Soma will build a workout around the equipment it sees." : {
      "comment" : "Intro copy on the initial pick-photo screen",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mach oder wähle ein Foto von deinem Fitnessstudio oder Trainingsbereich, und Soma erstellt ein Workout passend zu den erkannten Geräten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toma o elige una foto de tu gimnasio o espacio de entrenamiento, y Soma creará un entrenamiento según el equipo que vea."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prenez ou choisissez une photo de votre salle de sport ou de votre espace d'entraînement, et Soma créera un entraînement adapté au matériel qu'il détecte."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Նկարիր կամ ընտրիր քո մարզասրահի կամ մարզման տարածքի լուսանկար, և Soma-ն կկառուցի մարզում այն սարքավորումների հիման վրա, որոնք կտեսնի։"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scatta o scegli una foto della tua palestra o del tuo spazio di allenamento e Soma creerà un allenamento in base all'attrezzatura che vede."
