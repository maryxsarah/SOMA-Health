    "mealRecommendation.error.generateFailed" : {
      "comment" : "Error shown when AI meal recommendation generation fails",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Daraus konnte nichts entstehen -- versuche es anders zu beschreiben oder es gleich noch einmal."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Couldn't come up with something from that -- try describing it differently, or try again in a moment."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo pensar en algo con eso -- intenta describirlo de otra forma, o vuelve a intentarlo en un momento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de trouver une idée avec ça -- essaie de le décrire différemment, ou réessaie dans un instant."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Չհաջողվեց ինչ-որ բան մտածել դրանից -- փորձիր այլ կերպ նկարագրել, կամ մի փոքր ուշ նորից փորձիր։"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non sono riuscito a pensare a qualcosa con questo -- prova a descriverlo diversamente, o riprova tra un momento."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ამისგან ვერაფერი მოვიფიქრეთ -- სცადე სხვაგვარად აღწერო, ან სცადე ისევ ცოტა ხანში."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не получилось ничего придумать из этого -- попробуй описать иначе или повтори попытку через момент."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Није успело да се смисли ништа од тога — покушај да то опишеш другачије, или покушај поново за тренутак."
          }
        }
      }
    },
