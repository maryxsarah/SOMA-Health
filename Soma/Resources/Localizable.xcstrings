    "editWidgets.intro" : {
      "comment" : "",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle aus, was auf der Startseite angezeigt wird. „Training protokollieren“ ist immer da."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toggle what shows on home. Log workout is always there."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activa o desactiva lo que se muestra en Inicio. Registrar entrenamiento siempre está ahí."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisis ce qui s'affiche sur l'accueil. Enregistrer une séance est toujours présent."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Միացրու/անջատիր, թե ինչն է ցուցադրվում Տնային էջում։ Մարզումը գրանցելը միշտ այնտեղ է։"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Attiva o disattiva ciò che appare nella Home. Registra allenamento è sempre presente."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ჩართე/გამორთე რა გამოჩნდეს მთავარ გვერდზე. ვარჯიშის ჩაწერა ყოველთვის იქ არის."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Включай и выключай то, что показывается на главном экране. «Записать тренировку» всегда там."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Укључи/искључи шта се приказује на почетној. Забележи тренинг је увек ту."
          }
        }
      }
    },
