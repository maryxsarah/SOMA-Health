        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "შენი HRV მაჩვენებელი მნიშვნელოვნად დაბალი იყო შენს ჩვეულ დონეზე, ან ძილი ხანმოკლე იყო -- დღეს შენს სხეულს დატვირთვის შემცირება სჭირდება."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Քո HRV ցուցանիշը զգալիորեն ցածր էր քո սովորական մակարդակից, կամ քունը կարճ էր -- այսօր քո մարմնին անհրաժեշտ է թեթևացնել ծանրաբեռնվածությունը."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
