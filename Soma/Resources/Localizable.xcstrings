    "loadingBar.mealFact.0" : {
      "comment" : "Rotating food-trivia fact shown while a logged meal is estimated",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Honig verdirbt nie -- Archäologen haben 3.000 Jahre alten Honig gefunden, der noch essbar ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Honey never spoils -- archaeologists have found 3,000-year-old honey that's still edible."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La miel nunca caduca: los arqueólogos han encontrado miel de 3000 años que todavía se puede comer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le miel ne se périme jamais : des archéologues ont retrouvé du miel vieux de 3 000 ans encore comestible."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Մեղրը երբեք չի փչանում -- հնագետները գտել են 3000-ամյա մեղր, որը դեռ ուտելի է."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il miele non scade mai: gli archeologi hanno trovato miele di 3.000 anni ancora commestibile."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "თაფლი არასდროს ფუჭდება -- არქეოლოგებმა იპოვეს 3000 წლის თაფლი, რომელიც დღემდე საჭმელად ვარგისია."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Мёд никогда не портится -- археологи находили мёд возрастом 3000 лет, который всё ещё пригоден в пищу."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Мед се никада не квари — археолози су пронашли мед стар 3.000 година који је још увек јестив."
          }
        }
      }
    },
    "loadingBar.mealFact.1" : {
      "comment" : "Rotating food-trivia fact shown while a logged meal is estimated",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bananen sind Beeren. Erdbeeren sind botanisch gesehen keine."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bananas are berries. Strawberries, botanically, are not."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los plátanos son bayas. Las fresas, botánicamente, no lo son."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les bananes sont des baies. Les fraises, botaniquement, n'en sont pas."
