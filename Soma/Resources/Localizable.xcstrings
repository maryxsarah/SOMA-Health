    "sportGoal.scheduleFrequency.readinessNote" : {
      "comment" : "Schedule frequency picker: reassuring note that low-readiness days still shift placement",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sessions richten sich weiterhin nach deiner Bereitschaft — an schwachen Tagen verschieben sie sich, das Workout selbst wird nie umgeschrieben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sessions still defer to your readiness for placement — low days shift, the workout itself is never rewritten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las sesiones siguen ajustándose a tu preparación para su ubicación — en días bajos se desplazan, el entrenamiento en sí nunca se reescribe."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les séances continuent de s'adapter à ta disponibilité physique pour leur placement — les jours faibles, elles se déplacent, mais l'entraînement lui-même n'est jamais réécrit."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Պարապմունքները դեռ հաշվի են առնում պատրաստակամությունդ տեղաբաշխման համար — ցածր օրերին դրանք տեղափոխվում են, բայց մարզումն ինքնին երբեք չի վերագրվում։"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le sessioni continuano ad adattarsi alla tua prontezza per il posizionamento — nei giorni bassi si spostano, l'allenamento stesso non viene mai riscritto."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "სესიები კვლავ ითვალისწინებს შენს მზადყოფნას განთავსებისას — დაბალ დღეებში ისინი გადაინაცვლებს, ხოლო ვარჯიში თავად არასდროს იწერება ხელახლა."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тренировки по-прежнему подстраиваются под твою готовность — в дни с низкой готовностью они сдвигаются, но сама тренировка никогда не переписывается."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тренинзи и даље зависе од твоје спремности за распоред — лошијих дана се померају, а сам тренинг се никад не преписује."
          }
        }
      }
    },
