    "nutrition.mealIdea.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What can I make?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Qué puedo cocinar?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Qu'est-ce que je peux cuisiner ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cosa posso cucinare?"
          }
        },
        "de": {
          "stringUnit": {
