    "loadingBar.goalProgress.0": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vas por buen camino para alcanzar tu objetivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous êtes sur la bonne voie pour atteindre votre objectif."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sei sulla buona strada per raggiungere il tuo obiettivo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du bist auf dem richtigen Weg, dein Ziel zu erreichen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You're on track to reach your goal."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ты на верном пути к своей цели."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "შენ სწორ გზაზე ხარ მიზნისკენ."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Դու ճիշտ ուղու վրա ես դեպի քո նպատակը:"
          }
        }
      },
      "comment": "Rotating motivational message shown while a goal-progress estimate loads"
    },
    "loadingBar.goalProgress.1": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada día que te comprometes es un día que ganas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque jour où vous vous engagez est un jour gagné."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni giorno in cui ti impegni è un giorno che vinci."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeder Tag, an dem du dranbleibst, ist ein gewonnener Tag."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every day you commit is a day you win."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Каждый день, когда ты не сдаёшься, — это твоя победа."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ყოველი დღე, როცა თავს არ ანებებ, გამარჯვების დღეა."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ամեն օր, երբ չես հանձնվում, հաղթանակի օր է:"
          }
        }
      },
      "comment": "Rotating motivational message shown while a goal-progress estimate loads"
    },
    "loadingBar.goalProgress.2": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La constancia vence a la perfección."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La régularité l'emporte sur la perfection."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La costanza batte la perfezione."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beständigkeit schlägt Perfektion."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Consistency beats perfection."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Постоянство важнее совершенства."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "თანმიმდევრობა სჯობს სრულყოფას."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Հետևողականությունը գերազանցում է կատարելությանը:"
          }
        }
      },
      "comment": "Rotating motivational message shown while a goal-progress estimate loads"
    },
    "loadingBar.goalProgress.3": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pequeños pasos, progreso real."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Petits pas, progrès réels."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Piccoli passi, progressi reali."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kleine Schritte, echter Fortschritt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Small steps, real progress."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Маленькие шаги — настоящий прогресс."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "მცირე ნაბიჯები — რეალური პროგრესი."
          }
        },
        "hy": {
          "stringUnit": {
