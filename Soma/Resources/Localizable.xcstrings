    "profile.injuries.severityWarning" : {
      "comment" : "Warning shown for moderate/severe injuries",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Angesichts des von dir gewählten Schweregrads solltest du einen Arzt oder Physiotherapeuten aufsuchen, bevor du dieses Gebiet weiter trainierst. Somas Hinweise hier sind rein informativ und keine Diagnose."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Given the severity you've selected, consider seeing a physician or physiotherapist before continuing to train this area. Soma's guidance here is informational only, not a diagnosis."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dada la gravedad que has seleccionado, considera consultar a un médico o fisioterapeuta antes de seguir entrenando esta zona. La orientación de Soma aquí es solo informativa, no un diagnóstico."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compte tenu de la gravité que tu as sélectionnée, envisage de consulter un médecin ou un kinésithérapeute avant de continuer à entraîner cette zone. Les indications de Soma ici sont purement informatives, pas un diagnostic."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Հաշվի առնելով ընտրված ծանրությունը՝ մտածեք բժշկի կամ ֆիզիոթերապևտի այցելության մասին՝ նախքան այս հատվածը մարզելը շարունակելը։ Soma-ի ուղեցույցն այստեղ միայն տեղեկատվական է, ոչ թե ախտորոշում։"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Data la gravità selezionata, valuta di consultare un medico o un fisioterapista prima di continuare ad allenare questa zona. Le indicazioni di Soma qui sono solo informative, non una diagnosi."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "შერჩეული სიმძიმის გათვალისწინებით, განიხილეთ ექიმთან ან ფიზიოთერაპევტთან ვიზიტი, სანამ ამ არეს ვარჯიშს განაგრძობთ. Soma-ს მითითება აქ მხოლოდ საინფორმაციოა და არა დიაგნოზი."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "С учётом выбранной степени тяжести стоит обратиться к врачу или физиотерапевту, прежде чем продолжать тренировать эту зону. Рекомендации Soma здесь носят исключительно информационный характер и не являются диагнозом."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "С обзиром на изабрану озбиљност, размисли о посети лекару или физиотерапеуту пре него што наставиш да тренираш ово подручје. Soma-ине смернице овде су само информативне, а не дијагноза."
          }
        }
      }
    },
