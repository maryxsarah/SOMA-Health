    "goalPicker.customTask.footnote" : {
      "comment" : "",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hast du eine Aufgabe von deinem Coach? Füge sie hier hinzu — erledige die Arbeit in Soma und zeig ihm deinen Fortschritt: Sessions und Messungen werden als eine Karte exportiert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Got a task from your coach? Add it here — do the work in Soma and show them your progress: sessions and measurements export as one card."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Tienes una tarea de tu entrenador? Añádela aquí — haz el trabajo en Soma y muéstrale tu progreso: las sesiones y mediciones se exportan como una sola tarjeta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu as une tâche de ton coach ? Ajoute-la ici — fais le travail dans Soma et montre-lui tes progrès : séances et mesures s'exportent en une seule carte."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ունե՞ք առաջադրանք ձեր մարզչից։ Ավելացրեք այն այստեղ — կատարեք աշխատանքը Soma-ում և ցույց տվեք նրան ձեր առաջընթացը. պարապմունքները և չափումները արտահանվում են մեկ քարտով։"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hai un compito dal tuo coach? Aggiungilo qui — svolgi il lavoro in Soma e mostragli i tuoi progressi: sessioni e misurazioni si esportano come un'unica scheda."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "გაქვთ დავალება მწვრთნელისგან? დაამატეთ აქ — შეასრულეთ სამუშაო Soma-ში და აჩვენეთ პროგრესი: სესიები და გაზომვები გადის ერთ ბარათად."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Есть задание от тренера? Добавьте его здесь — выполняйте его в Soma и показывайте тренеру прогресс: тренировки и измерения экспортируются одной карточкой."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Имаш задатак од тренера? Додај га овде — ради у Soma-и и покажи му напредак: тренинзи и мерења се извозе као једна картица."
          }
        }
      }
    },
    "goalPicker.customTask.note" : {
      "comment" : "Goal picker: note under the custom coach's-task block",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Füge die Aufgabe deines Trainers hinzu — Soma plant und verfolgt sie"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Attach your coach's assignment — Soma schedules and tracks it"
