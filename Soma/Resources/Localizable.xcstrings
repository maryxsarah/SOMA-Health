    "dailyChecklist.onboarding.kitchenEquipment.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "So meal ideas only ever use what you actually have."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Así las ideas de comidas solo usan lo que realmente tienes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainsi, les idées de repas n'utilisent que ce que tu as vraiment."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Così le idee per i pasti usano solo ciò che hai davvero."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "So verwenden Essensideen nur, was du wirklich hast."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Так идеи блюд используют только то, что у тебя действительно есть."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ასე კერძების იდეები მხოლოდ იმას იყენებს, რაც შენ ნამდვილად გაქვს."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Այսպես ուտեստների գաղափարներն օգտագործում են միայն այն, ինչ դու իրականում ունես։"
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Тако идеје за оброке користе само оно што заиста имаш."
          }
        }
      },
      "comment": "Onboarding checklist item subtitle"
    },
