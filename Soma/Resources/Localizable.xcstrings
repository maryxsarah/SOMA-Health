        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Առավելագույն թեստը հյուծված օրը թերագնահատում է քեզ։ Այն կբացվի քո հաջորդ չափավոր կամ ավելի լավ օրը։"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un test massimale in una giornata di scarico ti sottostima. Si aprirà nella tua prossima giornata moderata o migliore."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "მაქსიმალური ტესტი დაცლილ დღეს შენს შედეგს დააბალებს. ის გაიხსნება შენს მომდევნო საშუალო ან უკეთეს დღეს."
