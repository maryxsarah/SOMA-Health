    "onboarding.signUpConsent.termsText" : {
      "comment" : "",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ich stimme den Nutzungsbedingungen und der Datenschutzrichtlinie von Soma zu und verstehe, dass Somas Empfehlungen keine medizinische Beratung sind."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I agree to Soma's Terms of Service and Privacy Policy, and understand Soma's recommendations are not medical advice."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acepto los Términos de servicio y la Política de privacidad de Soma, y entiendo que las recomendaciones de Soma no son un consejo médico."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "J'accepte les Conditions d'utilisation et la Politique de confidentialité de Soma, et je comprends que les recommandations de Soma ne constituent pas un avis médical."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ես համաձայն եմ Soma-ի Ծառայության պայմաններին և Գաղտնիության քաղաքականությանը և հասկանում եմ, որ Soma-ի առաջարկությունները բժշկական խորհրդատվություն չեն։"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accetto i Termini di servizio e l'Informativa sulla privacy di Soma, e comprendo che i consigli di Soma non costituiscono un parere medico."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ვეთანხმები Soma-ს მომსახურების პირობებსა და კონფიდენციალურობის პოლიტიკას და მესმის, რომ Soma-ს რეკომენდაციები არ წარმოადგენს სამედიცინო რჩევას."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Я принимаю Условия использования и Политику конфиденциальности Soma и понимаю, что рекомендации Soma не являются медицинской консультацией."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Прихватам Услове коришћења и Политику приватности Soma-е и разумем да Soma-ине препоруке нису медицински савет."
          }
        }
      }
    },
