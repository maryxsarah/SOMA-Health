            "value": "HRV"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "HRV"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "HRV"
          }
        },
        "hy": {
          "stringUnit": {
