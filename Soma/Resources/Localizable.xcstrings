    "Get your daily plan in seconds, tailored to your health. Follow your plan, and see your progress add up.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Obtén tu plan diario en segundos, adaptado a tu salud. Sigue tu plan y observa cómo se acumula tu progreso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Obtenez votre plan quotidien en quelques secondes, adapté à votre santé. Suivez votre plan et regardez vos progrès s'accumuler."
          }
