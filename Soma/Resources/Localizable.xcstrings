    "sportGoalOnboarding.slide4.sub" : {
      "comment" : "Sport-goal onboarding gallery slide 4 subtitle",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Füge die Aufgabe als Foto oder Text hinzu, erledige sie in Soma und zeig deinem Coach den Fortschritt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Attach the assignment as photo or text, do the work in Soma, show your coach the progress."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adjunta la tarea como foto o texto, haz el trabajo en Soma y muéstrale a tu entrenador el progreso."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Joins la tâche en photo ou en texte, fais le travail dans Soma, montre les progrès à ton coach."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Կցիր առաջադրանքը որպես լուսանկար կամ տեքստ, կատարիր աշխատանքը Soma-ում, ցույց տուր առաջընթացը մարզչիդ։"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allega il compito come foto o testo, svolgi il lavoro in Soma, mostra i progressi al tuo coach."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "დაურთე დავალება ფოტოს ან ტექსტის სახით, შეასრულე სამუშაო Soma-ში, აჩვენე პროგრესი შენს მწვრთნელს."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Прикрепи задание в виде фото или текста, выполняй его в Soma и показывай тренеру прогресс."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Приложи задатак као фотографију или текст, ради у Soma-и, покажи тренеру напредак."
          }
        }
      }
    },
