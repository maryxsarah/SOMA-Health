    "aiWorkoutPlan.weightsAndRPEFootnote" : {
      "comment" : "Combined footnote under the workout plan: reassures weight suggestions adapt, then defines RPE, in one sentence",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Gewichte starten vorsichtig — Soma passt sich an das an, was du tatsächlich hebst. RPE = wie hart sich ein Satz anfühlt, 1 leicht · 10 maximal."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Weights start conservative — Soma adjusts from what you actually lift. RPE = how hard a set feels, 1 easy · 10 max."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los pesos comienzan de forma conservadora — Soma se ajusta según lo que realmente levantas. RPE = lo duro que se siente una serie, 1 fácil · 10 máximo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les poids commencent prudemment — Soma s'ajuste en fonction de ce que vous soulevez réellement. RPE = à quel point une série est difficile, 1 facile · 10 maximal."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Քաշերը սկսվում են զգուշավոր — Soma-ն հարմարվում է քո իրական բարձրացրած քաշին: RPE = որքան ծանր է զգացվում սեթը, 1 հեշտ · 10 առավելագույն։"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I pesi partono in modo prudente — Soma si adatta in base a ciò che sollevi realmente. RPE = quanto è impegnativa una serie, 1 facile · 10 massimo."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "წონები იწყება ფრთხილად — Soma ეგუება იმას, რასაც შენ რეალურად წევ. RPE = რამდენად რთულად იგრძნობა სეტი, 1 იოლი · 10 მაქსიმალური."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Веса начинаются осторожно — Soma подстраивается под то, что ты реально поднимаешь. RPE = насколько тяжёлым ощущается подход, 1 легко · 10 максимум."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тежине почињу опрезно — Soma се прилагођава ономе што заиста дижеш. RPE = колико тешка делује серија, 1 лако · 10 максимално."
          }
        }
      }
    },
