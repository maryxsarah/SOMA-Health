    "goalHub.retest.deferred.message" : {
      "comment" : "Explanation shown when a max-effort re-test is deferred because readiness is too low",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Maximaltest an einem erschöpften Tag unterschätzt dich. Er öffnet sich wieder an deinem nächsten moderaten oder besseren Tag."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A max test on a depleted day under-reads you. It'll open on your next moderate or better day."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una prueba máxima en un día agotado te subestima. Se abrirá de nuevo en tu próximo día moderado o mejor."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un test maximal un jour épuisé vous sous-évalue. Il s'ouvrira lors de votre prochain jour modéré ou meilleur."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Առավելագույն թեստը հյուծված օրը թերագնահատում է ձեզ։ Այն նորից կբացվի ձեր հաջորդ չափավոր կամ ավելի լավ օրը։"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un test massimale in una giornata svuotata ti sottostima. Si sbloccherà nella tua prossima giornata moderata o migliore."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "მაქსიმალური ტესტი დაქვეითებულ დღეს არასწორად აფასებს თქვენ. ის ხელახლა გაიხსნება თქვენს შემდეგ ზომიერ ან უკეთეს დღეს."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Максимальный тест в истощённый день занизит результат. Он снова откроется в ваш следующий умеренный или лучший день."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Максимални тест у исцрпљеном дану те потцењује. Отвориће се поново твог следећег умереног или бољег дана."
          }
        }
      }
    },
    "goalHub.retest.deferred.title" : {
