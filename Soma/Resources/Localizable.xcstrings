    "recommendationDetail.requestedRest": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoy pediste un día de descanso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous avez demandé un jour de repos aujourd'hui."
