    "recommendationDetail.cap.injuryProtocolRest" : {
      "comment" : "Cap explanation shown in the Why-this disclosure when today is a full rest day due to a severe injury recovery protocol",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hinweis: Heute ist ein vollständiger Ruhetag wegen einer kürzlich gemeldeten schweren Verletzung, oder weil sie sich verschlechtert hat -- deine Sicherheit geht hier vor Intensität."
