    "sportGoalFlow.unavailable.loadFailed": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo cargar el catálogo de objetivos. Desliza hacia abajo para volver a intentarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de charger le catalogue d'objectifs. Tirez vers le bas pour réessayer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile caricare il catalogo degli obiettivi. Trascina verso il basso per riprovare."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Zielkatalog konnte nicht geladen werden. Nach unten ziehen, um es erneut zu versuchen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't load the goal catalog. Pull down to try again."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось загрузить каталог целей. Потяни вниз, чтобы повторить."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "მიზნების კატალოგის ჩატვირთვა ვერ მოხერხდა. სცადე ისევ, ჩამოწიე ეკრანი."
          }
        },
        "hy": {
          "stringUnit": {
