          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подключение Whoop или Oura даёт более точную оценку восстановления, чем только Apple Health."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "Whoop-ის ან Oura-ს დაკავშირება უფრო ზუსტ აღდგენის მაჩვენებელს იძლევა, ვიდრე მხოლოდ Apple Health."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Whoop-ի կամ Oura-ի միացումը ավելի ճշգրիտ վերականգնման գնահատական է տալիս, քան միայն Apple Health-ը."
          }
        }
      },
      "comment": "Tomorrow tip fallback for unrecognized server reason codes; no placeholders"
    },
    "dataConfidence.caveat.low": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La lectura de hoy se basa en datos limitados: Apple Health no registró mucha información. Usar tu reloj por la noche, o conectar Whoop u Oura, hace esto más preciso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La lecture d'aujourd'hui repose sur des données limitées : Apple Santé n'a pas enregistré grand-chose. Porter votre montre la nuit, ou connecter Whoop ou Oura, rend cela plus précis."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La lettura di oggi si basa su dati limitati: Apple Salute non ha registrato molto su cui basarsi. Indossare l'orologio di notte, o collegare Whoop od Oura, rende tutto più preciso."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die heutige Auswertung basiert auf begrenzten Daten – Apple Health hat nicht viel aufgezeichnet. Wenn du deine Uhr nachts trägst oder Whoop bzw. Oura verbindest, wird dies genauer."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Today's read is based on limited data — Apple Health didn't record much to go on. Wearing your watch overnight, or connecting Whoop or Oura, makes this more precise."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сегодняшняя оценка основана на ограниченных данных — Apple Health записал немного информации. Ношение часов ночью или подключение Whoop или Oura сделает её точнее."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "დღევანდელი შეფასება შეზღუდულ მონაცემებზეა დაფუძნებული — Apple Health-მა ცოტა რამ ჩაწერა. საათის ღამით ტარება ან Whoop-ის ან Oura-ს დაკავშირება უფრო ზუსტს გახდის მას."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Այսօրվա գնահատականը հիմնված է սահմանափակ տվյալների վրա — Apple Health-ը քիչ բան է գրանցել. Ժամացույցը գիշերը կրելը կամ Whoop-ի կամ Oura-ի միացումը այն ավելի ճշգրիտ կդարձնի."
          }
        }
      },
      "comment": "Caveat shown under the explanation when confidence in today's read is low; no placeholders"
    },
