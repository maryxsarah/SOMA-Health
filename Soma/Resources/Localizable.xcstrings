    "Overrides your device's language just for Soma": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Anula el idioma de tu dispositivo solo para Soma"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Remplace la langue de votre appareil uniquement pour Soma"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sostituisce la lingua del dispositivo solo per Soma"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Überschreibt die Gerätesprache nur für Soma"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Переопределяет язык устройства только для Soma"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ცვლის შენი მოწყობილობის ენას მხოლოდ Soma-სთვის"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Փոխարինում է քո սարքի լեզուն միայն Soma-ի համար"
          }
        }
      },
      "comment": "Language settings row consequence text"
    },
    "Most of Soma updates immediately; the rest applies next time you open the app.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La mayor parte de Soma se actualiza al instante; el resto se aplica la próxima vez que abras la app."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La majeure partie de Soma se met à jour immédiatement ; le reste s'applique la prochaine fois que vous ouvrez l'application."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La maggior parte di Soma si aggiorna subito; il resto si applica la prossima volta che apri l'app."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Großteil von Soma aktualisiert sich sofort; der Rest wird beim nächsten Öffnen der App angewendet."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Большая часть Soma обновляется сразу; остальное применится при следующем открытии приложения."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "Soma-ს ნაწილი მაშინვე განახლდება; დანარჩენი ამოქმედდება აპლიკაციის შემდეგი გახსნისას."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Soma-ի մեծ մասը թարմացվում է անմիջապես, մնացածը կկիրառվի հավելվածի հաջորդ բացման ժամանակ:"
          }
        }
      },
      "comment": "Language picker helper text explaining the immediate-vs-next-launch behavior"
    },
