        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nota: hoy es un día de descanso completo debido a una lesión grave que reportaste recientemente, o que ha ido empeorando -- tu seguridad va antes que la intensidad aquí."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Remarque : aujourd'hui est un jour de repos complet en raison d'une blessure grave que tu as signalée récemment, ou qui s'est aggravée -- ta sécurité passe avant l'intensité ici."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Նշում. այսօր լրիվ հանգստյան օր է, քանի որ վերջերս հայտնել ես ծանր վնասվածքի մասին, կամ այն վատացել է -- այստեղ քո անվտանգությունը գերակայում է ինտենսիվությանը։"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nota: oggi è un giorno di riposo completo a causa di un infortunio grave segnalato di recente, o che sta peggiorando -- qui la tua sicurezza viene prima dell'intensità."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "შენიშვნა: დღეს სრული დასვენების დღეა იმის გამო, რომ ცოტა ხნის წინ მძიმე ტრავმის შესახებ მოგვახსენე, ან მდგომარეობა უარესდება -- აქ შენი უსაფრთხოება ინტენსივობაზე მნიშვნელოვანია."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
