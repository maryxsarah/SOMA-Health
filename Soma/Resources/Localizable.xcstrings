    "signIn.generic.error.somethingWrong": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Something went wrong. Please try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Algo salió mal. Inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une erreur s'est produite. Réessaie."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Qualcosa è andato storto. Riprova."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Etwas ist schiefgelaufen. Bitte versuche es erneut."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Что-то пошло не так. Попробуй снова."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "რაღაც შეცდომა მოხდა. სცადე ხელახლა."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ինչ-որ բան այն չէր։ Նորից փորձիր։"
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Нешто није у реду. Покушај поново."
          }
        }
      },
      "comment": "Generic sign-in/sign-up error shown when the underlying error isn't a recognized Supabase request failure"
    },
    "signIn.generic.error.accountExists": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An account with that email already exists -- try logging in instead."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya existe una cuenta con ese correo -- intenta iniciar sesión en su lugar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un compte existe déjà avec cet e-mail -- essaie plutôt de te connecter."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Esiste già un account con questa email -- prova invece ad accedere."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für diese E-Mail-Adresse existiert bereits ein Konto -- versuche stattdessen, dich anzumelden."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Аккаунт с этой почтой уже существует -- попробуй войти вместо регистрации."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ამ ელფოსტით ანგარიში უკვე არსებობს -- სცადე შესვლა ამის ნაცვლად."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Այդ էլ. հասցեով հաշիվն արդեն գոյություն ունի -- փոխարենը փորձիր մուտք գործել։"
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Налог са том имејл адресом већ постоји — уместо тога, покушај да се пријавиш."
          }
        }
      },
      "comment": "Sign-up error shown when the email is already registered"
    },
    "signIn.generic.error.invalidCredentials": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That email or password isn't right. Try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ese correo o contraseña no es correcto. Inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet e-mail ou ce mot de passe est incorrect. Réessaie."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa email o password non è corretta. Riprova."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese E-Mail-Adresse oder dieses Passwort ist nicht korrekt. Versuche es erneut."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Неверная почта или пароль. Попробуй снова."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ეს ელფოსტა ან პაროლი არასწორია. სცადე ხელახლა."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Այդ էլ. հասցեն կամ գաղտնաբառը սխալ է։ Նորից փորձիր։"
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Тај имејл или лозинка нису тачни. Покушај поново."
          }
        }
      },
      "comment": "Sign-in error shown when the email/password combination is wrong"
    },
    "signIn.generic.error.passwordRequirements": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That password doesn't meet the requirements -- try a longer one."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esa contraseña no cumple los requisitos -- prueba con una más larga."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce mot de passe ne répond pas aux critères -- essaie un mot de passe plus long."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa password non soddisfa i requisiti -- prova con una più lunga."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Passwort erfüllt die Anforderungen nicht -- versuche ein längeres."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот пароль не соответствует требованиям -- попробуй придумать длиннее."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ეს პაროლი არ აკმაყოფილებს მოთხოვნებს -- სცადე უფრო გრძელი."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Այդ գաղտնաբառը չի համապատասխանում պահանջներին -- փորձիր ավելի երկարը։"
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Та лозинка не испуњава услове — покушај дужу."
          }
        }
      },
      "comment": "Sign-up error shown when the password fails Supabase's own validation"
    },
    "signIn.generic.error.fallback": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't complete that. Please try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo completar eso. Inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de terminer cette action. Réessaie."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile completare l'operazione. Riprova."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das konnte nicht abgeschlossen werden. Bitte versuche es erneut."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось это выполнить. Попробуй снова."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ვერ შესრულდა. სცადე ხელახლა."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Չհաջողվեց ավարտել դա։ Նորից փորձիր։"
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Није могуће завршити ту радњу. Покушај поново."
          }
        }
      },
      "comment": "Fallback sign-in/sign-up error for any other recognized Supabase request failure"
    },
    "aiExercise.restLabel.none": {
