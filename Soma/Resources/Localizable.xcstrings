    "bodySection.bmi.explainer" : {
      "comment" : "Explainer text under the BMI value clarifying what it does and doesn't measure",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein allgemeines Screening-Maß für die Bevölkerung, kein Fitness- oder Körperzusammensetzungswert -- es unterscheidet nicht zwischen Muskeln und Fett."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A general population screening measure, not a fitness or body-composition score -- it doesn't distinguish muscle from fat."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una medida de detección poblacional general, no una puntuación de forma física o composición corporal -- no distingue entre músculo y grasa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une mesure de dépistage générale pour la population, pas un score de forme physique ou de composition corporelle -- elle ne distingue pas le muscle de la graisse."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Սա բնակչության ընդհանուր զննման ցուցանիշ է, ոչ թե ֆիթնեսի կամ մարմնի կազմի գնահատական -- այն չի տարբերակում մկանը ճարպից։"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una misura di screening generale della popolazione, non un punteggio di forma fisica o composizione corporea -- non distingue il muscolo dal grasso."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ეს არის ზოგადი სკრინინგის მაჩვენებელი მოსახლეობისთვის და არა ფიტნესის ან სხეულის შემადგენლობის შეფასება -- ის არ განასხვავებს კუნთს ცხიმისგან."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Это общий показатель для скрининга населения, а не оценка физической формы или состава тела -- он не различает мышцы и жир."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Општи показатељ за скрининг популације, а не оцена физичке форме или састава тела — не прави разлику између мишића и масти."
          }
        }
      }
    },
