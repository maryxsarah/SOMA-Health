    "home.customTraining.comingSoonBody" : {
      "comment" : "",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Individuelles Training nach Sportart kommt bald — Soma erstellt hier sportartspezifische Einheiten. Bis dahin passt sich Somas Auswahl weiterhin an deine heutige Bereitschaft an."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Custom training by sport type is coming soon — Soma will build sport-specific sessions here. For now, Soma's pick still adapts to today's readiness."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El entrenamiento personalizado por tipo de deporte llegará pronto — Soma creará aquí sesiones específicas para tu deporte. Por ahora, la selección de Soma sigue adaptándose a tu preparación de hoy."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'entraînement personnalisé par type de sport arrive bientôt — Soma créera ici des séances spécifiques à ton sport. Pour l'instant, la sélection de Soma s'adapte toujours à ta forme du jour."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Սպորտի տեսակով հարմարեցված մարզումը շուտով կլինի — Soma-ն այստեղ կկառուցի սպորտին հատուկ պարապմունքներ։ Առայժմ Sooma-ի ընտրությունը դեռ հարմարվում է այսօրվա պատրաստակամությանը։"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'allenamento personalizzato per tipo di sport arriverà presto — Soma creerà qui sessioni specifiche per il tuo sport. Per ora, la scelta di Soma continua ad adattarsi alla tua prontezza di oggi."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "სპორტის სახეობის მიხედვით საკუთარი ვარჯიში მალე დაემატება — Soma აქ შექმნის სპორტისთვის სპეციფიკურ სესიებს. ამჟამად Soma-ს არჩევანი კვლავ ეგუება დღევანდელ მზადყოფნას."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Свои тренировки по виду спорта скоро появятся — Soma будет создавать здесь занятия под конкретный вид спорта. Пока что выбор Soma по-прежнему подстраивается под сегодняшнюю готовность."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Прилагођен тренинг по врсти спорта стиже ускоро — Soma ће овде правити тренинге специфичне за спорт. За сада, Soma-ин избор и даље се прилагођава данашњој спремности."
          }
        }
      }
    },
