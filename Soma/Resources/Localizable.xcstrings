        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una prueba máxima en un día agotado te subestima. Se abrirá en tu próximo día moderado o mejor."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un test maximal un jour de fatigue vous sous-estime. Il s'ouvrira lors de votre prochain jour modéré ou meilleur."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Առավելագույն թեստը հյուծված օրը թերագնահատում է քեզ։ Այն կբացվի քո հաջորդ չափավոր կամ ավելի լավ օրը։"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un test massimale in una giornata di scarico ti sottostima. Si aprirà nella tua prossima giornata moderata o migliore."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "მაქსიმალური ტესტი დაცლილ დღეს შენს შედეგს დააბალებს. ის გაიხსნება შენს მომდევნო საშუალო ან უკეთეს დღეს."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Максимальный тест в истощённый день занизит результат. Он откроется в твой следующий умеренный или лучший день."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
