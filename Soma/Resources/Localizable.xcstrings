    "This helps us personalize your experience.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto nos ayuda a personalizar tu experiencia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela nous aide à personnaliser votre expérience."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo ci aiuta a personalizzare la tua esperienza."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das hilft uns, deine Erfahrung zu personalisieren."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это поможет нам персонализировать твой опыт."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ეს დაგეხმარება გამოცდილების პერსონალიზებაში."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Սա կօգնի մեզ անհատականացնել քո փորձառությունը."
          }
        }
      }
    },
