    "onboardingCharts.trajectory.setGoalWeightPrompt" : {
      "comment" : "Shown under the current weight reading when no goal weight has been set yet",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
