        }
      }
    },
    "Prioritizes which workouts are suggested first": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Prioriza qué entrenamientos se sugieren primero"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Détermine quels entraînements sont suggérés en priorité"
