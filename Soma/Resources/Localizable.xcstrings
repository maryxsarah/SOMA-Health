    "logMeal.estimateFailed" : {
      "comment" : "Error shown when AI meal estimation fails",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das konnte nicht geschätzt werden – versuch es mit einer anderen Beschreibung oder gib die Zahlen unten selbst ein."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Couldn't estimate that -- try describing it differently, or enter the numbers below yourself."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se ha podido estimar. Intenta describirlo de otra forma o introduce tú los números a continuación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible d'estimer ce repas. Essayez de le décrire autrement, ou saisissez vous-même les chiffres ci-dessous."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Չհաջողվեց գնահատել դա․ փորձիր այլ կերպ նկարագրել կամ ինքդ մուտքագրիր թվերը ներքևում։"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non è stato possibile stimarlo. Prova a descriverlo in modo diverso, oppure inserisci tu i numeri qui sotto."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ვერ შევაფასეთ — სცადე სხვანაირად აღწერო, ან თავად შეიყვანე მაჩვენებლები ქვემოთ."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось это оценить — попробуй описать иначе или введи цифры ниже вручную."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нисмо успели то да проценимо — покушај да опишеш другачије, или ручно унеси бројеве испод."
          }
        }
      }
    },
    "logMeal.footer.description" : {
      "comment" : "Footer note explaining the meal entry section on the log meal screen",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippe es, diktiere es oder beschreibe deine Mahlzeit in Worten -- Soma füllt die Felder unten so oder so aus. Überprüfe und passe alles vor dem Speichern an."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Type it, dictate it, or describe your meal in words -- Soma fills in the fields below either way. Review and adjust anything before saving."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escríbelo, dictalo o describe tu comida con palabras -- Soma completa los campos de abajo de cualquier forma. Revisa y ajusta lo que necesites antes de guardar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Écris-le, dicte-le ou décris ton repas avec des mots -- Soma remplit les champs ci-dessous dans tous les cas. Vérifie et ajuste avant d'enregistrer."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Գրիր, ասա բարձրաձայն կամ նկարագրիր քո ուտելիքը բառերով -- Soma-ն ամեն դեպքում կլրացնի ստորև դաշտերը։ Ստուգիր և անհրաժեշտության դեպքում ուղղիր՝ նախքան պահպանելը։"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scrivilo, dettalo o descrivi il tuo pasto a parole -- Soma compila comunque i campi qui sotto. Rivedi e modifica tutto prima di salvare."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "დაწერე, გააჟღერე ან აღწერე შენი კვება სიტყვებით -- Soma ისედაც შეავსებს ქვემოთ მოცემულ ველებს. შეამოწმე და საჭიროებისამებრ შეასწორე შენახვამდე."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
