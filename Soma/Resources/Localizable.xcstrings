    "home.scanGym.unavailable.workoutSet.message" : {
      "comment" : "Alert message shown when tapping Scan gym after today's workout is already logged or planned",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du hast dein heutiges Workout bereits protokolliert oder hinzugefügt, daher gibt es gerade nichts zu scannen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You've already logged or added today's workout, so there's nothing to scan for right now."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ya registraste o añadiste el entrenamiento de hoy, así que ahora no hay nada que escanear."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous avez déjà enregistré ou ajouté l'entraînement du jour, il n'y a donc rien à scanner pour l'instant."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Դուք արդեն գրանցել կամ ավելացրել եք այսօրվա մարզումը, ուստի այս պահին ոչինչ սկանավորելու կարիք չկա։"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hai già registrato o aggiunto l'allenamento di oggi, quindi al momento non c'è nulla da scansionare."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "თქვენ უკვე დააფიქსირეთ ან დაამატეთ დღევანდელი ვარჯიში, ამიტომ ამჟამად სკანირებისთვის არაფერია."
          }
        },
        "ru" : {
          "stringUnit" : {
