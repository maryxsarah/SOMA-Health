    "gymPhoto.cameraBlocked.offBody" : {
      "comment" : "Explainer shown when camera access is simply denied",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Soma benötigt Kamerazugriff, um deine Trainingsgeräte zu sehen. Du kannst ihn in den Einstellungen wieder aktivieren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Soma needs camera access to see your gym equipment. You can turn it back on in Settings."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Soma necesita acceso a la cámara para ver tu equipo de gimnasio. Puedes volver a activarlo en Ajustes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Soma a besoin d'accéder à l'appareil photo pour voir ton matériel de sport. Tu peux le réactiver dans Réglages."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Soma-ին անհրաժեշտ է տեսախցիկի հասանելիություն՝ քո մարզասարքերը տեսնելու համար։ Կարող ես նորից միացնել Կարգավորումներում։"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Soma ha bisogno dell'accesso alla fotocamera per vedere la tua attrezzatura da palestra. Puoi riattivarlo in Impostazioni."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Soma-ს სჭირდება კამერაზე წვდომა შენი სავარჯიშო აღჭურვილობის დასანახად. შეგიძლია ისევ ჩართო პარამეტრებში."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Soma нужен доступ к камере, чтобы увидеть твоё оборудование в зале. Ты можешь снова включить его в Настройках."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Soma-и је потребан приступ камери да би видела твоју опрему у теретани. Можеш га поново укључити у Подешавањима."
          }
        }
      }
    },
