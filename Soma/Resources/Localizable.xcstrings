          "stringUnit" : {
            "state" : "translated",
            "value" : "Ոչ պարտադիր"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Facoltativo"
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "არასავალდებულო"
          }
        },
        "ru" : {
          "stringUnit" : {
