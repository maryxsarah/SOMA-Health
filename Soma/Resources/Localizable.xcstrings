    "profile.injuries.explainer" : {
      "comment" : "Explainer text at top of the injuries editor sheet",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jede aktive Verletzung begrenzt die heutige Intensität auf „Moderat“ und blendet Workouts mit hoher Belastung aus."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Any active injury caps today's intensity at Moderate and hides high-impact workouts."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cualquier lesión activa limita la intensidad de hoy a Moderada y oculta los entrenamientos de alto impacto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toute blessure active limite l'intensité du jour à Modérée et masque les entraînements à fort impact."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ցանկացած ակտիվ վնասվածք սահմանափակում է այսօրվա ինտենսիվությունը մինչև Չափավոր և թաքցնում է բարձր ազդեցության մարզումները։"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qualsiasi infortunio attivo limita l'intensità di oggi a Moderata e nasconde gli allenamenti ad alto impatto."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ნებისმიერი აქტიური ტრავმა ზღუდავს დღევანდელ ინტენსივობას საშუალომდე და მალავს მაღალი ზემოქმედების ვარჯიშებს."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Любая активная травма ограничивает сегодняшнюю интенсивность до умеренной и скрывает высокоударные тренировки."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Свака активна повреда ограничава данашњи интензитет на умерен и скрива тренинге високог интензитета удара."
          }
        }
      }
    },
