    "What's your height?": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Cuánto mides?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quelle est ta taille ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Qual è la tua altezza?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie groß bist du?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Какой у тебя рост?"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "რა არის შენი სიმაღლე?"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Որքա՞ն է քո հասակը:"
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Колика је твоја висина?"
          }
        }
      }
    },
    "Used to personalize your training and nutrition targets.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se usa para personalizar tus objetivos de entrenamiento y nutrición."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisée pour personnaliser tes objectifs d'entraînement et de nutrition."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Serve per personalizzare i tuoi obiettivi di allenamento e nutrizione."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird verwendet, um deine Trainings- und Ernährungsziele zu personalisieren."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Используется, чтобы персонализировать твои цели по тренировкам и питанию."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "გამოიყენება შენი ვარჯიშისა და კვების მიზნების პერსონალიზაციისთვის."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Օգտագործվում է քո մարզումների և սնունդի նպատակները անհատականացնելու համար."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Користи се за прилагођавање твојих циљева тренирања и исхране."
          }
        }
      }
    },
    "When were you born?": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Cuándo naciste?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quelle est ta date de naissance ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Qual è la tua data di nascita?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wann bist du geboren?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Когда ты родился(-ась)?"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "როდის დაიბადე?"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ե՞րբ ես ծնվել:"
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Када си рођен(а)?"
          }
        }
      }
    },
    "This will be taken into account when generating your daily tailored plan.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo tendremos en cuenta al generar tu plan diario personalizado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nous en tiendrons compte pour générer ton plan quotidien personnalisé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne terremo conto nella creazione del tuo piano giornaliero personalizzato."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir berücksichtigen das bei der Erstellung deines individuellen Tagesplans."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это будет учтено при составлении твоего ежедневного индивидуального плана."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ეს გათვალისწინებული იქნება შენი ყოველდღიური ინდივიდუალური გეგმის შედგენისას."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Սա հաշվի կառնվի քո օրական հարմարեցված պլանը կազմելիս."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ово ће бити узето у обзир при изради твог дневног прилагођеног плана."
          }
        }
      }
    },
