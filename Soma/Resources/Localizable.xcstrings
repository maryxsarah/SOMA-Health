    "recommendationReason.explanation.healthkitHigh" : {
      "comment" : "No placeholders",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine HRV lag nahe an deinem aktuellen Ausgangswert und du hast genug geschlafen – ein gutes Zeichen für Erholung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your HRV was close to your recent baseline and you slept enough -- a good sign of recovery."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu VFC estuvo cerca de tu valor de referencia reciente y dormiste lo suficiente; buena señal de recuperación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre VFC était proche de votre référence récente et vous avez suffisamment dormi : bon signe de récupération."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Քո HRV ցուցանիշը մոտ էր քո սովորական մակարդակին, և դու բավարար քնել ես -- վերականգնման լավ նշան է."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La tua HRV era vicina alla tua baseline recente e hai dormito a sufficienza: un buon segno di recupero."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "შენი HRV მაჩვენებელი ახლოს იყო შენს ჩვეულ დონესთან და საკმარისად გეძინა -- აღდგენის კარგი ნიშანია."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Твой показатель ВСР был близок к обычному уровню, и сна было достаточно -- хороший признак восстановления."
          }
