            "value": "HRV"
          }
        }
      },
      "comment": "Accordion item title for heart rate variability, kept as acronym"
    },
    "overviewAccordion.hrv.text": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La variación en el tiempo entre latidos. Por lo general, un HRV más alto en relación con tu valor de referencia indica que tu sistema nervioso está bien recuperado; uno más bajo puede indicar fatiga, estrés o una recuperación incompleta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La variation du temps entre vos battements cardiaques. En général, un HRV plus élevé par rapport à votre propre référence indique que votre système nerveux est bien récupéré ; un HRV plus bas peut signaler de la fatigue, du stress ou une récupération incomplète."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La variazione del tempo tra i battiti cardiaci. In genere, un HRV più alto rispetto al tuo valore di riferimento indica che il tuo sistema nervoso è ben recuperato; uno più basso può segnalare affaticamento, stress o un recupero incompleto."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Schwankung der Zeit zwischen deinen Herzschlägen. Ein im Vergleich zu deinem eigenen Ausgangswert höherer HRV-Wert deutet in der Regel darauf hin, dass dein Nervensystem gut erholt ist; ein niedrigerer kann auf Erschöpfung, Stress oder unvollständige Erholung hinweisen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The variation in time between heartbeats. Generally, a higher HRV relative to your own baseline suggests your nervous system is well-recovered; a lower one can signal fatigue, stress, or incomplete recovery."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разброс во времени между ударами сердца. Обычно чем выше HRV относительно твоего обычного уровня, тем лучше восстановлена твоя нервная система; более низкий показатель может говорить об усталости, стрессе или неполном восстановлении."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "დროის ცვალებადობა გულისცემებს შორის. ჩვეულებრივ, უფრო მაღალი HRV შენს საბაზისო დონესთან შედარებით ნიშნავს, რომ შენი ნერვული სისტემა კარგადაა აღდგენილი; დაბალი მაჩვენებელი შეიძლება მიუთითებდეს დაღლილობაზე, სტრესზე ან არასრულ აღდგენაზე."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Սրտի զարկերի միջև ընկած ժամանակի փոփոխականությունը։ Սովորաբար, քո սեփական միջինի համեմատ ավելի բարձր HRV-ն ցույց է տալիս, որ նյարդային համակարգդ լավ վերականգնված է; ավելի ցածրը կարող է վկայել հոգնածության, սթրեսի կամ թերի վերականգնման մասին։"
          }
        }
      },
      "comment": "Accordion explainer text for HRV"
    },
    "overviewAccordion.restingHR.title": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "FC en reposo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "FC au repos"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "FC a riposo"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ruhepuls"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Resting HR"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пульс покоя"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "მოსვენებული პულსი"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Հանգստի սրտազարկ"
          }
        }
      },
      "comment": "Accordion item title for resting heart rate"
    },
    "overviewAccordion.restingHR.text": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu frecuencia cardíaca en reposo, medida normalmente durante la noche. Una frecuencia cardíaca en reposo notablemente más alta de lo habitual puede ser un signo temprano de fatiga acumulada, enfermedad o mal sueño."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre fréquence cardiaque au repos, généralement mesurée pendant la nuit. Une fréquence cardiaque au repos nettement plus élevée que d'habitude peut être un signe précoce de fatigue accumulée, de maladie ou de mauvais sommeil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tua frequenza cardiaca a riposo, di solito misurata durante la notte. Una frequenza cardiaca a riposo notevolmente più alta del solito può essere un segnale precoce di affaticamento accumulato, malattia o sonno scarso."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Ruhepuls, meist über Nacht gemessen. Ein auffällig höherer Ruhepuls als gewöhnlich kann ein frühes Anzeichen für angesammelte Erschöpfung, Krankheit oder schlechten Schlaf sein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your heart rate at rest, usually measured overnight. A notably higher-than-usual resting heart rate can be an early sign of accumulated fatigue, illness, or poor sleep."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Твой пульс в состоянии покоя, обычно измеряется ночью. Заметно повышенный пульс покоя может быть ранним признаком накопленной усталости, болезни или плохого сна."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "შენი პულსი მოსვენების დროს, ჩვეულებრივ იზომება ღამით. შესამჩნევად მომატებული მოსვენებული პულსი შეიძლება იყოს დაგროვილი დაღლილობის, დაავადების ან ცუდი ძილის ადრეული ნიშანი."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Հանգստի պահին քո սրտի հաճախությունը, սովորաբար չափվում է գիշերը։ Սովորականից նկատելիորեն բարձր հանգստի սրտազարկը կարող է կուտակված հոգնածության, հիվանդության կամ վատ քնի վաղ նշան լինել։"
          }
        }
      },
      "comment": "Accordion explainer text for resting heart rate"
    },
    "overviewAccordion.sleep.title": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sueño"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sommeil"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sonno"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schlaf"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sleep"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сон"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ძილი"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Քուն"
          }
        }
      },
      "comment": "Accordion item title for total sleep duration"
    },
    "overviewAccordion.sleep.text": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiempo total dormido. Tanto la duración como la constancia son importantes para la recuperación; consulta la sección Sueño para ver cómo se repartió ese tiempo entre sueño ligero, profundo y REM."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Temps total de sommeil. La durée et la régularité comptent toutes deux pour la récupération ; consultez la section Sommeil pour voir comment ce temps s'est réparti entre sommeil léger, profond et paradoxal (REM)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tempo totale di sonno. Sia la durata che la costanza contano per il recupero: consulta la sezione Sonno per vedere come si è suddiviso quel tempo tra sonno leggero, profondo e REM."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gesamte Schlafzeit. Für die Erholung zählen sowohl die Dauer als auch die Regelmäßigkeit – im Abschnitt Schlaf siehst du, wie sich diese Zeit auf Leicht-, Tief- und REM-Schlaf verteilt hat."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Total time asleep. Both duration and consistency matter for recovery -- see the Sleep section for how that time was split between light, deep, and REM sleep."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Общее время сна. Для восстановления важны и продолжительность, и регулярность — смотри раздел «Сон», чтобы увидеть, как это время распределилось между лёгким, глубоким сном и REM."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "საერთო ძილის დრო. აღდგენისთვის მნიშვნელოვანია როგორც ხანგრძლივობა, ისე რეგულარულობა — იხილე განყოფილება „ძილი\", რომ ნახო, როგორ გადანაწილდა ეს დრო მსუბუქ, ღრმა და REM ძილს შორის."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Քնած անցկացրած ընդհանուր ժամանակը։ Վերականգնման համար կարևոր են և՛ տևողությունը, և՛ կանոնավորությունը — տե՛ս «Քուն» բաժինը՝ տեսնելու, թե ինչպես բաժանվեց այդ ժամանակը թեթև, խոր և REM քնի միջև։"
          }
        }
      },
      "comment": "Accordion explainer text for total sleep duration"
    },
    "overviewHero.headline.high": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Alta: un buen día para exigirte"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Élevée : une bonne journée pour vous dépasser"
