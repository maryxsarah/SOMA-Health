        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Необязательный финишер — сегодня у тебя отличное восстановление"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "სურვილისამებრ დამატებითი დატვირთვა — დღეს კარგად ხარ აღდგენილი"
