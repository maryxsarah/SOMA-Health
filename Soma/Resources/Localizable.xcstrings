          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "დატვირთვის ხარისხი ეხმარება Soma-ს, ხვალინდელი გეგმა დღევანდელ რეალურ სავარჯიშო დატვირთვაზე მორგოს."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Уровень усилия помогает Soma настроить завтрашний план с учётом твоей реальной нагрузки сегодня."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
