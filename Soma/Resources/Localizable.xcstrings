    "howSomaWorks.workouts.description" : {
      "comment" : "How Soma Works tour: card description for the workouts feature",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starte den heutigen KI-erstellten Plan, mach ein Foto von einem Fitnessstudio, um einen Plan rund um die sichtbaren Geräte zu erhalten, oder protokolliere selbst eine beliebige Aktivität. Eine abgeschlossene Einheit zeigt immer deinen tatsächlichen Aufwand, die Kalorien und wie es gelaufen ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Start today's AI-built plan, snap a photo of a gym to get one built around the equipment you can see, or log any activity yourself. A completed session always shows your real effort, calories, and how it went."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Empieza el plan de hoy creado por IA, toma una foto de un gimnasio para obtener uno basado en el equipo que veas, o registra cualquier actividad tú mismo. Una sesión completada siempre muestra tu esfuerzo real, calorías y cómo te fue."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Démarrez le plan du jour créé par IA, prenez une photo d'une salle de sport pour en obtenir un basé sur le matériel visible, ou enregistrez vous-même n'importe quelle activité. Une séance terminée affiche toujours votre effort réel, les calories et comment ça s'est passé."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Սկսեք այսօրվա AI-ի կողմից կառուցված պլանը, լուսանկարեք մարզասրահը՝ ձեզ երևացող սարքավորումների շուրջ պլան ստանալու համար, կամ ինքներդ գրանցեք ցանկացած գործունեություն։ Ավարտված մարզումը միշտ ցույց է տալիս ձեր իրական ջանքը, կալորիաները և ինչպես անցավ։"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avvia il piano di oggi creato dall'IA, scatta una foto di una palestra per ottenerne uno basato sull'attrezzatura che vedi, oppure registra tu stesso qualsiasi attività. Una sessione completata mostra sempre il tuo sforzo reale, le calorie e come è andata."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "დაიწყეთ დღევანდელი AI-ს მიერ შექმნილი გეგმა, გადაუღეთ ფოტო სავარჯიშო დარბაზს, რომ მიიღოთ გეგმა თქვენთვის ხილული აღჭურვილობის მიხედვით, ან თავად დააფიქსირეთ ნებისმიერი აქტივობა. დასრულებული სესია ყოველთვის აჩვენებს თქვენს რეალურ ძალისხმევას, კალორიებს და როგორ წარიმართა."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Начните сегодняшний план, составленный ИИ, сфотографируйте зал, чтобы получить план под видимое оборудование, или отметьте любую активность сами. Завершённая тренировка всегда показывает реальные усилия, калории и то, как всё прошло."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Покрени данашњи план направљен помоћу вештачке интелигенције, сликај теретану да добијеш план заснован на опреми коју видиш, или сам забележи било коју активност. Завршена сесија увек приказује твој стварни напор, калорије и како је прошло."
          }
        }
      }
    },
