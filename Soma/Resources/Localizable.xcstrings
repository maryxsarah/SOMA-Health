    "Couldn't confidently read an assignment there — check the fields below, or try again.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No pudimos leer la tarea con seguridad ahí — revisa los campos de abajo o inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nous n'avons pas pu lire la tâche avec certitude à cet endroit — vérifiez les champs ci-dessous ou réessayez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non siamo riusciti a leggere il compito con sicurezza — controlla i campi qui sotto o riprova."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir konnten die Aufgabe dort nicht sicher lesen — überprüfe die Felder unten oder versuche es erneut."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось уверенно распознать задание — проверь поля ниже или попробуй снова."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "დავალების დამაჯერებლად წაკითხვა ვერ მოხერხდა — შეამოწმე ქვემოთ მოცემული ველები ან სცადე ხელახლა."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Չհաջողվեց վստահորեն կարդալ առաջադրանքը — ստուգիր ստորև դաշտերը կամ նորից փորձիր:"
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ту нисмо са сигурношћу успели да препознамо задатак — провери поља испод, или покушај поново."
          }
        }
      }
    },
