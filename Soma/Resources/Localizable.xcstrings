    "This goal's training isn't recommended for you right now, so it's safely paused. Your data stays put.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El entrenamiento de este objetivo no es recomendable para ti ahora mismo, así que está pausado de forma segura. Tus datos se quedan donde están."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'entraînement de cet objectif n'est pas recommandé pour vous en ce moment, il est donc mis en pause pour votre sécurité. Vos données restent en place."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'allenamento di questo obiettivo non è consigliato per te in questo momento, quindi è stato messo in pausa per sicurezza. I tuoi dati restano dove sono."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Training zu diesem Ziel wird dir gerade nicht empfohlen, deshalb ist es sicher pausiert. Deine Daten bleiben erhalten."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Тренировки по этой цели сейчас не рекомендованы тебе, поэтому она безопасно приостановлена. Твои данные остаются на месте."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ამ მიზნის ვარჯიშები ამჟამად შენთვის რეკომენდებული არ არის, ამიტომ ის უსაფრთხოდ შეჩერებულია. შენი მონაცემები ადგილზე რჩება."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Այս նպատակի մարզումն այժմ քեզ համար խորհուրդ չի տրվում, ուստի այն անվտանգ դադարեցված է: Քո տվյալները մնում են տեղում:"
          }
        },
        "sr": {
