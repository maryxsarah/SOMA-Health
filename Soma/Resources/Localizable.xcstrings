        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Պրոֆիլը պահպանվեց, բայց վնասվածքի տվյալները չհաջողվեց թարմացնել։ Փորձիր նորից։"
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Профил је сачуван, али подаци о повреди нису могли да се ажурирају. Покушај поново."
          }
        }
      }
    },
