    "loadingBar.goalProgress.0" : {
      "comment" : "Rotating motivational message shown while a goal-progress estimate loads",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du bist auf dem richtigen Weg, dein Ziel zu erreichen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You're on track to reach your goal."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vas por buen camino para alcanzar tu objetivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous êtes sur la bonne voie pour atteindre votre objectif."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Դու ճիշտ ուղու վրա ես դեպի քո նպատակը:"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sei sulla buona strada per raggiungere il tuo obiettivo."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "შენ სწორ გზაზე ხარ მიზნისკენ."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ты на верном пути к своей цели."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "На добром си путу да достигнеш свој циљ."
          }
        }
      }
    },
    "loadingBar.goalProgress.1" : {
      "comment" : "Rotating motivational message shown while a goal-progress estimate loads",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeder Tag, an dem du dranbleibst, ist ein gewonnener Tag."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Every day you commit is a day you win."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada día que te comprometes es un día que ganas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque jour où vous vous engagez est un jour gagné."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ամեն օր, երբ չես հանձնվում, հաղթանակի օր է:"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogni giorno in cui ti impegni è un giorno che vinci."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ყოველი დღე, როცა თავს არ ანებებ, გამარჯვების დღეა."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Каждый день, когда ты не сдаёшься, — это твоя победа."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сваки дан у ком не одустајеш — то је твоја победа."
          }
        }
      }
    },
    "loadingBar.goalProgress.2" : {
      "comment" : "Rotating motivational message shown while a goal-progress estimate loads",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
