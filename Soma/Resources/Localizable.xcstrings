      }
    },
    "recommendationReason.explanation.healthkitLow" : {
      "comment" : "No placeholders",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine HRV lag deutlich unter deinem aktuellen Ausgangswert, oder der Schlaf war zu kurz – dein Körper braucht heute eine Pause."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your HRV was well below your recent baseline, or sleep was short -- your body needs to ease up today."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu VFC estuvo muy por debajo de tu valor de referencia reciente, o dormiste poco; tu cuerpo necesita bajar el ritmo hoy."
          }
        },
        "fr" : {
          "stringUnit" : {
