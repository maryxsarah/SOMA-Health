    "Every sport has measurable goals — plus your own coach's task, tracked the same honest way." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jede Sportart hat messbare Ziele — plus die Aufgabe deines Trainers, genauso ehrlich verfolgt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Every sport has measurable goals — plus your own coach's task, tracked the same honest way."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada deporte tiene objetivos medibles — además de la tarea de tu entrenador, con el mismo seguimiento honesto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque sport a des objectifs mesurables — ainsi que la tâche de votre entraîneur, suivie avec la même honnêteté."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ամեն մարզաձև ունի չափելի նպատակներ, ինչպես նաև՝ քո մարզիչի հանձնարարությունը, որը հետևվում է նույն ազնիվ եղանակով:"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogni sport ha obiettivi misurabili — oltre al compito del tuo allenatore, monitorato con la stessa onestà."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ყველა სპორტს აქვს გაზომვადი მიზნები — და ასევე შენი მწვრთნელის დავალება, რომელსაც იმავე პატიოსანი წესით ვადევნებთ თვალს."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "У каждого вида спорта есть измеримые цели — а ещё задание от твоего тренера, которое отслеживается так же честно."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сваки спорт има мерљиве циљеве — плус задатак твог тренера, који се прати подједнако поштено."
          }
        }
      }
    },
    "Exact exercises, sets, weights, and how to do each one -- built around the workout you picked above." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Genaue Übungen, Sätze, Gewichte und wie du jede davon ausführst – abgestimmt auf das Workout, das du oben ausgewählt hast."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exact exercises, sets, weights, and how to do each one -- built around the workout you picked above."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ejercicios, series y pesos exactos, y cómo hacer cada uno, creados en torno al entrenamiento que elegiste arriba."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exercices, séries, charges précis et comment réaliser chacun d'eux — conçus autour de la séance que vous avez choisie ci-dessus."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ճշգրիտ վարժություններ, մոտեցումներ, կշիռներ և յուրաքանչյուրի կատարման եղանակը՝ կառուցված վերևում ընտրած մարզման հիման վրա։"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esercizi, serie, pesi esatti e come eseguire ciascuno, creati intorno all'allenamento che hai scelto sopra."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ზუსტი სავარჯიშოები, სეტები, წონები და თითოეულის შესრულების წესი — აგებულია შენ მიერ ზემოთ არჩეულ ვარჯიშზე."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Точные упражнения, подходы, веса и техника выполнения каждого — построено вокруг тренировки, выбранной выше."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тачне вежбе, серије, тежине и начин извођења сваке — направљено око тренинга изабраног изнад."
          }
        }
      }
    },
