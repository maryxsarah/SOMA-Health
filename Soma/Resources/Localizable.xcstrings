    "profile.cycleTracking.explainer" : {
      "comment" : "Explainer text at top of the cycle-tracking editor sheet",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Optional, und nie angenommen -- wird nur festgelegt, wenn du es uns sagst. Soma berücksichtigt deine Zyklusphase bei den Trainingsvorschlägen als eine allgemeine Überlegung unter mehreren. Dies ist nur eine allgemeine Orientierung, keine medizinische Beratung und kein Fruchtbarkeits- oder Eisprung-Tracker."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Optional, and never assumed -- only set if you tell us. Soma will factor your cycle phase into training suggestions as one general consideration among others. This is general guidance only, not medical advice, and not a fertility or ovulation tracker."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opcional, y nunca se asume -- solo se activa si tú nos lo indicas. Soma tendrá en cuenta la fase de tu ciclo en las sugerencias de entrenamiento como una consideración general más entre otras. Esto es solo orientación general, no un consejo médico, ni un rastreador de fertilidad u ovulación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Facultatif, et jamais supposé -- activé seulement si tu nous le dis. Soma prendra en compte la phase de ton cycle dans les suggestions d'entraînement, comme une considération générale parmi d'autres. Ceci n'est qu'une indication générale, pas un avis médical, ni un suivi de fertilité ou d'ovulation."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ընտրովի է և երբեք չի ենթադրվում -- սահմանվում է միայն այն դեպքում, եթե դու ինքդ ես մեզ ասում։ Soma-ն կհաշվի առնի քո ցիկլի փուլը մարզման առաջարկություններում՝ որպես ընդհանուր գործոններից մեկը մյուսների կողքին։ Սա միայն ընդհանուր ուղեցույց է, ոչ բժշկական խորհուրդ, ոչ էլ պտղաբերության կամ ձվազատման հետևող գործիք։"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Facoltativo, e mai presunto -- attivo solo se ce lo dici tu. Soma terrà conto della fase del tuo ciclo nei suggerimenti di allenamento, come una considerazione generale tra le altre. Questa è solo un'indicazione generale, non un consiglio medico, né un tracciamento della fertilità o dell'ovulazione."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "სურვილისამებრ და არასდროს ივარაუდება -- დაყენდება მხოლოდ იმ შემთხვევაში, თუ შენ გვეტყვი. Soma გაითვალისწინებს შენი ციკლის ფაზას სავარჯიშო რეკომენდაციებში, როგორც ერთ-ერთ ზოგად ფაქტორს სხვებს შორის. ეს მხოლოდ ზოგადი მითითებაა და არა სამედიცინო რჩევა, არც ნაყოფიერების ან ოვულაციის ტრეკერი."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Необязательно и никогда не предполагается по умолчанию -- задаётся только если ты сам(а) это укажешь. Soma учтёт фазу твоего цикла в тренировочных рекомендациях как один из общих факторов среди прочих. Это только общая рекомендация, а не медицинский совет, и не трекер фертильности или овуляции."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Необавезно, и никада се не подразумева — поставља се само ако нам ти то кажеш. Soma ће узети у обзир фазу твог циклуса у предлозима за тренирање, као један од општих фактора међу осталима. Ово је само општа смерница, а не медицински савет, нити пратилац плодности или овулације."
          }
        }
      }
    },
