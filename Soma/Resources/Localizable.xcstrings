    "Found a bug or have an idea? It goes straight to the team.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Encontraste un error o tienes una idea? Llega directo al equipo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous avez trouvé un bug ou une idée à partager ? Elle arrive directement à l'équipe."
          }
