            "value": "ჩვეულებრივ რომელ დღეს ან დღეებში იმართება?"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Այն սովորաբար ո՞ր օրը կամ օրերն է լինում։"
          }
        },
