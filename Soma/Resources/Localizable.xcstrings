    "sportGoalOnboarding.slide1.sub" : {
      "comment" : "Sport-goal onboarding gallery slide 1 subtitle",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starte über diese Karte auf der Startseite — oder jederzeit über Profil → Training → Mein Ziel. Der Beta-Schalter befindet sich unter Konto."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Start from this Home card — or anytime via Profile → Training → My goal. The beta switch lives in Account."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Empieza desde esta tarjeta de Inicio — o en cualquier momento desde Perfil → Entrenamiento → Mi meta. El interruptor beta está en Cuenta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Commence depuis cette carte sur l'Accueil — ou à tout moment via Profil → Entraînement → Mon objectif. L'interrupteur bêta se trouve dans Compte."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Սկսիր այս քարտից Գլխավոր էջում — կամ ցանկացած պահի Պրոֆիլ → Մարզումներ → Իմ նպատակը միջոցով։ Բետա անջատիչը գտնվում է Հաշիվ բաժնում։"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inizia da questa scheda nella Home — o in qualsiasi momento tramite Profilo → Allenamento → Il mio obiettivo. L'interruttore beta si trova in Account."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "დაიწყე მთავარი გვერდის ამ ბარათიდან — ან ნებისმიერ დროს პროფილი → ვარჯიში → ჩემი მიზანი გზით. ბეტა გადამრთველი Account-შია."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Начни с этой карточки на главном экране — или в любое время через Профиль → Тренировки → Моя цель. Переключатель бета-доступа находится в разделе Аккаунт."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Почни од ове картице на Почетној — или било када преко Профил → Тренинг → Мој циљ. Бета прекидач се налази у Налогу."
          }
        }
      }
    },
