    "sleepSection.noData.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No sleep recorded last night"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
