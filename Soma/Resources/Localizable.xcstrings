          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Écris-le, dicte-le ou utilise « Qu'est-ce que je peux cuisiner ? »"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scrivilo, dettalo o usa \"Cosa posso cucinare?\""
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe es, diktiere es oder nutze „Was kann ich kochen?“"
          }
