          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ստացիր քո օրական պլանը վայրկյանների ընթացքում՝ հարմարեցված քո առողջությանը։ Հետևիր քո պլանին և տես, թե ինչպես է աճում քո առաջընթացը։"
