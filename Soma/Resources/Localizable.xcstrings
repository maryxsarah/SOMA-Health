    "logMeal.estimateFailed": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha podido estimar. Intenta describirlo de otra forma o introduce tú los números a continuación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d'estimer ce repas. Essayez de le décrire autrement, ou saisissez vous-même les chiffres ci-dessous."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è stato possibile stimarlo. Prova a descriverlo in modo diverso, oppure inserisci tu i numeri qui sotto."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das konnte nicht geschätzt werden – versuch es mit einer anderen Beschreibung oder gib die Zahlen unten selbst ein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't estimate that -- try describing it differently, or enter the numbers below yourself."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось это оценить — попробуй описать иначе или введи цифры ниже вручную."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ვერ შევაფასეთ — სცადე სხვანაირად აღწერო, ან თავად შეიყვანე მაჩვენებლები ქვემოთ."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Չհաջողվեց գնահատել դա․ փորձիր այլ կերպ նկարագրել կամ ինքդ մուտքագրիր թվերը ներքևում։"
          }
        }
      },
      "comment": "Error shown when AI meal estimation fails"
    },
    "logMeal.macrosOutOfRange": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las calorías deben estar entre 0 y 5000, y los macros entre 0 y 500 g: revisa tus datos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les calories doivent être comprises entre 0 et 5000, et les macros entre 0 et 500 g : vérifiez vos chiffres."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le calorie devono essere comprese tra 0 e 5000 e i macro tra 0 e 500 g: controlla i tuoi numeri."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalorien sollten zwischen 0 und 5000 liegen und Makros zwischen 0 und 500 g – überprüfe deine Angaben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Calories should be 0-5000 and macros 0-500g -- check your numbers."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Калории должны быть в пределах 0-5000, а БЖУ — 0-500 г. Проверь введённые данные."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "კალორია უნდა იყოს 0-5000-ს შორის, ხოლო მაკროელემენტები — 0-500გ-ს შორის. გადაამოწმე მონაცემები."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Կալորիաները պետք է լինեն 0-5000, իսկ մակրոները՝ 0-500գ միջակայքում․ ստուգիր թվերը։"
          }
        }
      },
      "comment": "Validation error shown when entered meal macros are out of allowed range"
    },
