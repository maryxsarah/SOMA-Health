    "logWorkout.section.effortFooter" : {
      "comment" : "Log-activity form: footer explaining why effort is captured",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Anstrengung hilft Soma, den morgigen Plan an deine heutige tatsächliche Trainingsbelastung anzupassen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Effort helps Soma calibrate tomorrow's plan around today's real training load."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El esfuerzo ayuda a Soma a calibrar el plan de mañana según tu carga de entrenamiento real de hoy."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
