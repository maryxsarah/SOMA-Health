      }
    },
    "One goal at a time — measured honestly, matched to your readiness every day." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Ziel nach dem anderen — ehrlich gemessen und jeden Tag an deine Tagesform angepasst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un objetivo a la vez — medido con honestidad y ajustado a tu forma física cada día."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un objectif à la fois — mesuré honnêtement et adapté à votre forme chaque jour."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Մեկ նպատակ մի ժամանակում — ազնվորեն չափվում է և ամեն օր հարմարվում է քո պատրաստվածությանը:"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un obiettivo alla volta — misurato con onestà e adattato alla tua forma ogni giorno."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ერთდროულად ერთი მიზანი — გულწრფელად იზომება და ყოველდღე შენს მზადყოფნას ერგება."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Одна цель за раз — честно измеряется и подстраивается под твою готовность каждый день."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Један циљ у исто време — поштено мерен, усклађен са твојом спремношћу сваки дан."
          }
        }
      }
    },
