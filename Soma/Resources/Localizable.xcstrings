    "notificationEnablement.body" : {
      "comment" : "Notification enablement screen: explanation of what notifications will be sent",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Soma sendet dir morgens deine Trainingsempfehlung sowie ein paar kurze Check-ins über den Tag -- einen Bewegungsimpuls, abends eine Erinnerung, falls das heutige Workout noch offen ist, und ein kurzes Fortschritts-Update."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Soma sends your morning training recommendation, plus a few light check-ins through the day -- a movement nudge, an evening reminder if today's workout is still open, and a quick progress update."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Soma te envía tu recomendación de entrenamiento por la mañana, además de algunos avisos ligeros durante el día: un recordatorio para moverte, un aviso por la tarde si el entrenamiento de hoy sigue pendiente, y una actualización rápida de tu progreso."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Soma vous envoie votre recommandation d'entraînement le matin, ainsi que quelques rappels légers pendant la journée -- une incitation à bouger, un rappel le soir si l'entraînement du jour est encore en attente, et un point rapide sur votre progression."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Soma-ն ուղարկում է առավոտյան մարզումների ձեր առաջարկը, ինչպես նաև մի քանի թեթև հիշեցումներ օրվա ընթացքում՝ շարժման հրավեր, երեկոյան հիշեցում, եթե այսօրվա մարզումը դեռ չի կատարվել, և արագ առաջընթացի թարմացում։"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Soma ti invia il consiglio di allenamento del mattino, oltre a qualche promemoria leggero durante la giornata -- uno stimolo a muoverti, un promemoria serale se l'allenamento di oggi è ancora aperto, e un rapido aggiornamento sui progressi."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Soma გიგზავნით დილის ვარჯიშის რეკომენდაციას, ასევე რამდენიმე მსუბუქ შეხსენებას დღის განმავლობაში -- მოძრაობის მოწოდებას, საღამოს შეხსენებას, თუ დღევანდელი ვარჯიში ჯერ კიდევ ღიაა, და პროგრესის სწრაფ განახლებას."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Soma присылает утреннюю рекомендацию по тренировке, а также несколько лёгких напоминаний в течение дня — призыв подвигаться, вечернее напоминание, если сегодняшняя тренировка ещё не завершена, и краткое обновление прогресса."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Soma ти шаље јутарњу препоруку за тренинг, као и неколико кратких подсетника током дана -- подстицај за кретање, вечерњи подсетник ако је данашњи тренинг још увек отворен, и брзи преглед напретка."
          }
        }
      }
    },
