    "gymPhoto.result.withPlan" : {
      "comment" : "Gym-photo scan result: intro line when a workout plan was generated",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Basierend auf deiner Ausstattung und Gesundheit — hier ist dein heutiges Workout, um dein Ziel zu erreichen:"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Based on your setup and health, here's today's workout to reach your goal:"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Según tu equipo y tu salud, aquí tienes el entrenamiento de hoy para alcanzar tu meta:"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En fonction de ton équipement et de ta santé, voici l'entraînement du jour pour atteindre ton objectif :"
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ելնելով քո սարքավորումներից և առողջությունից՝ ահա այսօրվա մարզումը՝ նպատակիդ հասնելու համար."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In base alla tua attrezzatura e alla tua salute, ecco l'allenamento di oggi per raggiungere il tuo obiettivo:"
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "შენი აღჭურვილობისა და ჯანმრთელობის მიხედვით, აი დღევანდელი ვარჯიში მიზნის მისაღწევად:"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "С учётом твоего оборудования и здоровья — вот тренировка на сегодня для достижения твоей цели:"
          }
        },
        "sr" : {
          "stringUnit" : {
