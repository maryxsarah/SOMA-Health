        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Բանանը հատապտուղ է: Ելակը, բուսաբանական տեսանկյունից, ոչ:"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le banane sono bacche. Le fragole, botanicamente, non lo sono."
          }
