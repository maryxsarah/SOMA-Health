    "howSomaWorks.goalProgress.whereToFind" : {
      "comment" : "How Soma Works tour: where-to-find line for the goal progress feature",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"Dein Fortschritt\" auf der Startseite, sobald du ein Zielfoto hinzugefügt hast."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"Your progress\" on Home, once you've added a goal photo."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"Tu progreso\" en Inicio, una vez que hayas añadido una foto de objetivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« Votre progression » sur l'accueil, une fois qu'une photo d'objectif est ajoutée."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Ձեր առաջընթացը» Գլխավոր էջում, հենց նպատակի լուսանկար ավելացնեք։"
