    "recommendationDetail.tomorrowCard.title" : {
      "comment" : "Title of the tomorrow's-tip card",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das solltest du für morgen beachten"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Look out for tomorrow"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ten esto en cuenta para mañana"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "À surveiller pour demain"
