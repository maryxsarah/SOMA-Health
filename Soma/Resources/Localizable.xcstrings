          "stringUnit" : {
            "state" : "translated",
            "value" : "Eliminar tu cuenta no la cancela: Apple seguirá cobrándola hasta que la canceles tú."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Supprimer ton compte ne l'annule pas — Apple continue de la facturer jusqu'à ce que tu l'annules toi-même."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Հաշվի ջնջումը այն չի չեղարկում. Apple-ը կշարունակի գանձել, մինչև ինքդ չեղարկես:"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eliminare l'account non lo annulla: Apple continuerà ad addebitarlo finché non lo annulli tu."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ანგარიშის წაშლა მას არ აუქმებს — Apple გააგრძელებს გადახდის ჩამოჭრას, სანამ თავად არ გააუქმებ."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Удаление аккаунта её не отменяет — Apple продолжит списывать оплату, пока ты не отменишь её сам(а)."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Брисање налога је не отказује — Apple наставља наплату док је сам не откажеш."
          }
        }
      }
    },
