    "logWorkout.section.whenFooter" : {
      "comment" : "Log-activity form: footer explaining why start time/duration is captured",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wird verwendet, um deine tatsächliche Herzfrequenz für dieses genaue Zeitfenster aus Apple Health oder einem verbundenen Wearable abzurufen, falls eines gemeldet wurde."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Used to pull your real heart rate for this exact window from Apple Health or a connected wearable, if one reported it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se usa para obtener tu frecuencia cardíaca real en esta franja horaria exacta desde Apple Health o un dispositivo conectado, si alguno la registró."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sert à récupérer ta fréquence cardiaque réelle sur ce créneau exact depuis Apple Santé ou un appareil connecté, s'il l'a enregistrée."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Օգտագործվում է քո իրական զարկերակը այս ճշգրիտ ժամանակահատվածում ստանալու համար Apple Health-ից կամ միացված սարքից, եթե այն դա գրանցել է։"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Serve a recuperare la tua frequenza cardiaca reale in questa esatta finestra temporale da Apple Salute o da un dispositivo indossabile connesso, se ne ha registrata una."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "გამოიყენება შენი რეალური პულსის ამ ზუსტ დროის მონაკვეთში მისაღებად Apple Health-იდან ან დაკავშირებული მოწყობილობიდან, თუ მან ეს დააფიქსირა."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Используется, чтобы получить твой реальный пульс за этот промежуток времени из Apple Health или подключённого устройства, если оно его зафиксировало."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Користи се да би се добио твој стварни пулс за овај тачан временски период из Apple Health или повезаног уређаја, ако га је забележио."
          }
        }
      }
    },
