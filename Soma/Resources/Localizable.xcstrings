    "Soma plans each day from your body's signals — sleep, HRV and workouts. Connect at least one source to get a tailored plan." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Soma plant jeden Tag anhand der Signale deines Körpers — Schlaf, HRV und Training. Verbinde mindestens eine Quelle für einen maßgeschneiderten Plan."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Soma planifica cada día a partir de las señales de tu cuerpo: sueño, VFC y entrenamientos. Conecta al menos una fuente para obtener un plan personalizado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Soma planifie chaque journée à partir des signaux de votre corps — sommeil, VFC et entraînements. Connectez au moins une source pour obtenir un plan sur mesure."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Soma-ն ամեն օր ծրագրում է քո մարմնի ազդանշանների հիման վրա՝ քուն, HRV և մարզումներ։ Միացրու առնվազն մեկ աղբյուր անհատականացված պլան ստանալու համար։"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Soma pianifica ogni giornata in base ai segnali del tuo corpo: sonno, HRV e allenamenti. Collega almeno una fonte per ottenere un piano su misura."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Soma ყოველდღიურად გეგმავს შენი სხეულის სიგნალების მიხედვით — ძილი, HRV და ვარჯიშები. დააკავშირე მინიმუმ ერთი წყარო პერსონალური გეგმის მისაღებად."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Soma планирует каждый день на основе сигналов твоего тела — сна, ВСР и тренировок. Подключи хотя бы один источник, чтобы получить персональный план."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Soma планира сваки дан на основу сигнала твог тела — сна, ХРВ и тренинга. Повежи бар један извор да добијеш прилагођен план."
          }
        }
      }
    },
    "Soma reads it" : {
      "comment" : "'How it works' step label",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
