    "From your profile — Soma doesn't track weight over time yet.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desde tu perfil: Soma aún no hace seguimiento del peso a lo largo del tiempo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Depuis votre profil — Soma ne suit pas encore l'évolution du poids dans le temps."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dal tuo profilo: Soma non tiene ancora traccia del peso nel tempo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aus deinem Profil – Soma verfolgt dein Gewicht über die Zeit noch nicht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "From your profile — Soma doesn't track weight over time yet."
          }
        },
        "ru": {
