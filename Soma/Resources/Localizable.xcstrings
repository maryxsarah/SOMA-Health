    "goalProgress.insights.disclaimer" : {
      "comment" : "Disclaimer under the goal-progress insights card",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Basiert auf dem Vergleich deiner Ziel- und aktuellen Fotos -- ein zusätzliches Signal neben deinen angegebenen Zielen, kein Ersatz dafür."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Based on comparing your goal and current photos -- a secondary signal alongside your stated goals, not a replacement for them."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Basado en comparar tus fotos de objetivo y actual -- una señal secundaria junto a tus objetivos declarados, no un reemplazo de ellos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Basé sur la comparaison de tes photos objectif et actuelle -- un signal secondaire en plus de tes objectifs déclarés, pas un remplacement."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Հիմնված է քո նպատակային և ընթացիկ լուսանկարների համեմատության վրա՝ երկրորդական ազդանշան է քո հայտարարած նպատակների կողքին, ոչ թե դրանց փոխարինող։"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Basato sul confronto tra le tue foto obiettivo e attuale -- un segnale secondario accanto ai tuoi obiettivi dichiarati, non un sostituto."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ეფუძნება შენი სასურველი და მიმდინარე ფოტოების შედარებას — დამატებითი სიგნალია შენს მითითებულ მიზნებთან ერთად, არა მათი შემცვლელი."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Основано на сравнении твоих целевого и текущего фото — дополнительный сигнал наряду с заявленными целями, а не замена им."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zasnovano na poređenju tvoje ciljne i trenutne fotografije -- sekundarni signal uz tvoje navedene ciljeve, ne zamena za njih."
          }
        }
      }
    },
