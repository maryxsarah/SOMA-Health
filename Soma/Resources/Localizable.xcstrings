    "gymPhoto.cameraBlocked.restrictedBody" : {
      "comment" : "Explainer shown when camera access is blocked by a device restriction",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Etwas auf diesem Gerät blockiert die Kamera — meist Bildschirmzeit oder ein Arbeits-/Schulprofil. Du kannst dein Fitnessstudio trotzdem anhand eines vorhandenen Fotos scannen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Something on this device is blocking the camera — usually Screen Time or a work/school profile. You can still scan your gym from a photo you already have."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Algo en este dispositivo está bloqueando la cámara — normalmente Tiempo en pantalla o un perfil de trabajo/escuela. Aun así puedes escanear tu gimnasio desde una foto que ya tengas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quelque chose sur cet appareil bloque l'appareil photo — généralement Temps d'écran ou un profil professionnel/scolaire. Tu peux quand même scanner ta salle à partir d'une photo que tu as déjà."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Այս սարքի վրա ինչ-որ բան արգելափակում է տեսախցիկը — սովորաբար Էկրանի ժամանակը կամ աշխատանքային/դպրոցական պրոֆիլը։ Դու դեռ կարող ես սկանավորել քո մարզասրահը արդեն եղած լուսանկարից։"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qualcosa su questo dispositivo sta bloccando la fotocamera — di solito Tempo di utilizzo o un profilo lavoro/scuola. Puoi comunque scansionare la tua palestra da una foto che hai già."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ამ მოწყობილობაზე რაღაც ბლოკავს კამერას — ჩვეულებრივ ეკრანის დრო ან სამუშაო/სასკოლო პროფილი. მაინც შეგიძლია დაასკანირო შენი დარბაზი უკვე არსებული ფოტოდან."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Что-то на этом устройстве блокирует камеру — обычно это «Экранное время» или рабочий/учебный профиль. Ты всё ещё можешь отсканировать зал по уже имеющемуся фото."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нешто на овом уређају блокира камеру — обично Екранско време или пословни/школски профил. И даље можеш да скенираш теретану помоћу фотографије коју већ имаш."
          }
        }
      }
    },
