            "value" : "No se pudieron obtener los datos de hoy. Vuelve a conectar un dispositivo o inténtalo de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de récupérer les données du jour. Reconnectez un appareil ou réessayez."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Չհաջողվեց ստանալ այսօրվա տվյալները։ Կրկին կապակցիր սարքը կամ նորից փորձիր։"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile recuperare i dati di oggi. Riconnetti un dispositivo o riprova."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "დღევანდელი მონაცემების ჩატვირთვა ვერ მოხერხდა. ხელახლა დააკავშირე მოწყობილობა ან სცადე ხელახლა."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось загрузить данные за сегодня. Переподключи устройство или попробуй снова."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нисмо успели да учитамо данашње податке. Поново повежи уређај или покушај поново."
          }
        }
      }
    },
