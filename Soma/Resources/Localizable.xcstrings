    "I agree to Soma's Terms of Service and Privacy Policy, and understand Soma's recommendations are not medical advice.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Acepto los Términos de Servicio y la Política de Privacidad de Soma, y entiendo que las recomendaciones de Soma no constituyen asesoramiento médico."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "J'accepte les Conditions d'utilisation et la Politique de confidentialité de Soma, et je comprends que les recommandations de Soma ne constituent pas un avis médical."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Accetto i Termini di Servizio e l'Informativa sulla Privacy di Soma e comprendo che i consigli di Soma non costituiscono consulenza medica."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich stimme den Nutzungsbedingungen und der Datenschutzrichtlinie von Soma zu und verstehe, dass die Empfehlungen von Soma keine medizinische Beratung darstellen."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Я соглашаюсь с Условиями использования и Политикой конфиденциальности Soma и понимаю, что рекомендации Soma не являются медицинской консультацией."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ვეთანხმები Soma-ს მომსახურების პირობებსა და კონფიდენციალურობის პოლიტიკას და მესმის, რომ Soma-ს რეკომენდაციები არ წარმოადგენს სამედიცინო რჩევას."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ես համաձայն եմ Soma-ի Օգտագործման պայմաններին և Գաղտնիության քաղաքականությանը և հասկանում եմ, որ Soma-ի առաջարկությունները բժշկական խորհրդատվություն չեն."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Слажем се са Условима коришћења и Политиком приватности апликације Soma и разумем да препоруке апликације Soma нису медицински савет."
          }
        }
      }
    },
