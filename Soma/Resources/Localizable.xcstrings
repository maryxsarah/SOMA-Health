    "goalPicker.sportList.footnote" : {
      "comment" : "",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jede Sportart hat messbare Ziele — plus deine eigene Coach-Aufgabe, genauso ehrlich verfolgt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Every sport has measurable goals — plus your own coach's task, tracked the same honest way."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada deporte tiene metas medibles — además de la tarea de tu propio entrenador, seguida de la misma forma honesta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque sport a des objectifs mesurables — plus ta propre tâche de coach, suivie de la même façon honnête."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Յուրաքանչյուր սպորտ ունի չափելի նպատակներ — գումարած ձեր սեփական մարզչի առաջադրանքը, հետևված նույն ազնիվ ձևով։"
          }
