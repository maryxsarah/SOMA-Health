    "dailyChecklist.onboarding.goalProfile.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Weight, goal, and the basics Soma tailors your plan from."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Peso, objetivo y lo básico con lo que Soma adapta tu plan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Poids, objectif et les bases à partir desquelles Soma personnalise ton programme."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Peso, obiettivo e le basi da cui Soma calibra il tuo piano."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gewicht, Ziel und die Grundlagen, aus denen Soma deinen Plan ableitet."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вес, цель и базовые данные, на основе которых Soma подбирает твой план."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "წონა, მიზანი და საბაზისო მონაცემები, რომლებზეც Soma აგებს შენს გეგმას."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Քաշը, նպատակը և հիմնական տվյալները, որոնց հիման վրա Soma-ն կազմում է քո ծրագիրը։"
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Тежина, циљ и основни подаци на основу којих Soma прилагођава твој план."
          }
        }
      },
      "comment": "Onboarding checklist item subtitle"
    },
