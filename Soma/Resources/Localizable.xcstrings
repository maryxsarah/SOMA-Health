      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein echter Bereich, nie ein Versprechen. Ein 10–20-minütiger Zielblock ergänzt deinen Tagesplan, abgestimmt auf deine Bereitschaft."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A real range, never a promise. A 10–20 min goal block joins your daily plan, matched to readiness."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un rango real, nunca una promesa. Un bloque de meta de 10 a 20 min se suma a tu plan diario, ajustado a tu preparación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une fourchette réelle, jamais une promesse. Un bloc objectif de 10 à 20 min s'ajoute à ton plan quotidien, adapté à ta disponibilité physique."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Իրական միջակայք, երբեք խոստում։ 10–20 րոպեանոց նպատակային բլոկը միանում է քո օրական պլանին՝ պատրաստակամությանը համապատասխան։"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un intervallo reale, mai una promessa. Un blocco obiettivo di 10-20 min si aggiunge al tuo piano giornaliero, adattato alla tua prontezza."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "რეალური დიაპაზონი, არასდროს დაპირება. 10–20 წუთიანი მიზნის ბლოკი ემატება შენს ყოველდღიურ გეგმას, მზადყოფნის შესაბამისად."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Реальный диапазон, а не обещание. Блок цели на 10–20 минут добавляется в твой дневной план с учётом готовности организма."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Стваран распон, никад обећање. Блок циља од 10–20 мин придружује се твом дневном плану, усклађен са спремношћу."
          }
        }
      }
    },
    "sportGoalOnboarding.slide3.title" : {
      "comment" : "Sport-goal onboarding gallery slide 3 title",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein ehrliches Ziel — und darauf trainieren"
