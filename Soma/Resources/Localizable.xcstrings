    "notification.upgradeReminder.title": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu acceso gratuito termina en 2 días"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre accès gratuit se termine dans 2 jours"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo accesso gratuito termina tra 2 giorni"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein kostenloser Zugang endet in 2 Tagen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your free access ends in 2 days"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Твой бесплатный доступ заканчивается через 2 дня"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "შენი უფასო წვდომა 2 დღეში სრულდება"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Քո անվճար հասանելիությունը ավարտվում է 2 օրից"
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Твој бесплатан приступ истиче за 2 дана"
          }
        }
      },
      "comment": "Push notification title warning the user their referral bonus access is ending soon"
    },
    "notification.upgradeReminder.body": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Suscríbete a Soma Premium para seguir recibiendo tu plan diario completo: entrenamientos, objetivos de pasos y más."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Abonnez-vous à Soma Premium pour continuer à recevoir votre plan quotidien complet : entraînements, objectifs de pas et plus encore."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Abbonati a Soma Premium per continuare a ricevere il tuo piano giornaliero completo: allenamenti, obiettivi di passi e altro ancora."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Abonniere Soma Premium, um weiterhin deinen vollständigen Tagesplan zu erhalten – Workouts, Schrittziele und mehr."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Subscribe to Soma Premium to keep getting your full daily plan -- workouts, step targets, and more."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Оформи подписку Soma Premium, чтобы и дальше получать полный ежедневный план -- тренировки, целевые показатели по шагам и многое другое."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "გამოიწერე Soma Premium, რომ განაგრძო სრული ყოველდღიური გეგმის მიღება -- ვარჯიშები, ნაბიჯების მიზნები და სხვა."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Բաժանորդագրվիր Soma Premium-ին՝ շարունակելու համար ստանալ քո ամբողջական ամենօրյա պլանը -- մարզումներ, քայլերի նպատակներ և ավելին:"
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Претплати се на Soma Premium да наставиш да добијаш свој пуни дневни план — тренинге, циљеве корака и много тога."
          }
        }
      },
      "comment": "Push notification body warning the user their referral bonus access is ending soon"
    },
    "notification.middayMovement.title": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sigue en movimiento"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Restez en mouvement"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Continua a muoverti"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bleib in Bewegung"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stay moving"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не останавливайся"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "განაგრძე მოძრაობა"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Շարունակիր շարժվել"
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Остани у покрету"
          }
        }
      },
      "comment": "Push notification title nudging the user to move during the day"
    },
    "notification.middayMovement.body": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Incluso un paseo corto ayuda a tu recuperación de hoy y a tu preparación de mañana."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Même une courte marche favorise votre récupération d'aujourd'hui et votre forme de demain."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Anche una breve passeggiata favorisce il recupero di oggi e la forma di domani."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schon ein kurzer Spaziergang unterstützt deine Erholung heute und deine Fitness von morgen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Even a short walk supports today's recovery and tomorrow's readiness."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Даже короткая прогулка помогает восстановлению сегодня и готовности завтра."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "თუნდაც მოკლე გასეირნება ხელს უწყობს დღევანდელ აღდგენას და ხვალინდელ მზადყოფნას."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Նույնիսկ կարճ զբոսանքը նպաստում է այսօրվա վերականգնմանը և վաղվա պատրաստվածությանը:"
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Чак и кратка шетња подржава данашњи опоравак и сутрашњу спремност."
          }
        }
      },
      "comment": "Push notification body nudging the user to move during the day"
    },
    "notification.eveningWorkout.title": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todavía hay tiempo hoy"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il est encore temps aujourd'hui"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "C'è ancora tempo oggi"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Heute ist noch Zeit"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Still time today"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ещё есть время сегодня"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "დღეს ჯერ კიდევ არის დრო"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Այսօր դեռ ժամանակ կա"
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Још има времена данас"
          }
        }
      },
      "comment": "Push notification title reminding the user their workout is still open in the evening"
    },
    "notification.eveningWorkout.body": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu entrenamiento está listo cuando tú lo estés: regístralo al terminar para mantener tu racha."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre séance est prête quand vous l'êtes : enregistrez-la une fois terminée pour garder votre série."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo allenamento è pronto quando lo sei tu: registralo al termine per mantenere la tua serie."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Workout ist bereit, wann immer du es bist – protokolliere es nach dem Training, um deine Serie zu halten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your workout is ready whenever you are -- log it when you're done to keep your streak."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Твоя тренировка ждёт, когда ты будешь готов -- запиши её после завершения, чтобы сохранить серию."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "შენი ვარჯიში მზადაა, როცა შენც მზად იქნები -- დაასრულე და ჩაინიშნე, რომ სერია შეინარჩუნო."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Քո մարզումը պատրաստ է, երբ դու պատրաստ լինես -- գրանցիր այն ավարտելուց հետո՝ շարքդ պահպանելու համար:"
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Твој тренинг те чека кад год будеш спреман — забележи га кад завршиш, да сачуваш низ."
          }
        }
      },
      "comment": "Push notification body reminding the user their workout is still open in the evening"
    },
