    "connectDevice.body" : {
      "comment" : "",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Whoop, Oura und Apple Health teilen deine echten Erholungsdaten, damit Somas Empfehlungen mit der Zeit präziser werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Whoop, Oura, and Apple Health share your real recovery data so Soma's recommendations get sharper over time."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Whoop, Oura y Apple Health comparten tus datos reales de recuperación para que las recomendaciones de Soma sean cada vez más precisas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Whoop, Oura et Apple Health partagent tes vraies données de récupération pour que les recommandations de Soma s'affinent avec le temps."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Whoop-ը, Oura-ն և Apple Health-ը կիսվում են ձեր իրական վերականգնման տվյալներով, որպեսզի Soma-ի առաջարկությունները ժամանակի ընթացքում ավելի ճշգրիտ դառնան։"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Whoop, Oura e Apple Health condividono i tuoi dati reali di recupero così i consigli di Soma diventano più precisi nel tempo."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Whoop, Oura და Apple Health უზიარებენ თქვენს რეალურ აღდგენის მონაცემებს, რათა Soma-ს რეკომენდაციები დროთა განმავლობაში უფრო ზუსტი გახდეს."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Whoop, Oura и Apple Health передают ваши реальные данные восстановления, чтобы рекомендации Soma со временем становились точнее."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Whoop, Oura и Apple Health деле твоје стварне податке о опоравку како би Soma-ине препоруке временом постајале прецизније."
          }
        }
      }
    },
