    "home.goalRow.customWeek" : {
      "comment" : "String(localized:) key added in goalRowText(); English default '%@ · week %lld of %lld' (name, current week, total weeks). %@ is goal.displayName(in:) -- dynamic model content, left untranslated as-is.",
