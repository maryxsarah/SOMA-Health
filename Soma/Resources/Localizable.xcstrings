            "value": "Zeig uns dein Ziel"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Покажи нам свою цель"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
