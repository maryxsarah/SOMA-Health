    "profile.anchorSession.explainer" : {
      "comment" : "Explainer text at top of the weekly anchor session editor sheet",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein wiederkehrender Kurs oder eine Aktivität (z. B. ein Hot-Yoga-Kurs am Dienstag), um den herum der Rest deiner Woche aufgebaut wird."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A recurring class or activity (e.g. a Tuesday hot yoga class) the rest of your week gets built around."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una clase o actividad recurrente (por ejemplo, una clase de yoga caliente los martes) alrededor de la cual se organiza el resto de tu semana."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un cours ou une activité récurrente (par exemple un cours de hot yoga le mardi) autour duquel le reste de ta semaine s'organise."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Կրկնվող պարապմունք կամ ակտիվություն (օրինակ՝ տաք յոգայի պարապմունք երեքշաբթի օրերին), որի շուրջ կառուցվում է քո շաբաթվա մնացած մասը։"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un corso o un'attività ricorrente (ad esempio un corso di hot yoga il martedì) attorno a cui si costruisce il resto della tua settimana."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "განმეორებადი გაკვეთილი ან აქტივობა (მაგალითად, ცხელი იოგის გაკვეთილი სამშაბათს), რომლის გარშემოც შენდება დანარჩენი კვირა."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Повторяющееся занятие или активность (например, хот-йога по вторникам), вокруг которой строится остальная часть недели."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Понављајући час или активност (нпр. час хот јоге уторком) око којих се гради остатак твоје недеље."
          }
        }
      }
    },
