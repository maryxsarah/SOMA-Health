    "recommendationDetail.cap.consecutiveDaysActiveRecovery" : {
      "comment" : "Cap explanation shown when 5+ consecutive training days forced an active-recovery day",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hinweis: Du hast 5 oder mehr Tage in Folge trainiert, daher ist heute aktive Erholung angesagt – nur leichte Bewegung, obwohl deine Erholung stark aussah."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Note: you've trained 5+ days in a row, so today is active recovery -- light movement only, even though recovery looked strong."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nota: has entrenado 5 días o más seguidos, así que hoy toca recuperación activa: solo movimiento ligero, aunque la recuperación parecía buena."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Remarque : vous vous êtes entraîné 5 jours ou plus d'affilée, donc aujourd'hui est un jour de récupération active — mouvement léger uniquement, même si votre récupération semblait bonne."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Նշում. դու 5+ օր անընդմեջ մարզվել ես, այդ իսկ պատճառով այսօր ակտիվ վերականգնման օր է՝ միայն թեթև շարժում, թեև վերականգնման ցուցանիշները լավ էին թվում։"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nota: ti sei allenato per 5 o più giorni di fila, quindi oggi è recupero attivo: solo movimento leggero, anche se il recupero sembrava buono."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "შენიშვნა: 5+ დღეა ზედიზედ ვარჯიშობდი, ამიტომ დღეს აქტიური აღდგენის დღეა — მხოლოდ მსუბუქი მოძრაობა, თუმცა აღდგენა კარგად გამოიყურებოდა."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Примечание: 5+ дней подряд были тренировки, поэтому сегодня — активное восстановление, только лёгкая активность, хотя восстановление выглядело хорошим."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Напомена: тренирање је трајало 5+ дана заредом, па је данас активни опоравак — само лагано кретање, иако је опоравак изгледао добро."
          }
        }
      }
    },
    "recommendationDetail.cap.consecutiveDaysRest" : {
