    "Check back once you have a few more days of %@ recorded.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuelve a consultarlo cuando tengas registrados algunos días más de %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Revenez une fois que vous aurez enregistré quelques jours de plus de %@."
          }
        },
        "it": {
          "stringUnit": {
