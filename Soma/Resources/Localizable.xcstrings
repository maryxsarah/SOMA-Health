      "comment": "Title of the hint shown when the user hasn't set up kitchen equipment"
    },
    "mealRecommendation.equipmentHint.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recipes will assume a stove, oven, and microwave until you set up your full kitchen equipment."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las recetas asumirán que tienes cocina, horno y microondas hasta que configures todo tu equipo de cocina."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les recettes supposeront une cuisinière, un four et un micro-ondes jusqu'à ce que tu configures tout ton équipement de cuisine."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le ricette presupporranno un fornello, un forno e un microonde finché non configuri tutta la tua attrezzatura da cucina."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Rezepte gehen von Herd, Backofen und Mikrowelle aus, bis du deine vollständige Küchenausstattung eingerichtet hast."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Рецепты будут исходить из наличия плиты, духовки и микроволновки, пока ты не укажешь всё своё кухонное оборудование."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "რეცეპტები ივარაუდებს გაზქურას, ღუმელს და მიკროტალღურ ღუმელს, სანამ არ მიუთითებ სამზარეულოს სრულ აღჭურვილობას."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Բաղադրատոմսերը կենթադրեն վառարան, ջեռոց և միկրոալիքային վառարան, մինչև դու չնշես խոհանոցի ամբողջական սարքավորումը։"
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Рецепти ће подразумевати шпорет, рерну и микроталасну пећницу док не подесиш комплетну кухињску опрему."
          }
        }
      },
      "comment": "Body of the hint shown when the user hasn't set up kitchen equipment"
    },
