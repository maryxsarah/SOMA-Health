    "notification.eveningWorkout.body" : {
      "comment" : "Push notification body reminding the user their workout is still open in the evening",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Workout ist bereit, wann immer du es bist – protokolliere es nach dem Training, um deine Serie zu halten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your workout is ready whenever you are -- log it when you're done to keep your streak."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu entrenamiento está listo cuando tú lo estés: regístralo al terminar para mantener tu racha."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre séance est prête quand vous l'êtes : enregistrez-la une fois terminée pour garder votre série."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Քո մարզումը պատրաստ է, երբ դու պատրաստ լինես -- գրանցիր այն ավարտելուց հետո՝ շարքդ պահպանելու համար:"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il tuo allenamento è pronto quando lo sei tu: registralo al termine per mantenere la tua serie."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "შენი ვარჯიში მზადაა, როცა შენც მზად იქნები -- დაასრულე და ჩაინიშნე, რომ სერია შეინარჩუნო."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Твоя тренировка ждёт, когда ты будешь готов -- запиши её после завершения, чтобы сохранить серию."
