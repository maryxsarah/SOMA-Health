    "RPE = Rate of Perceived Exertion, how hard a set feels (1 = very easy, 10 = maximum effort)." : {
      "comment" : "Explains the RPE intensity scale shown on exercises that use it",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RPE = Empfundene Anstrengung, wie hart sich ein Satz anfühlt (1 = sehr leicht, 10 = maximale Anstrengung)."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RPE = Rate of Perceived Exertion, how hard a set feels (1 = very easy, 10 = maximum effort)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RPE = Índice de Esfuerzo Percibido, lo duro que se siente una serie (1 = muy fácil, 10 = esfuerzo máximo)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RPE = Indice d'effort perçu, à quel point une série est difficile (1 = très facile, 10 = effort maximal)."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RPE = ընկալվող ծանրաբեռնվածության աստիճանը՝ որքան ծանր է զգացվում սեթը (1 = շատ հեշտ, 10 = առավելագույն ջանք)."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RPE = Indice di sforzo percepito, quanto è impegnativa una serie (1 = molto facile, 10 = sforzo massimo)."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RPE = აღქმული დატვირთვის ხარისხი — რამდენად რთულად იგრძნობა სეტი (1 = ძალიან ადვილი, 10 = მაქსიმალური ძალისხმევა)."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RPE = субъективная оценка нагрузки: насколько тяжёлым ощущается подход (1 = очень легко, 10 = максимальное усилие)."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RPE = процена субјективног напора — колико тешка делује серија (1 = врло лако, 10 = максималан напор)."
          }
        }
      }
    },
