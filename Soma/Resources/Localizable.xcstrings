    "Soma wasn't sure what it saw -- add the equipment you have available.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Soma no estaba seguro de lo que vio: añade el equipo que tengas disponible."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Soma n'était pas sûr de ce qu'il a vu : ajoutez le matériel dont vous disposez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Soma non era sicuro di cosa avesse visto: aggiungi l'attrezzatura che hai a disposizione."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Soma war sich nicht sicher, was es gesehen hat – füge die Geräte hinzu, die du hast."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Soma не смогла точно определить, что видит, — добавь доступное тебе оборудование."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "Soma-მ ბოლომდე ვერ ამოიცნო, რას ხედავდა — დაამატე შენთვის ხელმისაწვდომი ინვენტარი."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Soma-ն լրիվ վստահ չէր, թե ինչ է տեսնում — ավելացրու քեզ մոտ եղած սարքավորումները։"
          }
        }
      },
      "comment": "Caption shown above the equipment chips when vision confidence was low. Source uses a literal double-hyphen; preserve as the catalog key exactly."
    },
