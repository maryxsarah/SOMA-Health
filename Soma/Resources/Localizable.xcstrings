    "profile.kitchenEquipment.consequence" : {
      "comment" : "Row consequence text for the kitchen-equipment editor",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schlägt nur Rezepte vor, die du wirklich kochen kannst"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
