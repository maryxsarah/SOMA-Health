    "overviewHero.headline.medium" : {
      "comment" : "Overview hero headline when recovery/readiness is in the medium band",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mittel – moderate Belastung passt"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Medium — moderate effort fits"
          }
        },
        "es" : {
