            "value": "Aucun sommeil enregistré la nuit dernière"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun sonno registrato la scorsa notte"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Letzte Nacht wurde kein Schlaf erfasst"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Данные о сне за прошлую ночь отсутствуют"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "გასულ ღამეს ძილის მონაცემები არ დაფიქსირდა"
          }
        },
        "hy": {
