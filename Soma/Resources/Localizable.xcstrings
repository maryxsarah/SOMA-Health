    "onboardingCharts.trajectory.setGoalWeightPrompt" : {
      "comment" : "Shown under the current weight reading when no goal weight has been set yet",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lege ein Zielgewicht fest, um deinen voraussichtlichen Zeitplan zu sehen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Set a goal weight to see your projected timeline."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Establece un peso objetivo para ver tu cronograma proyectado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Définis un poids cible pour voir ton calendrier prévisionnel."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Սահմանիր նպատակային քաշը՝ քո կանխատեսվող ժամանակացույցը տեսնելու համար։"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Imposta un peso obiettivo per vedere la tua tempistica prevista."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "დააყენე სამიზნე წონა, რომ ნახო შენი სავარაუდო ვადები."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Укажи целевой вес, чтобы увидеть предполагаемый график."
          }
