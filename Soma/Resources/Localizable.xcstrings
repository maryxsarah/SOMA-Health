            "value": "Այսօրվա առաջարկությունը հիմնված է ներկայումս հասանելի տվյալների վրա."
          }
        }
      },
      "comment": "No placeholders; fallback for unrecognized server reason codes"
    },
    "recommendationReason.tomorrowTip.highRecovery": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sigue así: dormir bien e hidratarte esta noche te ayudará a mantener esta tendencia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Continuez ainsi : un sommeil régulier et une bonne hydratation ce soir aideront à maintenir cette tendance."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Continua così: dormire bene e idratarti stasera ti aiuterà a mantenere questa tendenza."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Weiter so – ausreichend Schlaf und Flüssigkeitszufuhr heute Nacht helfen, diesen Trend beizubehalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep it up -- consistent sleep and hydration tonight will help maintain this trend."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Продолжай в том же духе -- стабильный сон и питьевой режим сегодня ночью помогут удержать эту тенденцию."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ასე გააგრძელე -- სტაბილური ძილი და საკმარისი წყლის მიღება ამაღამ დაგეხმარება ამ ტენდენციის შენარჩუნებაში."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Այսպես շարունակիր -- կայուն քունը և հեղուկի ընդունումը այս գիշեր կօգնեն պահպանել այս միտումը."
          }
        }
      },
      "comment": "Tomorrow tip shown for a high recovery/readiness day; no placeholders"
    },
    "recommendationReason.tomorrowTip.mediumRecovery": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una buena noche de sueño hoy puede llevar a que mañana sea un día de mayor intensidad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une bonne nuit de sommeil ce soir peut faire de demain une journée à plus haute intensité."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una notte di sonno solida stasera può trasformare domani in una giornata a maggiore intensità."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine erholsame Nacht heute kann morgen zu einem intensiveren Tag machen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A solid night's sleep tonight can push tomorrow into a higher-intensity day."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Крепкий сон сегодня ночью может сделать завтрашний день более интенсивным."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ამაღამ ხარისხიანმა ძილმა შეიძლება ხვალინდელი დღე უფრო მაღალი ინტენსივობის გახადოს."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Այս գիշեր լավ քունը կարող է վաղվա օրը դարձնել ավելի ինտենսիվ."
          }
        }
      },
      "comment": "Tomorrow tip shown for a medium recovery/readiness day; no placeholders"
    },
    "recommendationReason.tomorrowTip.lowRecovery": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Prioriza el sueño esta noche y mantén el esfuerzo de hoy ligero; la recuperación se acumula en varios días, no en uno solo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Priorisez le sommeil ce soir et gardez l'effort d'aujourd'hui léger : la récupération se construit sur plusieurs jours, pas en un seul."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dai priorità al sonno stasera e mantieni leggero lo sforzo di oggi: il recupero si accumula in più giorni, non in uno solo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Priorisiere heute Nacht den Schlaf und halte die heutige Belastung leicht – Erholung baut sich über mehrere Tage auf, nicht nur einen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Prioritize sleep tonight and keep today's effort light -- recovery compounds over a few days, not just one."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сегодня ночью сделай сон приоритетом и не перегружай себя сегодня -- восстановление накапливается за несколько дней, а не за один."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ამაღამ ძილს პრიორიტეტი მიანიჭე და დღეს დატვირთვა მსუბუქი დატოვე -- აღდგენა რამდენიმე დღეში გროვდება, არა ერთში."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Այս գիշեր առաջնահերթություն տուր քնին և այսօրվա ծանրաբեռնվածությունը թեթև պահիր -- վերականգնումը կուտակվում է մի քանի օրվա, ոչ թե մեկ օրվա ընթացքում."
          }
        }
      },
      "comment": "Tomorrow tip shown for a low recovery/readiness day; no placeholders"
    },
    "recommendationReason.tomorrowTip.healthkitHigh": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vas por buen camino: mantén el sueño y la actividad constantes para seguir así."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous êtes sur une bonne tendance : gardez un sommeil et une activité constants pour le rester."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sei su una buona tendenza: mantieni costanti sonno e attività per restarci."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du bist auf einem guten Weg – halte Schlaf und Aktivität konstant, um hier zu bleiben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You're on a good trend -- keep sleep and activity consistent to stay here."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ты на верном пути -- сохраняй стабильный сон и активность, чтобы удержаться на этом уровне."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "შენ კარგ ტენდენციაზე ხარ -- შეინარჩუნე სტაბილური ძილი და აქტივობა, რომ აქ დარჩე."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Դու լավ միտումի մեջ ես -- պահպանիր կայուն քունը և ակտիվությունը, որպեսզի մնաս այս մակարդակում."
          }
        }
      },
      "comment": "Tomorrow tip shown for a high HealthKit-only recovery day; no placeholders"
    },
    "recommendationReason.tomorrowTip.insufficientData": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usar tu Apple Watch por la noche, o conectar Whoop u Oura, te dará una lectura personalizada a partir de mañana."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Porter votre Apple Watch la nuit, ou connecter Whoop ou Oura, vous donnera une lecture personnalisée dès demain."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Indossare l'Apple Watch di notte, o collegare Whoop od Oura, ti darà una lettura personalizzata a partire da domani."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn du deine Apple Watch nachts trägst oder Whoop bzw. Oura verbindest, erhältst du ab morgen eine personalisierte Auswertung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wearing your Apple Watch overnight, or connecting Whoop or Oura, will give you a personalized read starting tomorrow."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если ты будешь носить Apple Watch ночью или подключишь Whoop или Oura, начиная с завтрашнего дня ты будешь получать персонализированную оценку."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Watch-ის ღამით ტარება ან Whoop-ის ან Oura-ს დაკავშირება ხვალიდან პერსონალიზებულ შეფასებას მოგცემს."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Watch-ը գիշերը կրելը կամ Whoop-ը կամ Oura-ն միացնելը վաղվանից քեզ կտա անհատականացված գնահատական."
          }
        }
      },
      "comment": "Tomorrow tip shown when there wasn't enough health data today; no placeholders"
    },
    "recommendationReason.tomorrowTip.unknown": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conectar Whoop u Oura te da una puntuación de recuperación más precisa que solo Apple Health."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connecter Whoop ou Oura donne un score de récupération plus précis qu'Apple Santé seul."
