    "This helps us personalize your experience.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto nos ayuda a personalizar tu experiencia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela nous aide à personnaliser votre expérience."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo ci aiuta a personalizzare la tua esperienza."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das hilft uns, deine Erfahrung zu personalisieren."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это поможет нам персонализировать твой опыт."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ეს დაგეხმარება გამოცდილების პერსონალიზებაში."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Սա կօգնի մեզ անհատականացնել քո փորձառությունը."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ово нам помаже да прилагодимо твоје искуство."
          }
        }
      }
    },
    "How many workouts do you do per week?": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Cuántos entrenamientos haces por semana?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Combien de séances d'entraînement faites-vous par semaine ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quanti allenamenti fai a settimana?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie viele Workouts machst du pro Woche?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сколько тренировок в неделю ты делаешь?"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "კვირაში რამდენ ვარჯიშს აკეთებ?"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Շաբաթական քանի՞ մարզում ես անում:"
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Колико тренинга имаш недељно?"
          }
        }
      }
    },
    "This helps Soma calibrate your tailored plan.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto ayuda a Soma a calibrar tu plan personalizado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela aide Soma à calibrer votre plan personnalisé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo aiuta Soma a calibrare il tuo piano personalizzato."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das hilft Soma, deinen individuellen Plan abzustimmen."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это поможет Soma настроить твой индивидуальный план."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ეს ეხმარება Soma-ს, მოარგოს შენი ინდივიდუალური გეგმა."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Սա օգնում է Soma-ին ճշգրտել քո հարմարեցված պլանը."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ово помаже Soma да прилагоди твој план."
          }
        }
      }
    },
    "Where did you hear about us?": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Dónde nos conociste?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Comment avez-vous entendu parler de nous ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dove hai sentito parlare di noi?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wo hast du von uns erfahren?"
          }
        },
