    "Every sport has measurable goals — plus your own coach's task, tracked the same honest way.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada deporte tiene objetivos medibles — además de la tarea de tu entrenador, con el mismo seguimiento honesto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque sport a des objectifs mesurables — ainsi que la tâche de votre entraîneur, suivie avec la même honnêteté."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni sport ha obiettivi misurabili — oltre al compito del tuo allenatore, monitorato con la stessa onestà."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede Sportart hat messbare Ziele — plus die Aufgabe deines Trainers, genauso ehrlich verfolgt."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "У каждого вида спорта есть измеримые цели — а ещё задание от твоего тренера, которое отслеживается так же честно."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ყველა სპორტს აქვს გაზომვადი მიზნები — და ასევე შენი მწვრთნელის დავალება, რომელსაც იმავე პატიოსანი წესით ვადევნებთ თვალს."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ամեն մարզաձև ունի չափելի նպատակներ, ինչպես նաև՝ քո մարզիչի հանձնարարությունը, որը հետևվում է նույն ազնիվ եղանակով:"
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Сваки спорт има мерљиве циљеве — плус задатак твог тренера, који се прати подједнако поштено."
          }
        }
      }
    },
    "Pick a goal": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige un objetivo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez un objectif"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli un obiettivo"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle ein Ziel"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выбери цель"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "აირჩიე მიზანი"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ընտրիր նպատակ"
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Изабери циљ"
          }
        }
      }
    },
    "One goal at a time — measured honestly, matched to your readiness every day.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un objetivo a la vez — medido con honestidad y ajustado a tu forma física cada día."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un objectif à la fois — mesuré honnêtement et adapté à votre forme chaque jour."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un obiettivo alla volta — misurato con onestà e adattato alla tua forma ogni giorno."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Ziel nach dem anderen — ehrlich gemessen und jeden Tag an deine Tagesform angepasst."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Одна цель за раз — честно измеряется и подстраивается под твою готовность каждый день."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ერთდროულად ერთი მიზანი — გულწრფელად იზომება და ყოველდღე შენს მზადყოფნას ერგება."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Մեկ նպատակ մի ժամանակում — ազնվորեն չափվում է և ամեն օր հարմարվում է քո պատրաստվածությանը:"
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Један циљ у исто време — поштено мерен, усклађен са твојом спремношћу сваки дан."
          }
        }
      }
    },
    "Certified eye protection is recommended for all padel play.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se recomienda protección ocular certificada para jugar al pádel."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une protection oculaire certifiée est recommandée pour toute pratique du padel."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Si consiglia una protezione oculare certificata per giocare a padel."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für Padel wird zertifizierter Augenschutz empfohlen."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для игры в падел рекомендуется сертифицированная защита глаз."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "პადელის ნებისმიერი თამაშისთვის რეკომენდებულია სერტიფიცირებული თვალის დაცვა."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Պադելով խաղալիս խորհուրդ է տրվում օգտագործել սերտիֆիկացված աչքի պաշտպանություն:"
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Сертификована заштита за очи се препоручује за сву игру падела."
          }
        }
      }
    },
    "YOUR OWN": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "LO TUYO"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À VOUS"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "IL TUO"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "DEINS"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "СВОЁ"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "საკუთარი"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "ՔՈ ՍԵՓԱԿԱՆԸ"
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "ТВОЈЕ"
          }
        }
      }
    },
    "Got a task from your coach? Add it here — do the work in Soma and show them your progress: sessions and measurements export as one card.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Tu entrenador te dio una tarea? Añádela aquí — haz el trabajo en Soma y muéstrale tu progreso: las sesiones y las mediciones se exportan en una sola tarjeta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre entraîneur vous a donné une tâche ? Ajoutez-la ici — faites le travail dans Soma et montrez-lui vos progrès : les séances et les mesures s'exportent en une seule carte."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai un compito dal tuo allenatore? Aggiungilo qui — allenati in Soma e mostragli i tuoi progressi: sessioni e misurazioni vengono esportate in un'unica scheda."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hast du eine Aufgabe von deinem Trainer bekommen? Füge sie hier hinzu — erledige das Training in Soma und zeig ihm deinen Fortschritt: Einheiten und Messwerte werden als eine Karte exportiert."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Получил задание от тренера? Добавь его сюда — выполняй его в Soma и показывай тренеру свой прогресс: занятия и замеры экспортируются в виде одной карточки."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "მწვრთნელისგან დავალება მიიღე? დაამატე აქ — შეასრულე Soma-ში და აჩვენე მას შენი პროგრესი: სესიები და გაზომვები ერთ ბარათად გამოდის."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Մարզիչիցդ առաջադրանք ես ստացել: Ավելացրու այն այստեղ — կատարիր այն Soma-ում և ցույց տուր նրան քո առաջընթացը. պարապմունքներն ու չափումները արտահանվում են մեկ քարտի տեսքով:"
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Имаш задатак од тренера? Додај га овде — уради га у Soma апликацији и покажи тренеру свој напредак: сесије и мерења се извозе као једна картица."
          }
        }
      }
    },
