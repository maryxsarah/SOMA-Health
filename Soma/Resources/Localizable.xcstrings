            "state": "translated",
            "value": "მაგ: „ბევრს ვმოგზაურობ სამუშაოს გამო“"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "օր.՝ «Ես հաճախ եմ ճամփորդում աշխատանքի համար»"
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "нпр. „Пуно путујем због посла“"
          }
        }
