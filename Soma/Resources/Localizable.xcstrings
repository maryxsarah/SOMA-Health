    "profile.notifications.groupFootnote" : {
      "comment" : "Footnote under the Notifications settings group",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ruhezeiten verschieben jede Benachrichtigung, die sonst in dieses Zeitfenster fallen würde -- nichts geht verloren, sie wird nur bis zum Ende verschoben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quiet hours delay any notification that would otherwise land inside the window -- nothing is lost, just pushed to when it ends."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las horas de silencio retrasan cualquier notificación que de otro modo llegaría dentro de la ventana -- no se pierde nada, solo se pospone hasta que termina."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les heures calmes retardent toute notification qui atterrirait autrement dans cette fenêtre -- rien n'est perdu, elle est juste reportée jusqu'à la fin."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Հանգիստ ժամերը հետաձգում են ցանկացած ծանուցում, որը հակառակ դեպքում կհայտնվեր այս պատուհանում -- ոչինչ չի կորչում, պարզապես տեղափոխվում է մինչև ավարտը:"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le ore silenziose ritardano qualsiasi notifica che altrimenti arriverebbe in questa finestra -- niente va perso, viene solo spostata a quando finisce."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "წყნარი საათები აჭიანურებს ნებისმიერ შეტყობინებას, რომელიც სხვაგვარად ამ პერიოდში მოვიდოდა -- არაფერი იკარგება, უბრალოდ გადაიდება დასრულებამდე."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тихие часы откладывают любое уведомление, которое иначе попало бы в это окно -- ничего не теряется, просто переносится на момент его окончания."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тихи сати одлажу свако обавештење које би иначе стигло у овом периоду -- ништа се не губи, само се помера до његовог краја."
          }
        }
      }
    },
