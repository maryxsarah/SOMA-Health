    "In ~5 days we'll confirm your baseline — second attempts usually score higher.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En unos 5 días confirmaremos tu base — los segundos intentos suelen dar mejores resultados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans environ 5 jours, nous confirmerons votre référence — les deuxièmes tentatives donnent généralement de meilleurs résultats."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tra circa 5 giorni confermeremo la tua base — i secondi tentativi di solito danno risultati migliori."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In etwa 5 Tagen bestätigen wir deine Basis — zweite Versuche fallen meist besser aus."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Через ~5 дней мы подтвердим твой исходный показатель — вторая попытка обычно даёт результат выше."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "დაახლოებით 5 დღეში დავადასტურებთ შენს საწყის მაჩვენებელს — მეორე მცდელობა ჩვეულებრივ უკეთეს შედეგს იძლევა."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Մոտ 5 օրից մենք կհաստատենք քո ելակետային ցուցանիշը — երկրորդ փորձերը սովորաբար ավելի բարձր արդյունք են ցույց տալիս:"
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "За ~5 дана ћемо потврдити твој почетни резултат — други покушаји обично дају бољи резултат."
          }
        }
      }
    },
