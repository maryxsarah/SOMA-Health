    "dailyChecklist.onboarding.howSomaWorks.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A 6-card tour of what's actually in the app."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un recorrido de 6 tarjetas por lo que realmente incluye la app."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une visite en 6 cartes de ce que propose vraiment l'appli."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un tour di 6 schede su cosa c'è davvero nell'app."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Tour mit 6 Karten durch das, was wirklich in der App steckt."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Обзор из 6 карточек о том, что на самом деле есть в приложении."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "6 ბარათიანი ტური იმის შესახებ, რა არის ნამდვილად აპში."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "6 քարտից բաղկացած շրջայց այն մասին, թե ինչ իրականում կա հավելվածում։"
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Преглед у 6 картица о томе шта се заправо налази у апликацији."
          }
        }
      },
      "comment": "Onboarding checklist item subtitle"
    },
    "dailyChecklist.standard.breakfast.macroSubtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "~%lldg protein, %lldg carbs to stay fueled and full."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "~%lldg de proteína, %lldg de carbohidratos para mantener energía y saciedad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "~%lldg de protéines, %lldg de glucides pour faire le plein d'énergie et de satiété."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "~%lldg di proteine, %lldg di carboidrati per energia e sazietà durature."
          }
