    "notification.progressCheckIn.noWorkoutsBody" : {
      "comment" : "Push notification body for the evening progress check-in when no workouts were logged this week",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beständigkeit schlägt Intensität. Auch eine kurze Einheit heute zählt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consistency beats intensity. A short session today still counts."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La constancia gana a la intensidad. Una sesión corta hoy también cuenta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La régularité l'emporte sur l'intensité. Une courte séance aujourd'hui compte aussi."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Հետևողականությունը գերազանցում է ինտենսիվությանը: Այսօրվա կարճ պարապմունքն էլ է հաշվում:"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La costanza batte l'intensità. Anche una sessione breve oggi conta."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "თანმიმდევრობა სჯობს ინტენსივობას. დღეს თუნდაც მოკლე სესიაც ითვლება."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Постоянство важнее интенсивности. Даже короткое занятие сегодня засчитывается."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Доследност побеђује интензитет. Кратка сесија данас се ипак рачуна."
          }
        }
      }
    },
