      },
      "comment": "Label above the weekday picker for the anchor session"
    },
    "kitchenEquipmentQuestion.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What's in your kitchen?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Qué hay en tu cocina?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Qu'y a-t-il dans ta cuisine ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cosa c'è nella tua cucina?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was ist in deiner Küche?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Что есть у тебя на кухне?"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "რა გაქვს სამზარეულოში?"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ի՞նչ ունես խոհանոցում։"
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Шта имаш у кухињи?"
          }
        }
      },
      "comment": "Onboarding kitchen-equipment question screen title"
    },
    "kitchenEquipmentQuestion.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "So we only ever suggest recipes you can actually cook. Optional -- skip if you're not sure yet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Así solo te sugerimos recetas que realmente puedes cocinar. Opcional -- omítelo si aún no estás seguro/a."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainsi, on ne te propose que des recettes que tu peux vraiment cuisiner. Facultatif -- passe cette étape si tu n'es pas encore sûr·e."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Così ti suggeriamo solo ricette che puoi davvero cucinare. Facoltativo -- salta pure se non sei ancora sicuro/a."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "So schlagen wir dir nur Rezepte vor, die du wirklich kochen kannst. Optional -- überspringe das, wenn du dir noch nicht sicher bist."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Так мы предлагаем только те рецепты, которые ты реально можешь приготовить. Необязательно -- пропусти, если пока не уверен(а)."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ასე ყოველთვის მხოლოდ იმ რეცეპტებს გთავაზობთ, რომლის მომზადებაც შენ შეგიძლია. სურვილისამებრ -- გამოტოვე, თუ ჯერ არ ხარ დარწმუნებული."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Այսպես մենք միշտ առաջարկում ենք միայն այն բաղադրատոմսերը, որոնք դու իրականում կարող ես պատրաստել։ Ընտրովի է -- բաց թող, եթե դեռ վստահ չես։"
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Тако ти предлажемо само рецепте које заиста можеш да скуваш. Необавезно — прескочи ако још ниси сигуран/на."
          }
        }
      },
      "comment": "Onboarding kitchen-equipment question screen subtitle/explainer"
    },
