# Xcode / XcodeGen
*.xcodeproj
*.xcworkspace
DerivedData/
xcuserdata/
build/

# Pinned XcodeGen binary (machine-local tool, not source) -- see SETUP.md
.xcodegen-2.42.0/

# Secrets -- generated from Config.sample.xcconfig, never commit real values
Config/Config-Debug.xcconfig
Config/Config-Release.xcconfig

# App Store Connect API credentials for scripts/testflight.sh -- this repo is
# public, so the private key and issuer/key IDs stay machine-local. Only the
# .example template is tracked. See scripts/README-testflight.md.
scripts/asc-api.env
*.p8
AuthKey_*.p8

# Firebase project config -- ties to a real Firebase project (API key,
# project ID, app ID). This repo is public, so this stays local-only, same
# reasoning as the Config-*.xcconfig secrets above. Each developer downloads
# their own from https://console.firebase.google.com/ and places it here --
# see SETUP.md.
Soma/Resources/GoogleService-Info.plist

# Open Wearables deployment secrets -- backend.env.template and
# docker-compose.prod.secure.yml in this repo hold PLACEHOLDERS only.
# Real generated values live here instead, never committed.
open-wearables-deploy/SECRETS.local.txt

# Supabase local dev
supabase/.branches
supabase/.temp

# Claude Code local settings -- machine-local, not shared project config
.claude/settings.local.json

# Internal engineering docs -- NOT published.
#
# docs/ is this repo's GitHub Pages root (main branch, /docs path) and the
# repo is public, so anything committed under docs/ is served at
# https://maryxsarah.github.io/SOMA-Health/ and readable by anyone. Only the
# hosted legal pages (privacy.html, terms.html) belong there.
#
# Internal docs -- code reviews, feature specs, findings -- are ignored here
# so they cannot be published by an absent-minded `git add .`. If the repo is
# ever made private, delete this block to start tracking them.
# Allowlist, not a blocklist: ignore everything under docs/ and name the
# exceptions. The blocklist form listed each internal folder by hand, so any
# new file added at docs/<something>.md was published by default -- the
# failure mode was silent and pointed the wrong way.
docs/*
!docs/privacy.html
!docs/terms.html

# macOS
.DS_Store

# Snapshot-test reference images are machine-local (record with
# scripts/test.sh snapshot --record); never committed by decision 2026-08-04.
SnapshotTests/__Snapshots__/
